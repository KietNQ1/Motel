@model Motel.ViewModels.Account.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Quên mật khẩu";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Rentify - Quên mật khẩu</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#d96619",
                        "primary-hover": "#c25a16",
                        "background-light": "#f8f9fa",
                    },
                    fontFamily: {
                        "display": ["Manrope", "sans-serif"],
                        "sans": ["Manrope", "sans-serif"]
                    },
                },
            },
        }
    </script>
    <style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
        body {
            font-family: 'Manrope', sans-serif;
            background-color: #f8f9fa;
        }
    </style>
</head>
<body class="flex flex-col min-h-screen text-slate-800">

    <header id="sec_forgotHeader" class="w-full px-6 lg:px-20 py-4 flex items-center justify-between border-b border-primary/10 bg-white/50 backdrop-blur-sm">
        <a id="lnk_loginBrand_forgot" href="/Account/Login" class="flex items-center gap-2">
            <div class="w-10 h-10 bg-primary text-white p-1.5 rounded-xl flex items-center justify-center shadow-sm">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-6 h-6">
                    <path d="M11.47 3.84a.75.75 0 011.06 0l8.69 8.69a.75.75 0 101.06-1.06l-8.689-8.69a2.25 2.25 0 00-3.182 0l-8.69 8.69a.75.75 0 001.061 1.06l8.69-8.69z" />
                    <path d="M12 5.432l8.159 8.159c.03.03.06.058.091.086v6.198c0 1.035-.84 1.875-1.875 1.875H15a.75.75 0 01-.75-.75v-4.5a.75.75 0 00-.75-.75h-3a.75.75 0 00-.75.75V21a.75.75 0 01-.75.75H5.625a1.875 1.875 0 01-1.875-1.875v-6.198a2.29 2.29 0 00.091-.086L12 5.43z" />
                </svg>
            </div>
            <h1 class="text-2xl font-bold tracking-tight text-slate-900">Rentify</h1>
        </a>
        <div class="hidden md:flex items-center gap-6">
            <a class="text-sm font-semibold hover:text-primary transition-colors" href="/Account/Login">Đăng nhập</a>
        </div>
    </header>

    <main class="flex-1 flex flex-col justify-center items-center py-8 px-4">
        
        <div id="card_forgotPassword" class="bg-white w-full max-w-[420px] rounded-3xl shadow-[0_8px_30px_rgb(0,0,0,0.04)] p-8 sm:p-10 border border-slate-100/50">
            
            <div class="mb-8 text-center">
                <div class="w-16 h-16 bg-primary/10 text-primary rounded-full flex items-center justify-center mx-auto mb-4">
                    <span class="material-symbols-outlined text-3xl">lock_reset</span>
                </div>
                <h2 class="text-2xl font-bold text-slate-900 mb-2">Quên mật khẩu?</h2>
                <p class="text-slate-500 text-sm leading-relaxed text-balance">Đừng lo lắng! Hãy nhập email của bạn và chúng tôi sẽ gửi liên kết để đặt lại mật khẩu.</p>
            </div>

            @if (!ViewData.ModelState.IsValid)
            {
                <div id="div_validationSummary_forgot" class="mb-6 p-4 bg-red-50 text-red-600 rounded-xl text-sm border border-red-100">
                    <ul id="list_validationErrors_forgot" class="list-disc list-inside space-y-1">
                        @foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <li>@e.ErrorMessage</li>
                        }
                    </ul>
                </div>
            }

            <form id="form_forgotPassword" asp-action="ForgotPassword" method="post" class="space-y-5">
                @Html.AntiForgeryToken()

                <!-- Email -->
                <div class="space-y-1.5">
                    <label class="block text-sm font-semibold text-slate-700">Email đã đăng ký</label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                            <span class="material-symbols-outlined text-xl">mail</span>
                        </div>
                        <input id="input_email_forgot" asp-for="Email" required placeholder="name@company.com" 
                               class="block w-full rounded-xl border-slate-200 bg-slate-50/50 py-3 pl-11 text-sm focus:border-primary focus:ring-primary focus:bg-white transition-colors" />
                    </div>
                    <span id="txt_emailValidation_forgot" asp-validation-for="Email" class="text-sm text-red-500 block"></span>
                </div>

                <!-- Submit Button -->
                <div class="pt-2">
                    <button id="btn_submit_forgotPassword" type="submit" class="w-full bg-primary hover:bg-primary-hover text-white font-bold py-3 px-4 rounded-xl transition-colors shadow-sm shadow-primary/20 flex items-center justify-center gap-2">
                        Gửi liên kết khôi phục
                        <span class="material-symbols-outlined text-xl">arrow_forward</span>
                    </button>
                </div>
            </form>

            <div class="mt-8 text-center text-sm">
                <a id="lnk_loginFooter_forgot" href="/Account/Login" class="text-slate-500 hover:text-primary transition-colors flex items-center justify-center gap-1 font-semibold">
                    <span class="material-symbols-outlined text-lg">arrow_back</span>
                    Quay lại Đăng nhập
                </a>
            </div>

        </div>

    </main>

    <!-- Page Footer -->
    <footer class="py-6 text-center text-xs text-slate-400">
        © 2024 Rentify Inc. Tất cả quyền được bảo lưu.
    </footer>

    @section Scripts {
        @{
            await Html.RenderPartialAsync("_ValidationScriptsPartial");
        }
    }
</body>
</html>
