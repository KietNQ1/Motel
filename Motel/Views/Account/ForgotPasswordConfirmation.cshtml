@{
    ViewData["Title"] = "Email đã được gửi";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Rentify - Email đã được gửi</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#d96619",
                        "primary-hover": "#c25a16",
                        "background-light": "#f8f9fa",
                    },
                    fontFamily: {
                        "display": ["Manrope", "sans-serif"],
                        "sans": ["Manrope", "sans-serif"]
                    },
                },
            },
        }
    </script>
    <style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
        body {
            font-family: 'Manrope', sans-serif;
            background-color: #f8f9fa;
        }
    </style>
</head>
<body class="flex flex-col min-h-screen text-slate-800">

    <header class="w-full px-6 lg:px-20 py-4 flex items-center justify-between border-b border-primary/10 bg-white/50 backdrop-blur-sm">
        <div class="flex items-center gap-2">
            <div class="w-10 h-10 bg-primary text-white p-1.5 rounded-xl flex items-center justify-center shadow-sm">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-6 h-6">
                    <path d="M11.47 3.84a.75.75 0 011.06 0l8.69 8.69a.75.75 0 101.06-1.06l-8.689-8.69a2.25 2.25 0 00-3.182 0l-8.69 8.69a.75.75 0 001.061 1.06l8.69-8.69z" />
                    <path d="M12 5.432l8.159 8.159c.03.03.06.058.091.086v6.198c0 1.035-.84 1.875-1.875 1.875H15a.75.75 0 01-.75-.75v-4.5a.75.75 0 00-.75-.75h-3a.75.75 0 00-.75.75V21a.75.75 0 01-.75.75H5.625a1.875 1.875 0 01-1.875-1.875v-6.198a2.29 2.29 0 00.091-.086L12 5.43z" />
                </svg>
            </div>
            <h1 class="text-2xl font-bold tracking-tight text-slate-900">Rentify</h1>
        </div>
    </header>

    <main class="flex-1 flex flex-col justify-center items-center py-8 px-4">
        
        <div class="bg-white w-full max-w-[420px] rounded-3xl shadow-[0_8px_30px_rgb(0,0,0,0.04)] p-8 sm:p-10 border border-slate-100/50 text-center">
            
            <div class="mb-8 flex flex-col items-center">
                <div class="w-20 h-20 bg-blue-50 text-blue-500 rounded-full flex items-center justify-center mb-6 shadow-sm shadow-blue-50">
                    <span class="material-symbols-outlined text-4xl">mark_email_read</span>
                </div>
                <h2 class="text-2xl font-bold text-slate-900 mb-3">Kiểm tra email của bạn</h2>
                <p class="text-slate-500 text-sm leading-relaxed text-balance">
                    Nếu email vừa nhập tồn tại trong hệ thống, chúng tôi đã gửi cho bạn một liên kết để đặt lại mật khẩu. Vui lòng kiểm tra hộp thư đến (và cả mục Spam) của bạn.
                </p>
            </div>

            <div class="pt-2">
                <a asp-action="Login" class="w-full bg-primary hover:bg-primary-hover text-white font-bold py-3 px-4 rounded-xl transition-colors shadow-sm shadow-primary/20 flex items-center justify-center gap-2">
                    Quay lại Đăng nhập
                    <span class="material-symbols-outlined text-xl">arrow_right_alt</span>
                </a>
            </div>

        </div>

    </main>

    <!-- Page Footer -->
    <footer class="py-6 text-center text-xs text-slate-400">
        © 2024 Rentify Inc. Tất cả quyền được bảo lưu.
    </footer>

</body>
</html>