@{
    ViewData["Title"] = "Email đã được gửi";
}

<style>
    .confirm-container {
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        background: linear-gradient(135deg, #667eea, #764ba2);
        font-family: 'Segoe UI', sans-serif;
    }

    .confirm-card {
        background: white;
        padding: 40px;
        width: 420px;
        border-radius: 12px;
        box-shadow: 0 15px 40px rgba(0,0,0,0.2);
        text-align: center;
    }

        .confirm-card h2 {
            margin-bottom: 15px;
        }

        .confirm-card p {
            color: #555;
            margin-bottom: 25px;
        }

    .back-btn {
        display: inline-block;
        padding: 10px 20px;
        background: #667eea;
        color: white;
        border-radius: 6px;
        text-decoration: none;
    }

        .back-btn:hover {
            background: #5563d1;
        }
</style>

<div class="confirm-container">
    <div class="confirm-card">
        <h2>📩 Kiểm tra email</h2>
        <p>
            Nếu email tồn tại trong hệ thống, chúng tôi đã gửi link đặt lại mật khẩu.
            Vui lòng kiểm tra hộp thư của bạn.
        </p>

        <a asp-action="Login" class="back-btn">
            Quay lại đăng nhập
        </a>
    </div>
</div>