@{
    ViewData["Title"] = "Đăng nhập";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Rentify - Đăng nhập</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght@100..700,0..1&display=swap" rel="stylesheet" />
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#d96619",
                        "primary-hover": "#c25a16",
                        "background-light": "#f8f9fa",
                    },
                    fontFamily: {
                        "display": ["Manrope", "sans-serif"],
                        "sans": ["Manrope", "sans-serif"]
                    },
                },
            },
        }
    </script>
    <style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
        body {
            font-family: 'Manrope', sans-serif;
            background-color: #f8f9fa;
        }
        
        /* Custom input icon padding */
        .input-with-icon {
            padding-left: 2.75rem !important; /* Added !important to override tailwind defaults if any */
        }
        .input-with-icon-right {
            padding-right: 2.75rem !important;
        }
    </style>
</head>
<body class="flex flex-col min-h-screen text-slate-800">

    <div class="flex-1 flex flex-col justify-center items-center p-4">
        
        <!-- Logo Header -->
        <div class="mb-8 flex items-center justify-center gap-2">
            <div class="w-10 h-10 bg-primary text-white rounded-xl flex items-center justify-center shadow-sm">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-6 h-6">
                    <path d="M11.47 3.84a.75.75 0 011.06 0l8.69 8.69a.75.75 0 101.06-1.06l-8.689-8.69a2.25 2.25 0 00-3.182 0l-8.69 8.69a.75.75 0 001.061 1.06l8.69-8.69z" />
                    <path d="M12 5.432l8.159 8.159c.03.03.06.058.091.086v6.198c0 1.035-.84 1.875-1.875 1.875H15a.75.75 0 01-.75-.75v-4.5a.75.75 0 00-.75-.75h-3a.75.75 0 00-.75.75V21a.75.75 0 01-.75.75H5.625a1.875 1.875 0 01-1.875-1.875v-6.198a2.29 2.29 0 00.091-.086L12 5.43z" />
                </svg>
            </div>
            <h1 class="text-2xl font-bold tracking-tight text-slate-900">Rentify</h1>
        </div>

        <!-- Login Card -->
        <div id="card_login" class="bg-white w-full max-w-[420px] rounded-3xl shadow-[0_8px_30px_rgb(0,0,0,0.04)] p-8 sm:p-10 border border-slate-100/50">
            
            <div class="mb-8">
                <h2 class="text-2xl font-bold text-slate-900 mb-2">Đăng nhập vào Rentify</h2>
                <p class="text-slate-500 text-sm leading-relaxed text-balance">Chào mừng bạn quay trở lại với giải pháp thuê nhà thông minh.</p>
            </div>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="mb-6 p-4 bg-red-50 text-red-600 rounded-xl text-sm border border-red-100">
                    <ul class="list-disc list-inside space-y-1">
                        @foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <li>@e.ErrorMessage</li>
                        }
                    </ul>
                </div>
            }

            <form id="form_login" method="post" class="space-y-5">
                
                <!-- Email -->
                <div class="space-y-1.5">
                    <label class="block text-sm font-semibold text-slate-700">Email</label>
                    <div class="relative">
                        <input id="input_email_login" type="email" name="email" required placeholder="name@company.com" 
                               class="block w-full rounded-xl border-slate-200 bg-slate-50/50 py-3 px-4 text-sm focus:border-primary focus:ring-primary focus:bg-white transition-colors" />
                    </div>
                </div>

                <!-- Password -->
                <div class="space-y-1.5">
                    <div class="flex items-center justify-between">
                        <label class="block text-sm font-semibold text-slate-700">Mật khẩu</label>
                        <a id="lnk_forgotPassword_login" asp-controller="Account" asp-action="Forgot" class="text-sm font-semibold text-primary hover:text-primary-hover transition-colors">
                            Quên mật khẩu?
                        </a>
                    </div>
                    <div class="relative">
                        <input type="password" name="password" required placeholder="••••••••" id="password_input"
                               class="block w-full rounded-xl border-slate-200 bg-slate-50/50 py-3 pl-4 input-with-icon-right text-sm focus:border-primary focus:ring-primary focus:bg-white transition-colors" />
                        <button id="btn_togglePassword_login" type="button" onclick="togglePassword()" class="absolute inset-y-0 right-0 pr-3.5 flex items-center text-slate-400 hover:text-slate-600 focus:outline-none">
                            <svg id="eye_icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" />
                                <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                            </svg>
                        </button>
                    </div>
                </div>

                <!-- Submit Button -->
                <div class="pt-2">
                    <button id="btn_submit_login" type="submit" class="w-full bg-primary hover:bg-primary-hover text-white font-bold py-3 px-4 rounded-xl transition-colors shadow-sm shadow-primary/20">
                        Đăng nhập
                    </button>
                </div>
            </form>

            <div class="relative my-7">
                <div class="absolute inset-0 flex items-center">
                    <div class="w-full border-t border-slate-200"></div>
                </div>
                <div class="relative flex justify-center text-sm">
                    <span class="px-3 bg-white text-slate-400 text-xs font-semibold tracking-wider uppercase">HOẶC ĐĂNG NHẬP VỚI</span>
                </div>
            </div>

            <form id="form_externalLogin" asp-action="ExternalLogin" method="post">
                @Html.AntiForgeryToken()
                <input id="input_provider_externalLogin" type="hidden" name="provider" value="Google" />
                <button id="btn_submit_googleLogin" type="submit" class="w-full bg-white border border-slate-200 hover:bg-slate-50 text-slate-700 font-semibold py-3 px-4 rounded-xl transition-colors flex items-center justify-center gap-3">
                    <svg viewBox="0 0 24 24" width="20" height="20" xmlns="http://www.w3.org/2000/svg">
                        <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
                        <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                        <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
                        <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
                    </svg>
                    Tiếp tục với Google
                </button>
            </form>

        </div>

        <!-- Footer Links -->
        <div class="mt-8 text-center text-sm text-slate-500">
            Chưa có tài khoản? 
            <a id="lnk_register_login" href="/Account/Register" class="font-bold text-primary hover:text-primary-hover transition-colors">Đăng ký ngay</a>
        </div>

    </div>

    <!-- Page Footer -->
    <footer class="py-6 text-center text-xs text-slate-400">
        © 2024 Rentify Inc. Tất cả quyền được bảo lưu.
    </footer>

    <script>
        function togglePassword() {
            const passwordInput = document.getElementById('password_input');
            const eyeIcon = document.getElementById('eye_icon');
            
            if (passwordInput.type === 'password') {
                passwordInput.type = 'text';
                eyeIcon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 001.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.45 10.45 0 0112 4.5c4.756 0 8.773 3.162 10.065 7.498a10.523 10.523 0 01-4.293 5.774M6.228 6.228L3 3m3.228 3.228l3.65 3.65m7.894 7.894L21 21m-3.228-3.228l-3.65-3.65m0 0a3 3 0 10-4.243-4.243m4.242 4.242L9.88 9.88" />';
            } else {
                passwordInput.type = 'password';
                eyeIcon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />';
            }
        }
    </script>
</body>
</html>