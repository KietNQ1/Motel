@model Motel.ViewModels.Account.RegisterViewModel

@{
    ViewData["Title"] = "Tạo tài khoản";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Rentify - Tạo tài khoản</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#d96619",
                        "primary-hover": "#c25a16",
                        "background-light": "#f8f9fa",
                    },
                    fontFamily: {
                        "display": ["Manrope", "sans-serif"],
                        "sans": ["Manrope", "sans-serif"]
                    },
                },
            },
        }
    </script>
    <style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
        body {
            font-family: 'Manrope', sans-serif;
            background-color: #f8f9fa;
        }
    </style>
</head>
<body class="flex flex-col min-h-screen text-slate-800">

    <header class="w-full px-6 lg:px-20 py-4 flex items-center justify-between border-b border-primary/10 bg-white/50 backdrop-blur-sm">
        <div class="flex items-center gap-2">
            <div class="w-10 h-10 bg-primary text-white p-1.5 rounded-xl flex items-center justify-center shadow-sm">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-6 h-6">
                    <path d="M11.47 3.84a.75.75 0 011.06 0l8.69 8.69a.75.75 0 101.06-1.06l-8.689-8.69a2.25 2.25 0 00-3.182 0l-8.69 8.69a.75.75 0 001.061 1.06l8.69-8.69z" />
                    <path d="M12 5.432l8.159 8.159c.03.03.06.058.091.086v6.198c0 1.035-.84 1.875-1.875 1.875H15a.75.75 0 01-.75-.75v-4.5a.75.75 0 00-.75-.75h-3a.75.75 0 00-.75.75V21a.75.75 0 01-.75.75H5.625a1.875 1.875 0 01-1.875-1.875v-6.198a2.29 2.29 0 00.091-.086L12 5.43z" />
                </svg>
            </div>
            <h1 class="text-2xl font-bold tracking-tight text-slate-900">Rentify</h1>
        </div>
        <div class="hidden md:flex items-center gap-6">
            <a class="text-sm font-semibold hover:text-primary transition-colors" href="#">Về chúng tôi</a>
            <a class="text-sm font-semibold hover:text-primary transition-colors" href="#">Hỗ trợ</a>
        </div>
    </header>

    <main class="flex-1 flex flex-col justify-center items-center py-8 px-4">
        
        <!-- Register Card -->
        <div class="bg-white w-full max-w-[520px] rounded-3xl shadow-[0_8px_30px_rgb(0,0,0,0.04)] p-8 sm:p-10 border border-slate-100/50">
            
            <div class="mb-8 text-center">
                <h2 class="text-2xl font-bold text-slate-900 mb-2">Tạo tài khoản</h2>
                <p class="text-slate-500 text-sm leading-relaxed text-balance">Chào mừng bạn đến với Rentify - Ứng dụng thuê đồ tiện lợi</p>
            </div>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="mb-6 p-4 bg-red-50 text-red-600 rounded-xl text-sm border border-red-100">
                    <ul class="list-disc list-inside space-y-1">
                        @foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <li>@e.ErrorMessage</li>
                        }
                    </ul>
                </div>
            }

            <form method="post" class="space-y-5">
                
                <!-- Họ và tên -->
                <div class="space-y-1.5">
                    <label class="block text-sm font-semibold text-slate-700">Họ và tên</label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                            <span class="material-symbols-outlined text-xl">person</span>
                        </div>
                        <input type="text" name="Fullname" required placeholder="Nhập họ và tên của bạn" 
                               class="block w-full rounded-xl border-slate-200 bg-slate-50/50 py-3 pl-11 text-sm focus:border-primary focus:ring-primary focus:bg-white transition-colors" />
                    </div>
                </div>

                <!-- Email -->
                <div class="space-y-1.5">
                    <label class="block text-sm font-semibold text-slate-700">Email</label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                            <span class="material-symbols-outlined text-xl">mail</span>
                        </div>
                        <input type="email" name="Email" required placeholder="example@email.com" 
                               class="block w-full rounded-xl border-slate-200 bg-slate-50/50 py-3 pl-11 text-sm focus:border-primary focus:ring-primary focus:bg-white transition-colors" />
                    </div>
                </div>

                <!-- Số điện thoại -->
                <div class="space-y-1.5">
                    <label class="block text-sm font-semibold text-slate-700">Số điện thoại</label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                            <span class="material-symbols-outlined text-xl">call</span>
                        </div>
                        <input type="tel" name="PhoneNumber" required placeholder="090x xxx xxx" 
                               class="block w-full rounded-xl border-slate-200 bg-slate-50/50 py-3 pl-11 text-sm focus:border-primary focus:ring-primary focus:bg-white transition-colors" />
                    </div>
                </div>

                <!-- Mật khẩu và Xác nhận -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div class="space-y-1.5">
                        <label class="block text-sm font-semibold text-slate-700">Mật khẩu</label>
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                                <span class="material-symbols-outlined text-xl">lock</span>
                            </div>
                            <input type="password" name="Password" required placeholder="••••••••" 
                                   class="block w-full rounded-xl border-slate-200 bg-slate-50/50 py-3 pl-11 pr-3 text-sm focus:border-primary focus:ring-primary focus:bg-white transition-colors" />
                        </div>
                    </div>
                    <div class="space-y-1.5">
                        <label class="block text-sm font-semibold text-slate-700">Xác nhận</label>
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                                <span class="material-symbols-outlined text-xl">shield</span>
                            </div>
                            <input type="password" name="ConfirmPassword" required placeholder="••••••••" 
                                   class="block w-full rounded-xl border-slate-200 bg-slate-50/50 py-3 pl-11 pr-3 text-sm focus:border-primary focus:ring-primary focus:bg-white transition-colors" />
                        </div>
                    </div>
                </div>

                <!-- Terms Checkbox -->
                <div class="flex items-start gap-2 pt-2">
                    <input type="checkbox" id="terms" required class="mt-1 rounded text-primary focus:ring-primary border-slate-300" />
                    <label for="terms" class="text-sm text-slate-500 leading-snug">
                        Tôi đồng ý với <a href="#" class="text-primary font-semibold hover:text-primary-hover transition-colors">Điều khoản dịch vụ</a> và <a href="#" class="text-primary font-semibold hover:text-primary-hover transition-colors">Chính sách bảo mật</a> của Rentify.
                    </label>
                </div>

                <!-- Submit Button -->
                <div class="pt-4">
                    <button type="submit" class="w-full bg-primary hover:bg-primary-hover text-white font-bold py-3 px-4 rounded-xl transition-colors shadow-sm shadow-primary/20 flex items-center justify-center gap-2">
                        Đăng ký ngay
                        <span class="material-symbols-outlined text-xl">arrow_forward</span>
                    </button>
                </div>
            </form>
            
            <div class="relative my-7">
                <div class="absolute inset-0 flex items-center">
                    <div class="w-full border-t border-slate-200"></div>
                </div>
                <div class="relative flex justify-center text-sm">
                    <span class="px-3 bg-white text-slate-400 text-xs font-semibold tracking-wider uppercase">HOẶC</span>
                </div>
            </div>

            <div class="text-center text-sm text-slate-600 font-medium">
                Đã có tài khoản? 
                <a href="/Account/Login" class="text-primary font-bold hover:text-primary-hover transition-colors ml-1">Đăng nhập ngay</a>
            </div>

        </div>

    </main>

    <!-- Page Footer -->
    <footer class="py-6 text-center text-xs text-slate-400">
        © 2024 Rentify Inc. Tất cả quyền được bảo lưu.
    </footer>

</body>
</html>