@model Motel.ViewModels.Dashboard.DashboardIndexViewModel

@{
    ViewData["Title"] = "Dashboard";
    Layout = "_Layout";
}

<!-- HEADER WITH GRADIENT BACKGROUND -->
<div class="mb-6">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-3xl font-bold text-gray-900 dark:text-white">Dashboard</h1>
            <p class="mt-1.5 text-sm text-gray-600 dark:text-gray-400">Tổng quan và quản lý nhanh</p>
        </div>
        <div class="flex items-center gap-3">
            <select class="rounded-xl border-[#e7d9cf] bg-white px-4 py-2.5 text-sm font-medium text-text-main shadow-sm transition-all hover:border-primary/30 hover:shadow focus:border-primary focus:ring-2 focus:ring-primary/20 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-300">
                <option value="">Tất cả tòa nhà</option>
                @foreach (var property in Model.Properties)
                {
                    <option value="@property.PropertyId">@property.Name - @property.Address</option>
                }
            </select>
            <button class="rounded-xl bg-gradient-to-r from-primary to-primary-dark px-5 py-2.5 text-sm font-semibold text-white shadow-lg shadow-primary/30 transition-all hover:shadow-xl hover:shadow-primary/40 hover:-translate-y-0.5">
                <svg class="inline h-4 w-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                </svg>
                Thao tác nhanh
            </button>
        </div>
    </div>
</div>

<!-- MAIN DASHBOARD GRID -->
<div class="grid grid-cols-1 gap-5 lg:grid-cols-12">
    <!-- LEFT COLUMN -->
    <div class="col-span-1 space-y-5 lg:col-span-7">
        
        <!-- KPI METRICS 2x2 GRID -->
        <div class="grid grid-cols-2 gap-5">
    <!-- Total Rooms -->
    <div class="group relative overflow-hidden rounded-2xl border border-orange-200 bg-white p-5 shadow-sm transition-all duration-300 hover:shadow-xl hover:shadow-orange-500/20 hover:-translate-y-1 dark:border-gray-800 dark:bg-white/[0.03]">
        <div class="absolute -right-8 -top-8 h-32 w-32 rounded-full bg-orange-500/5 transition-all duration-500 group-hover:scale-150"></div>
        <div class="relative">
            <div class="flex h-11 w-11 items-center justify-center rounded-2xl bg-gradient-to-br from-orange-500 to-orange-600 shadow-lg shadow-orange-500/30 transition-transform duration-300 group-hover:scale-110">
                <svg class="h-5 w-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
                </svg>
            </div>
            <div class="mt-3">
                <p class="text-xs font-medium uppercase tracking-wider text-gray-500 dark:text-gray-400">Tổng số phòng</p>
                <p class="mt-1.5 text-2xl font-bold text-orange-600 dark:text-orange-400">@Model.RoomStats.TotalRooms</p>
                <div class="mt-2 flex items-center justify-between">
                    <span class="text-xs text-gray-600 dark:text-gray-400">@Model.RoomStats.AvailableRoomsText</span>
                    <span class="inline-flex items-center rounded-full bg-orange-500/10 px-2.5 py-0.5 text-xs font-semibold text-orange-600 dark:bg-orange-500/20">@Model.RoomStats.OccupancyRateFormatted</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Occupied Rooms -->
    <div class="group relative overflow-hidden rounded-2xl border border-emerald-200 bg-white p-5 shadow-sm transition-all duration-300 hover:shadow-xl hover:shadow-emerald-500/20 hover:-translate-y-1 dark:border-gray-800 dark:bg-white/[0.03]">
        <div class="absolute -right-8 -top-8 h-32 w-32 rounded-full bg-emerald-500/5 transition-all duration-500 group-hover:scale-150"></div>
        <div class="relative">
            <div class="flex h-11 w-11 items-center justify-center rounded-2xl bg-gradient-to-br from-emerald-500 to-emerald-600 shadow-lg shadow-emerald-500/30 transition-transform duration-300 group-hover:scale-110">
                <svg class="h-5 w-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
            </div>
            <div class="mt-3">
                <p class="text-xs font-medium uppercase tracking-wider text-gray-500 dark:text-gray-400">Đã cho thuê</p>
                <p class="mt-1.5 text-2xl font-bold text-emerald-600 dark:text-emerald-400">@Model.RoomStats.OccupiedRooms</p>
                <div class="mt-2 flex items-center justify-between">
                    <span class="text-xs text-gray-600 dark:text-gray-400">@Model.RoomStats.OccupiedRooms/@Model.RoomStats.TotalRooms phòng</span>
                    <span class="inline-flex items-center gap-1 text-xs font-semibold text-emerald-600">
                        <svg class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 10l7-7m0 0l7 7m-7-7v18"/>
                        </svg>
                        +5%
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- Monthly Revenue -->
    <div class="group relative overflow-hidden rounded-2xl border border-violet-200 bg-white p-5 shadow-sm transition-all duration-300 hover:shadow-xl hover:shadow-violet-500/20 hover:-translate-y-1 dark:border-gray-800 dark:bg-white/[0.03]">
        <div class="absolute -right-8 -top-8 h-32 w-32 rounded-full bg-violet-500/5 transition-all duration-500 group-hover:scale-150"></div>
        <div class="relative">
            <div class="flex h-11 w-11 items-center justify-center rounded-2xl bg-gradient-to-br from-violet-500 to-violet-600 shadow-lg shadow-violet-500/30 transition-transform duration-300 group-hover:scale-110">
                <svg class="h-5 w-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
            </div>
            <div class="mt-3">
                <p class="text-xs font-medium uppercase tracking-wider text-gray-500 dark:text-gray-400">Doanh thu tháng</p>
                <p class="mt-1.5 text-2xl font-bold text-violet-600 dark:text-violet-400">@Model.FinancialStats.MonthlyRevenueFormatted</p>
                <div class="mt-2 flex items-center justify-between">
                    <span class="text-xs text-gray-600 dark:text-gray-400">@Model.FinancialStats.CollectionRateFormatted thu được</span>
                    <span class="inline-flex items-center gap-1 text-xs font-semibold text-violet-600">
                        <svg class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 10l7-7m0 0l7 7m-7-7v18"/>
                        </svg>
                        +12%
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- Unpaid Amount -->
    <div class="group relative overflow-hidden rounded-2xl border border-rose-200 bg-white p-5 shadow-sm transition-all duration-300 hover:shadow-xl hover:shadow-rose-500/20 hover:-translate-y-1 dark:border-gray-800 dark:bg-white/[0.03]">
        <div class="absolute -right-8 -top-8 h-32 w-32 rounded-full bg-rose-500/5 transition-all duration-500 group-hover:scale-150"></div>
        <div class="relative">
            <div class="flex h-11 w-11 items-center justify-center rounded-2xl bg-gradient-to-br from-rose-500 to-rose-600 shadow-lg shadow-rose-500/30 transition-transform duration-300 group-hover:scale-110">
                <svg class="h-5 w-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
            </div>
            <div class="mt-3">
                <p class="text-xs font-medium uppercase tracking-wider text-gray-500 dark:text-gray-400">Chưa thu</p>
                <p class="mt-1.5 text-2xl font-bold text-rose-600 dark:text-rose-400">@Model.FinancialStats.UnpaidAmountFormatted</p>
                <div class="mt-2 flex items-center justify-between">
                    <span class="text-xs text-rose-600 dark:text-rose-400">@Model.FinancialStats.UnpaidInvoiceText</span>
                    <button class="inline-flex items-center gap-1 text-xs font-semibold text-rose-600 transition-colors hover:text-rose-700">
                        Xem
                        <svg class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M9 5l7 7-7 7"/>
                        </svg>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- REVENUE CHART (12 MONTHS) -->
<div class="overflow-hidden rounded-2xl border border-[#e7d9cf] bg-white shadow-sm transition-shadow hover:shadow-lg dark:border-gray-800 dark:bg-white/[0.03]">
            <div class="flex items-center justify-between border-b border-gray-100 bg-gradient-to-r from-primary/5 to-transparent px-6 py-4 dark:border-gray-800 dark:from-primary/10">
                <div>
                    <h3 class="text-lg font-bold text-gray-900 dark:text-white">
                        Doanh thu 12 tháng
                    </h3>
                    <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">Theo dõi xu hướng doanh thu</p>
                </div>
                <a asp-controller="Report" asp-action="Revenue" class="inline-flex items-center gap-1.5 rounded-lg bg-white px-3 py-2 text-sm font-semibold text-violet-600 shadow-sm ring-1 ring-violet-200 transition-all hover:bg-violet-50 hover:text-violet-700 hover:ring-violet-300 dark:bg-gray-800 dark:ring-gray-700">
                    Chi tiết
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                    </svg>
                </a>
            </div>
            <div id="revenueChart" class="h-[320px] p-5"></div>
        </div>
    </div>

    <!-- RIGHT COLUMN -->
    <div class="col-span-1 space-y-5 lg:col-span-5">
        
        <!-- ROOM STATUS CHART -->
        <div class="overflow-hidden rounded-2xl border border-[#e7d9cf] bg-white shadow-sm transition-shadow hover:shadow-lg dark:border-gray-800 dark:bg-white/[0.03]">
            <div class="border-b border-gray-100 bg-gradient-to-r from-emerald-50/50 to-transparent px-6 py-4 dark:border-gray-800 dark:from-emerald-900/10">
                <h3 class="text-lg font-bold text-gray-900 dark:text-white">
                    Trạng thái phòng
                </h3>
                <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">Phân bố tình trạng</p>
            </div>
            <div id="roomStatusChart" class="h-[290px] p-5"></div>
        </div>

        <!-- RECENT INVOICES -->
        <div class="overflow-hidden rounded-2xl border border-[#e7d9cf] bg-white shadow-sm transition-shadow hover:shadow-lg dark:border-gray-800 dark:bg-white/[0.03]">
            <div class="flex items-center justify-between border-b border-gray-100 bg-gradient-to-r from-sky-50/50 to-transparent px-6 py-4 dark:border-gray-800 dark:from-blue-900/10">
                <div>
                    <h3 class="text-lg font-bold text-gray-900 dark:text-white">
                        Hóa đơn gần đây
                    </h3>
                    <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">Cần theo dõi</p>
                </div>
                <a asp-controller="Invoice" asp-action="Index" class="inline-flex items-center gap-1.5 text-sm font-semibold text-sky-600 transition-colors hover:text-sky-700">
                    Xem tất cả
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                    </svg>
                </a>
            </div>
            <div class="p-5">
                @if (Model.RecentInvoices.Any())
                {
                    <div class="max-h-[298px] space-y-2 overflow-y-auto pr-1">
                        @foreach (var invoice in Model.RecentInvoices)
                        {
                            <div class="group flex items-center justify-between rounded-xl border border-gray-100 bg-gradient-to-r from-gray-50/50 to-transparent p-3 transition-all hover:border-sky-200 hover:from-sky-50/30 hover:shadow-md dark:border-gray-800 dark:from-gray-800/30 dark:hover:border-sky-300/30 dark:hover:from-sky-900/10">
                                <div class="flex-1 min-w-0">
                                    <p class="text-sm font-bold text-gray-900 dark:text-white">@invoice.RoomName</p>
                                    <p class="mt-1 flex items-center gap-1.5 text-xs text-gray-500 dark:text-gray-400">
                                        <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
                                        </svg>
                                        @invoice.PropertyName · @invoice.PeriodFormatted
                                    </p>
                                </div>
                                <div class="ml-4 text-right">
                                    <p class="text-sm font-bold text-gray-900 dark:text-white">@invoice.AmountFormatted</p>
                                    <span class="mt-1.5 inline-flex items-center rounded-full px-2.5 py-1 text-xs font-semibold @invoice.StatusBadgeClass">
                                        @invoice.StatusText
                                    </span>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="py-10 text-center">
                        <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-gray-100 dark:bg-gray-800">
                            <svg class="h-7 w-7 text-gray-400 dark:text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                            </svg>
                        </div>
                        <p class="mt-2 text-sm font-medium text-gray-500">Chưa có hóa đơn nào</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- CONTRACTS EXPIRING SOON -->
<div class="mt-5">
    <div class="overflow-hidden rounded-2xl border border-[#e7d9cf] bg-white shadow-sm transition-shadow hover:shadow-lg dark:border-gray-800 dark:bg-white/[0.03]">
            <div class="flex items-center justify-between border-b border-gray-100 bg-gradient-to-r from-rose-50/30 to-transparent px-6 py-4 dark:border-gray-800 dark:from-rose-900/10">
                <div>
                    <h3 class="text-lg font-bold text-gray-900 dark:text-white">
                        Hợp đồng sắp hết hạn
                    </h3>
                    <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">30 ngày tới</p>
                </div>
                <a asp-controller="Contract" asp-action="Index" class="inline-flex items-center gap-1.5 rounded-lg bg-white px-3 py-2 text-sm font-semibold text-rose-600 shadow-sm ring-1 ring-rose-200 transition-all hover:bg-rose-50 hover:text-rose-700 hover:ring-rose-300 dark:bg-gray-800 dark:ring-gray-700">
                    Xem tất cả
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                    </svg>
                </a>
            </div>
            @if (Model.ExpiringContracts.Any())
            {
                <div class="overflow-x-auto">
                    <table class="w-full">
                        <thead class="border-b border-gray-100 bg-gray-50 dark:border-gray-800 dark:bg-gray-900/30">
                            <tr>
                                <th class="px-6 py-3.5 text-left text-xs font-bold uppercase tracking-wider text-gray-700 dark:text-gray-300">Phòng</th>
                                <th class="px-6 py-3.5 text-left text-xs font-bold uppercase tracking-wider text-gray-700 dark:text-gray-300">Người thuê</th>
                                <th class="px-6 py-3.5 text-left text-xs font-bold uppercase tracking-wider text-gray-700 dark:text-gray-300">Ngày hết hạn</th>
                                <th class="px-6 py-3.5 text-left text-xs font-bold uppercase tracking-wider text-gray-700 dark:text-gray-300">Còn lại</th>
                                <th class="px-6 py-3.5 text-right text-xs font-bold uppercase tracking-wider text-gray-700 dark:text-gray-300">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-100 dark:divide-gray-800">
                            @foreach (var contract in Model.ExpiringContracts)
                            {
                                <tr class="transition-all hover:bg-gradient-to-r hover:from-rose-50/20 hover:to-transparent dark:hover:from-rose-900/10">
                                    <td class="whitespace-nowrap px-6 py-3.5 text-sm font-bold text-gray-900 dark:text-white">@contract.RoomName</td>
                                    <td class="whitespace-nowrap px-6 py-3.5 text-sm font-medium text-gray-700 dark:text-gray-300">@contract.TenantName</td>
                                    <td class="whitespace-nowrap px-6 py-3.5 text-sm text-gray-600 dark:text-gray-400">@contract.EndDateFormatted</td>
                                    <td class="whitespace-nowrap px-6 py-3.5">
                                        <span class="inline-flex items-center rounded-full px-3 py-1 text-xs font-bold @contract.UrgencyBadgeClass">
                                            @contract.DaysRemainingText
                                        </span>
                                    </td>
                                    <td class="whitespace-nowrap px-6 py-3.5 text-right text-sm">
                                        <a asp-controller="Contract" asp-action="Renew" asp-route-id="@contract.ContractId" 
                                           class="inline-flex items-center gap-1.5 rounded-lg bg-gradient-to-r from-primary to-primary-dark px-3.5 py-1.5 text-sm font-semibold text-white shadow-sm transition-all hover:shadow-md hover:-translate-y-0.5">
                                            Gia hạn
                                            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                                            </svg>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="px-6 py-12 text-center">
                    <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-success/5 dark:bg-success/20">
                        <svg class="h-8 w-8 text-success dark:text-success" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                    </div>
                    <p class="mt-3 text-base font-semibold text-gray-900 dark:text-white">Tất cả đều ổn!</p>
                    <p class="mt-1 text-sm text-gray-500">Không có hợp đồng nào sắp hết hạn trong 30 ngày tới</p>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
<script>
    // Main Revenue Chart (12 months)
    const revenueOptions = {
        chart: {
            type: 'area',
            height: 320,
            fontFamily: 'Manrope, sans-serif',
            toolbar: { show: false }
        },
        series: [{
            name: 'Doanh thu',
            data: @Html.Raw(Model.RevenueChart.RevenuesJson)
        }],
        xaxis: {
            categories: @Html.Raw(Model.RevenueChart.MonthsJson),
            labels: {
                style: {
                    colors: '#9ca3af',
                    fontSize: '11px'
                }
            },
            axisBorder: { show: false },
            axisTicks: { show: false }
        },
        yaxis: {
            labels: {
                style: {
                    colors: '#9ca3af',
                    fontSize: '11px'
                },
                formatter: function(val) {
                    return (val / 1000000).toFixed(0) + 'M';
                }
            }
        },
        dataLabels: { enabled: false },
        stroke: {
            curve: 'smooth',
            width: 3,
            colors: ['#f97316']
        },
        fill: {
            type: 'gradient',
            gradient: {
                shade: 'light',
                type: 'vertical',
                shadeIntensity: 0.5,
                opacityFrom: 0.7,
                opacityTo: 0.1,
                stops: [0, 90, 100]
            },
            colors: ['#f97316']
        },
        grid: {
            borderColor: '#f3f4f6',
            strokeDashArray: 3,
            xaxis: { lines: { show: false } },
            padding: { top: 10, right: 10, bottom: 0, left: 10 }
        },
        tooltip: {
            theme: 'light',
            y: {
                formatter: function(val) {
                    return new Intl.NumberFormat('vi-VN', {
                        style: 'currency',
                        currency: 'VND'
                    }).format(val);
                }
            }
        }
    };

    const revenueChart = new ApexCharts(document.querySelector("#revenueChart"), revenueOptions);
    revenueChart.render();

    // Room Status Donut Chart
    const roomStatusOptions = {
        chart: {
            type: 'donut',
            height: 280,
            fontFamily: 'Manrope, sans-serif'
        },
        series: [@Model.RoomStats.OccupiedRooms, @Model.RoomStats.AvailableRooms, @Model.RoomStats.MaintenanceRooms],
        labels: ['Đã thuê', 'Còn trống', 'Bảo trì'],
        colors: ['#10b981', '#a855f7', '#f59e0b'],
        legend: {
            position: 'bottom',
            labels: { 
                colors: '#6b7280',
                useSeriesColors: false
            },
            fontSize: '12px',
            markers: {
                width: 8,
                height: 8,
                radius: 2
            }
        },
        plotOptions: {
            pie: {
                donut: {
                    size: '65%',
                    labels: {
                        show: true,
                        total: {
                            show: true,
                            label: 'Tổng',
                            fontSize: '13px',
                            color: '#9ca3af',
                            formatter: function() {
                                return '@Model.RoomStats.TotalRooms';
                            }
                        },
                        value: {
                            fontSize: '24px',
                            fontWeight: 700,
                            color: '#1f2937'
                        }
                    }
                }
            }
        },
        dataLabels: { 
            enabled: true,
            style: {
                fontSize: '13px',
                fontWeight: 600
            }
        },
        stroke: { width: 0 }
    };

    const roomStatusChart = new ApexCharts(document.querySelector("#roomStatusChart"), roomStatusOptions);
    roomStatusChart.render();
</script>
}
