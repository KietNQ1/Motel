@model Motel.ViewModels.Dashboard.DashboardIndexViewModel

@{
    ViewData["Title"] = "Dashboard";
    Layout = "_Layout";
}

<!-- PROPERTY FILTER -->
<div class="mb-6 flex items-center justify-between">
    <div>
        <h1 class="text-2xl font-bold text-gray-900 dark:text-white">Dashboard</h1>
        <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Tổng quan và quản lý nhanh</p>
    </div>
    <div class="flex items-center gap-3">
        <select class="rounded-lg border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50 focus:border-blue-500 focus:ring-2 focus:ring-blue-500 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-300">
            <option value="">Tất cả tòa nhà</option>
            <option value="1">Tòa A - Nguyễn Trãi</option>
            <option value="2">Tòa B - Lê Văn Sỹ</option>
        </select>
        <button class="rounded-lg bg-blue-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-700">
            <svg class="inline h-4 w-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
            </svg>
            Thao tác nhanh
        </button>
    </div>
</div>

<div class="grid grid-cols-12 gap-6">
    <!-- LEFT COLUMN: ACTIONS & ALERTS -->
    <div class="col-span-12 space-y-6 lg:col-span-8">
        
        <!-- CRITICAL ALERTS -->
        <div class="rounded-xl border-2 border-red-200 bg-red-50 dark:border-red-900/50 dark:bg-red-900/10">
            <div class="flex items-center gap-3 border-b border-red-200 px-6 py-4 dark:border-red-900/50">
                <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-red-600">
                    <svg class="h-5 w-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                    </svg>
                </div>
                <div class="flex-1">
                    <h3 class="text-base font-bold text-red-900 dark:text-red-400">Cần xử lý ngay</h3>
                    <p class="text-xs text-red-700 dark:text-red-400/80">Hóa đơn quá hạn thanh toán</p>
                </div>
                <span class="rounded-full bg-red-600 px-3 py-1 text-xs font-bold text-white">
                    @Model.FinancialStats.UnpaidInvoiceCount
                </span>
            </div>
            
            @if (Model.RecentInvoices.Any())
            {
                <div class="divide-y divide-red-100 dark:divide-red-900/30">
                    @foreach (var invoice in Model.RecentInvoices.Take(3))
                    {
                        <div class="flex items-center justify-between px-6 py-4 hover:bg-red-100/50 dark:hover:bg-red-900/20">
                            <div class="flex-1">
                                <div class="flex items-center gap-3">
                                    <h4 class="text-sm font-bold text-gray-900 dark:text-white">@invoice.RoomName</h4>
                                    <span class="rounded-full bg-red-600 px-2 py-0.5 text-xs font-semibold text-white">
                                        Quá hạn 5 ngày
                                    </span>
                                </div>
                                <p class="mt-1 text-xs text-gray-600 dark:text-gray-400">
                                    @invoice.PropertyName · @invoice.PeriodFormatted
                                </p>
                            </div>
                            <div class="ml-4 text-right">
                                <p class="text-base font-bold text-red-600 dark:text-red-400">@invoice.AmountFormatted</p>
                                <div class="mt-2 flex gap-2">
                                    <button class="rounded bg-red-600 px-3 py-1 text-xs font-semibold text-white hover:bg-red-700">
                                        Nhắc nợ
                                    </button>
                                    <button class="rounded border border-red-600 px-3 py-1 text-xs font-semibold text-red-600 hover:bg-red-50">
                                        Ghi nhận
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
                <div class="border-t border-red-200 px-6 py-3 dark:border-red-900/50">
                    <a asp-controller="Invoice" asp-action="Index" asp-route-status="unpaid" class="text-sm font-semibold text-red-600 hover:text-red-700">
                        Xem tất cả @Model.FinancialStats.UnpaidInvoiceCount hóa đơn chưa thanh toán →
                    </a>
                </div>
            }
            else
            {
                <div class="px-6 py-8 text-center">
                    <svg class="mx-auto h-12 w-12 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                    <p class="mt-2 text-sm font-semibold text-gray-900 dark:text-white">Tuyệt vời!</p>
                    <p class="text-xs text-gray-600">Tất cả hóa đơn đã được thanh toán</p>
                </div>
            }
        </div>

        <!-- WARNING ALERTS -->
        <div class="rounded-xl border-2 border-amber-200 bg-amber-50 dark:border-amber-900/50 dark:bg-amber-900/10">
            <div class="flex items-center gap-3 border-b border-amber-200 px-6 py-4 dark:border-amber-900/50">
                <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-amber-600">
                    <svg class="h-5 w-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                </div>
                <div class="flex-1">
                    <h3 class="text-base font-bold text-amber-900 dark:text-amber-400">Hợp đồng sắp hết hạn</h3>
                    <p class="text-xs text-amber-700 dark:text-amber-400/80">30 ngày tới - Cần chuẩn bị gia hạn</p>
                </div>
                <span class="rounded-full bg-amber-600 px-3 py-1 text-xs font-bold text-white">
                    @Model.ExpiringContracts.Count
                </span>
            </div>
            
            @if (Model.ExpiringContracts.Any())
            {
                <div class="divide-y divide-amber-100 dark:divide-amber-900/30">
                    @foreach (var contract in Model.ExpiringContracts.Take(4))
                    {
                        <div class="flex items-center justify-between px-6 py-3 hover:bg-amber-100/50 dark:hover:bg-amber-900/20">
                            <div class="flex items-center gap-4">
                                <div class="text-center">
                                    <div class="text-2xl font-bold text-amber-600">15</div>
                                    <div class="text-xs text-gray-600">ngày</div>
                                </div>
                                <div>
                                    <h4 class="text-sm font-bold text-gray-900 dark:text-white">@contract.RoomName</h4>
                                    <p class="text-xs text-gray-600 dark:text-gray-400">@contract.TenantName · Hết hạn @contract.EndDateFormatted</p>
                                </div>
                            </div>
                            <div class="flex gap-2">
                                <button class="rounded bg-amber-600 px-3 py-1.5 text-xs font-semibold text-white hover:bg-amber-700">
                                    Liên hệ gia hạn
                                </button>
                                <button class="rounded border border-amber-600 px-3 py-1.5 text-xs font-semibold text-amber-600 hover:bg-amber-50">
                                    Tìm khách mới
                                </button>
                            </div>
                        </div>
                    }
                </div>
                <div class="border-t border-amber-200 px-6 py-3 dark:border-amber-900/50">
                    <a asp-controller="Contract" asp-action="Index" asp-route-expiring="30" class="text-sm font-semibold text-amber-600 hover:text-amber-700">
                        Xem tất cả hợp đồng sắp hết hạn →
                    </a>
                </div>
            }
            else
            {
                <div class="px-6 py-8 text-center">
                    <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                    <p class="mt-2 text-sm font-semibold text-gray-900 dark:text-white">Tất cả ổn định</p>
                    <p class="text-xs text-gray-600">Không có hợp đồng nào sắp hết hạn</p>
                </div>
            }
        </div>

        <!-- QUICK STATS GRID -->
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <!-- Total Rooms -->
            <div class="group relative overflow-hidden rounded-xl border border-gray-200 bg-white p-5 transition-all hover:shadow-lg dark:border-gray-800 dark:bg-white/[0.03]">
                <div class="flex items-center justify-between">
                    <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-gradient-to-br from-blue-500 to-blue-600">
                        <svg class="h-6 w-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
                        </svg>
                    </div>
                    <div class="text-right">
                        <p class="text-sm text-gray-500 dark:text-gray-400">Tổng phòng</p>
                        <p class="text-3xl font-bold text-gray-900 dark:text-white">@Model.RoomStats.TotalRooms</p>
                    </div>
                </div>
                <div class="mt-4 flex items-center justify-between border-t border-gray-100 pt-3 dark:border-gray-800">
                    <span class="text-xs text-gray-600 dark:text-gray-400">@Model.RoomStats.AvailableRoomsText</span>
                    <span class="text-xs font-semibold text-blue-600">100%</span>
                </div>
            </div>

            <!-- Occupied Rate -->
            <div class="group relative overflow-hidden rounded-xl border border-gray-200 bg-white p-5 transition-all hover:shadow-lg dark:border-gray-800 dark:bg-white/[0.03]">
                <div class="flex items-center justify-between">
                    <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-gradient-to-br from-green-500 to-green-600">
                        <svg class="h-6 w-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                    </div>
                    <div class="text-right">
                        <p class="text-sm text-gray-500 dark:text-gray-400">Tỷ lệ lấp đầy</p>
                        <p class="text-3xl font-bold text-gray-900 dark:text-white">@Model.RoomStats.OccupancyRateFormatted</p>
                    </div>
                </div>
                <div class="mt-4 flex items-center justify-between border-t border-gray-100 pt-3 dark:border-gray-800">
                    <span class="text-xs text-gray-600 dark:text-gray-400">@Model.RoomStats.OccupiedRooms/@Model.RoomStats.TotalRooms phòng</span>
                    <span class="text-xs font-semibold text-green-600">+5%</span>
                </div>
            </div>

            <!-- Monthly Revenue -->
            <div class="group relative overflow-hidden rounded-xl border border-gray-200 bg-white p-5 transition-all hover:shadow-lg dark:border-gray-800 dark:bg-white/[0.03]">
                <div class="flex items-center justify-between">
                    <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-gradient-to-br from-purple-500 to-purple-600">
                        <svg class="h-6 w-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                    </div>
                    <div class="text-right">
                        <p class="text-sm text-gray-500 dark:text-gray-400">Doanh thu tháng</p>
                        <p class="text-3xl font-bold text-gray-900 dark:text-white">@Model.FinancialStats.MonthlyRevenueFormatted</p>
                    </div>
                </div>
                <div class="mt-4 flex items-center justify-between border-t border-gray-100 pt-3 dark:border-gray-800">
                    <span class="text-xs text-gray-600 dark:text-gray-400">@Model.FinancialStats.CollectionRateFormatted thu được</span>
                    <span class="text-xs font-semibold text-purple-600">+12%</span>
                </div>
            </div>

            <!-- Unpaid Amount -->
            <div class="group relative overflow-hidden rounded-xl border border-gray-200 bg-white p-5 transition-all hover:shadow-lg dark:border-gray-800 dark:bg-white/[0.03]">
                <div class="flex items-center justify-between">
                    <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-gradient-to-br from-orange-500 to-orange-600">
                        <svg class="h-6 w-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                    </div>
                    <div class="text-right">
                        <p class="text-sm text-gray-500 dark:text-gray-400">Chưa thu</p>
                        <p class="text-3xl font-bold text-orange-600 dark:text-orange-400">@Model.FinancialStats.UnpaidAmountFormatted</p>
                    </div>
                </div>
                <div class="mt-4 flex items-center justify-between border-t border-gray-100 pt-3 dark:border-gray-800">
                    <span class="text-xs text-orange-600 dark:text-orange-400">@Model.FinancialStats.UnpaidInvoiceText</span>
                    <button class="text-xs font-semibold text-orange-600 hover:text-orange-700">Xem →</button>
                </div>
            </div>
        </div>
    </div>

    <!-- RIGHT COLUMN: STATS & INSIGHTS -->
    <div class="col-span-12 space-y-6 lg:col-span-4">
        
        <!-- PROPERTY COMPARISON -->
        <div class="rounded-xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[0.03]">
            <div class="border-b border-gray-100 px-5 py-4 dark:border-gray-800">
                <h3 class="text-base font-semibold text-gray-900 dark:text-white">So sánh tòa nhà</h3>
                <p class="mt-0.5 text-xs text-gray-500">Hiệu suất từng tòa</p>
            </div>
            <div class="p-5">
                <!-- Tòa A -->
                <div class="mb-5 rounded-lg border border-gray-200 p-4 dark:border-gray-700">
                    <div class="flex items-center justify-between mb-3">
                        <div>
                            <h4 class="text-sm font-bold text-gray-900 dark:text-white">Tòa A - Nguyễn Trãi</h4>
                            <p class="text-xs text-gray-500">25 phòng</p>
                        </div>
                        <span class="rounded-full bg-green-100 px-2.5 py-1 text-xs font-bold text-green-700">90%</span>
                    </div>
                    <div class="space-y-2">
                        <div class="flex justify-between text-xs">
                            <span class="text-gray-600">Doanh thu</span>
                            <span class="font-semibold text-gray-900 dark:text-white">72M</span>
                        </div>
                        <div class="flex justify-between text-xs">
                            <span class="text-gray-600">Công nợ</span>
                            <span class="font-semibold text-red-600">3.5M</span>
                        </div>
                    </div>
                    <div class="mt-3 h-1.5 overflow-hidden rounded-full bg-gray-200">
                        <div class="h-full w-[90%] rounded-full bg-gradient-to-r from-green-500 to-green-600"></div>
                    </div>
                </div>

                <!-- Tòa B -->
                <div class="rounded-lg border border-gray-200 p-4 dark:border-gray-700">
                    <div class="flex items-center justify-between mb-3">
                        <div>
                            <h4 class="text-sm font-bold text-gray-900 dark:text-white">Tòa B - Lê Văn Sỹ</h4>
                            <p class="text-xs text-gray-500">25 phòng</p>
                        </div>
                        <span class="rounded-full bg-amber-100 px-2.5 py-1 text-xs font-bold text-amber-700">75%</span>
                    </div>
                    <div class="space-y-2">
                        <div class="flex justify-between text-xs">
                            <span class="text-gray-600">Doanh thu</span>
                            <span class="font-semibold text-gray-900 dark:text-white">53M</span>
                        </div>
                        <div class="flex justify-between text-xs">
                            <span class="text-gray-600">Công nợ</span>
                            <span class="font-semibold text-green-600">0đ</span>
                        </div>
                    </div>
                    <div class="mt-3 h-1.5 overflow-hidden rounded-full bg-gray-200">
                        <div class="h-full w-[75%] rounded-full bg-gradient-to-r from-amber-500 to-amber-600"></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ROOM STATUS CHART -->
        <div class="rounded-xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[0.03]">
            <div class="border-b border-gray-100 px-5 py-4 dark:border-gray-800">
                <h3 class="text-base font-semibold text-gray-900 dark:text-white">Trạng thái phòng</h3>
                <p class="mt-0.5 text-xs text-gray-500">Phân bố tình trạng</p>
            </div>
            <div id="roomStatusChart" class="h-[220px] px-2 py-4"></div>
        </div>

        <!-- REVENUE TREND -->
        <div class="rounded-xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[0.03]">
            <div class="border-b border-gray-100 px-5 py-4 dark:border-gray-800">
                <h3 class="text-base font-semibold text-gray-900 dark:text-white">Xu hướng doanh thu</h3>
                <p class="mt-0.5 text-xs text-gray-500">6 tháng gần nhất</p>
            </div>
            <div id="revenueTrendChart" class="h-[180px] px-2 py-2"></div>
        </div>

        <!-- QUICK ACTIONS -->
        <div class="rounded-xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[0.03]">
            <div class="border-b border-gray-100 px-5 py-4 dark:border-gray-800">
                <h3 class="text-base font-semibold text-gray-900 dark:text-white">Thao tác nhanh</h3>
            </div>
            <div class="p-4 space-y-2">
                <button class="flex w-full items-center gap-3 rounded-lg border border-gray-200 p-3 text-left transition-all hover:border-blue-300 hover:bg-blue-50 dark:border-gray-700 dark:hover:border-blue-700 dark:hover:bg-blue-900/10">
                    <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-blue-100 dark:bg-blue-900/30">
                        <svg class="h-4 w-4 text-blue-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                        </svg>
                    </div>
                    <span class="text-sm font-semibold text-gray-900 dark:text-white">Tạo hóa đơn hàng loạt</span>
                </button>

                <button class="flex w-full items-center gap-3 rounded-lg border border-gray-200 p-3 text-left transition-all hover:border-green-300 hover:bg-green-50 dark:border-gray-700 dark:hover:border-green-700 dark:hover:bg-green-900/10">
                    <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-green-100 dark:bg-green-900/30">
                        <svg class="h-4 w-4 text-green-600 dark:text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                        </svg>
                    </div>
                    <span class="text-sm font-semibold text-gray-900 dark:text-white">Gửi thông báo hàng loạt</span>
                </button>

                <button class="flex w-full items-center gap-3 rounded-lg border border-gray-200 p-3 text-left transition-all hover:border-purple-300 hover:bg-purple-50 dark:border-gray-700 dark:hover:border-purple-700 dark:hover:bg-purple-900/10">
                    <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-purple-100 dark:bg-purple-900/30">
                        <svg class="h-4 w-4 text-purple-600 dark:text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                        </svg>
                    </div>
                    <span class="text-sm font-semibold text-gray-900 dark:text-white">Xuất báo cáo Excel</span>
                </button>

                <button class="flex w-full items-center gap-3 rounded-lg border border-gray-200 p-3 text-left transition-all hover:border-orange-300 hover:bg-orange-50 dark:border-gray-700 dark:hover:border-orange-700 dark:hover:bg-orange-900/10">
                    <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-orange-100 dark:bg-orange-900/30">
                        <svg class="h-4 w-4 text-orange-600 dark:text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
                        </svg>
                    </div>
                    <span class="text-sm font-semibold text-gray-900 dark:text-white">Xem phòng trống</span>
                </button>
            </div>
        </div>
    </div>
</div>
        
        <!-- METRIC CARDS -->
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 md:gap-5">
            <!-- Tổng phòng -->
            <div class="group relative overflow-hidden rounded-2xl border border-gray-200 bg-white p-6 transition-all hover:shadow-lg dark:border-gray-800 dark:bg-white/[0.03]">
                <div class="absolute -right-6 -top-6 h-24 w-24 rounded-full bg-blue-500/5 transition-transform group-hover:scale-110"></div>
                <div class="relative">
                    <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-gradient-to-br from-blue-500 to-blue-600 shadow-lg shadow-blue-500/30">
                        <svg class="text-white" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
                        </svg>
                    </div>
                    <div class="mt-4">
                        <p class="text-sm font-medium text-gray-500 dark:text-gray-400">Tổng số phòng</p>
                        <h4 class="mt-1 text-3xl font-bold text-gray-900 dark:text-white">
                            @Model.RoomStats.TotalRooms
                        </h4>
                        <p class="mt-1.5 text-xs text-gray-600 dark:text-gray-400">@Model.RoomStats.AvailableRoomsText</p>
                    </div>
                </div>
                <div class="absolute bottom-0 left-0 h-1 w-full bg-gradient-to-r from-blue-500 to-blue-600"></div>
            </div>

            <!-- Phòng đã thuê -->
            <div class="group relative overflow-hidden rounded-2xl border border-gray-200 bg-white p-6 transition-all hover:shadow-lg dark:border-gray-800 dark:bg-white/[0.03]">
                <div class="absolute -right-6 -top-6 h-24 w-24 rounded-full bg-green-500/5 transition-transform group-hover:scale-110"></div>
                <div class="relative">
                    <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-gradient-to-br from-green-500 to-green-600 shadow-lg shadow-green-500/30">
                        <svg class="text-white" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                    </div>
                    <div class="mt-4">
                        <p class="text-sm font-medium text-gray-500 dark:text-gray-400">Đã cho thuê</p>
                        <h4 class="mt-1 text-3xl font-bold text-gray-900 dark:text-white">
                            @Model.RoomStats.OccupiedRooms
                        </h4>
                        <span class="mt-1.5 inline-flex items-center rounded-full bg-green-50 px-2.5 py-1 text-xs font-semibold text-green-700 dark:bg-green-900/30 dark:text-green-400">
                            @Model.RoomStats.OccupancyRateFormatted
                        </span>
                    </div>
                </div>
                <div class="absolute bottom-0 left-0 h-1 w-full bg-gradient-to-r from-green-500 to-green-600"></div>
            </div>

            <!-- Doanh thu tháng -->
            <div class="group relative overflow-hidden rounded-2xl border border-gray-200 bg-white p-6 transition-all hover:shadow-lg dark:border-gray-800 dark:bg-white/[0.03]">
                <div class="absolute -right-6 -top-6 h-24 w-24 rounded-full bg-purple-500/5 transition-transform group-hover:scale-110"></div>
                <div class="relative">
                    <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-gradient-to-br from-purple-500 to-purple-600 shadow-lg shadow-purple-500/30">
                        <svg class="text-white" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                    </div>
                    <div class="mt-4">
                        <p class="text-sm font-medium text-gray-500 dark:text-gray-400">Doanh thu tháng</p>
                        <h4 class="mt-1 text-3xl font-bold text-gray-900 dark:text-white">
                            @Model.FinancialStats.MonthlyRevenueFormatted
                        </h4>
                        <p class="mt-1.5 text-xs text-gray-600 dark:text-gray-400">@Model.FinancialStats.CollectionRateFormatted thu được</p>
                    </div>
                </div>
                <div class="absolute bottom-0 left-0 h-1 w-full bg-gradient-to-r from-purple-500 to-purple-600"></div>
            </div>

            <!-- Chưa thu -->
            <div class="group relative overflow-hidden rounded-2xl border border-gray-200 bg-white p-6 transition-all hover:shadow-lg dark:border-gray-800 dark:bg-white/[0.03]">
                <div class="absolute -right-6 -top-6 h-24 w-24 rounded-full bg-orange-500/5 transition-transform group-hover:scale-110"></div>
                <div class="relative">
                    <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-gradient-to-br from-orange-500 to-orange-600 shadow-lg shadow-orange-500/30">
                        <svg class="text-white" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                    </div>
                    <div class="mt-4">
                        <p class="text-sm font-medium text-gray-500 dark:text-gray-400">Chưa thu</p>
                        <h4 class="mt-1 text-3xl font-bold text-gray-900 dark:text-white">
                            @Model.FinancialStats.UnpaidAmountFormatted
                        </h4>
                        <p class="mt-1.5 text-xs font-medium text-orange-600 dark:text-orange-400">@Model.FinancialStats.UnpaidInvoiceText</p>
                    </div>
                </div>
                <div class="absolute bottom-0 left-0 h-1 w-full bg-gradient-to-r from-orange-500 to-orange-600"></div>
            </div>
        </div>

        <!-- REVENUE CHART -->
        <div class="overflow-hidden rounded-2xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[0.03]">
            <div class="flex items-center justify-between border-b border-gray-100 px-6 py-4 dark:border-gray-800">
                <div>
                    <h3 class="text-base font-semibold text-gray-900 dark:text-white">
                        Doanh thu 12 tháng
                    </h3>
                    <p class="mt-0.5 text-xs text-gray-500">Theo dõi xu hướng doanh thu</p>
                </div>
                <a asp-controller="Report" asp-action="Revenue" class="text-sm font-medium text-blue-600 hover:text-blue-700">
                    Chi tiết →
                </a>
            </div>
            <div id="revenueChart" class="h-[300px] px-2"></div>
        </div>
    </div>

    <!-- RIGHT COLUMN -->
    <div class="col-span-12 space-y-6 xl:col-span-5">
        <!-- ROOM STATUS CHART -->
        <div class="overflow-hidden rounded-2xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[0.03]">
            <div class="border-b border-gray-100 px-6 py-4 dark:border-gray-800">
                <h3 class="text-base font-semibold text-gray-900 dark:text-white">
                    Trạng thái phòng
                </h3>
                <p class="mt-0.5 text-xs text-gray-500">Phân bố tình trạng</p>
            </div>
            <div id="roomStatusChart" class="h-[280px] px-2 py-4"></div>
        </div>

        <!-- RECENT INVOICES -->
        <div class="overflow-hidden rounded-2xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[0.03]">
            <div class="flex items-center justify-between border-b border-gray-100 px-6 py-4 dark:border-gray-800">
                <div>
                    <h3 class="text-base font-semibold text-gray-900 dark:text-white">
                        Hóa đơn gần đây
                    </h3>
                    <p class="mt-0.5 text-xs text-gray-500">Cần theo dõi</p>
                </div>
                <a asp-controller="Invoice" asp-action="Index" class="text-sm font-medium text-blue-600 hover:text-blue-700">
                    Xem tất cả →
                </a>
            </div>
            <div class="p-4">
                @if (Model.RecentInvoices.Any())
                {
                    <div class="space-y-2">
                        @foreach (var invoice in Model.RecentInvoices)
                        {
                            <div class="group flex items-center justify-between rounded-lg border border-transparent p-3 transition-all hover:border-gray-200 hover:bg-gray-50 dark:hover:border-gray-700 dark:hover:bg-white/[0.02]">
                                <div class="flex-1 min-w-0">
                                    <p class="text-sm font-semibold text-gray-900 dark:text-white">@invoice.RoomName</p>
                                    <p class="mt-0.5 text-xs text-gray-500 dark:text-gray-400">@invoice.PropertyName · @invoice.PeriodFormatted</p>
                                </div>
                                <div class="ml-4 text-right">
                                    <p class="text-sm font-bold text-gray-900 dark:text-white">@invoice.AmountFormatted</p>
                                    <span class="mt-1 inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium @invoice.StatusBadgeClass">
                                        @invoice.StatusText
                                    </span>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="py-8 text-center">
                        <svg class="w-12 h-12 mx-auto mb-2 text-gray-300 dark:text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                        </svg>
                        <p class="text-sm text-gray-500">Chưa có hóa đơn nào</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- CONTRACTS EXPIRING SOON -->
    <div class="col-span-12">
        <div class="overflow-hidden rounded-2xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[0.03]">
            <div class="flex items-center justify-between border-b border-gray-100 px-6 py-4 dark:border-gray-800">
                <div>
                    <h3 class="text-base font-semibold text-gray-900 dark:text-white">
                        Hợp đồng sắp hết hạn
                    </h3>
                    <p class="mt-0.5 text-xs text-gray-500">30 ngày tới</p>
                </div>
                <a asp-controller="Contract" asp-action="Index" class="text-sm font-medium text-blue-600 hover:text-blue-700">
                    Xem tất cả →
                </a>
            </div>
            @if (Model.ExpiringContracts.Any())
            {
                <div class="overflow-x-auto">
                    <table class="w-full">
                        <thead class="border-b border-gray-100 bg-gray-50/50 dark:border-gray-800 dark:bg-gray-900/20">
                            <tr>
                                <th class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wider text-gray-600 dark:text-gray-400">Phòng</th>
                                <th class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wider text-gray-600 dark:text-gray-400">Người thuê</th>
                                <th class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wider text-gray-600 dark:text-gray-400">Ngày hết hạn</th>
                                <th class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wider text-gray-600 dark:text-gray-400">Còn lại</th>
                                <th class="px-6 py-3 text-right text-xs font-semibold uppercase tracking-wider text-gray-600 dark:text-gray-400">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-100 dark:divide-gray-800">
                            @foreach (var contract in Model.ExpiringContracts)
                            {
                                <tr class="transition-colors hover:bg-gray-50 dark:hover:bg-white/[0.02]">
                                    <td class="whitespace-nowrap px-6 py-4 text-sm font-semibold text-gray-900 dark:text-white">@contract.RoomName</td>
                                    <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-600 dark:text-gray-400">@contract.TenantName</td>
                                    <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-600 dark:text-gray-400">@contract.EndDateFormatted</td>
                                    <td class="whitespace-nowrap px-6 py-4">
                                        <span class="inline-flex items-center rounded-full px-2.5 py-1 text-xs font-semibold @contract.UrgencyBadgeClass">
                                            @contract.DaysRemainingText
                                        </span>
                                    </td>
                                    <td class="whitespace-nowrap px-6 py-4 text-right text-sm">
                                        <a asp-controller="Contract" asp-action="Renew" asp-route-id="@contract.ContractId" 
                                           class="inline-flex items-center gap-1 font-semibold text-blue-600 transition-colors hover:text-blue-700">
                                            Gia hạn
                                            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                                            </svg>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="px-5 py-10 text-center">
                    <svg class="w-12 h-12 mx-auto mb-3 text-gray-300 dark:text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                    <p class="text-sm text-gray-500">Không có hợp đồng nào sắp hết hạn trong 30 ngày tới</p>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
<script>
    // Room Status Donut Chart
    const roomStatusOptions = {
        chart: {
            type: 'donut',
            height: 220,
            fontFamily: 'Inter, system-ui, sans-serif'
        },
        series: [@Model.RoomStats.OccupiedRooms, @Model.RoomStats.AvailableRooms, @Model.RoomStats.MaintenanceRooms],
        labels: ['Đã thuê', 'Còn trống', 'Bảo trì'],
        colors: ['#10b981', '#3b82f6', '#f59e0b'],
        legend: {
            position: 'bottom',
            labels: { 
                colors: '#6b7280',
                useSeriesColors: false
            },
            fontSize: '12px',
            markers: {
                width: 8,
                height: 8,
                radius: 2
            }
        },
        plotOptions: {
            pie: {
                donut: {
                    size: '65%',
                    labels: {
                        show: true,
                        total: {
                            show: true,
                            label: 'Tổng',
                            fontSize: '13px',
                            color: '#9ca3af',
                            formatter: function() {
                                return '@Model.RoomStats.TotalRooms';
                            }
                        },
                        value: {
                            fontSize: '24px',
                            fontWeight: 700,
                            color: '#1f2937'
                        }
                    }
                }
            }
        },
        dataLabels: { 
            enabled: true,
            style: {
                fontSize: '13px',
                fontWeight: 600
            }
        },
        stroke: { width: 0 }
    };

    const roomStatusChart = new ApexCharts(document.querySelector("#roomStatusChart"), roomStatusOptions);
    roomStatusChart.render();

    // Revenue Trend Area Chart (Last 6 months)
    const revenueTrendOptions = {
        chart: {
            type: 'area',
            height: 180,
            fontFamily: 'Inter, system-ui, sans-serif',
            toolbar: { show: false },
            sparkline: { enabled: false }
        },
        series: [{
            name: 'Doanh thu',
            data: @Html.Raw(Model.RevenueChart.RevenuesJson)
        }],
        xaxis: {
            categories: @Html.Raw(Model.RevenueChart.MonthsJson),
            labels: {
                style: {
                    colors: '#9ca3af',
                    fontSize: '10px'
                }
            },
            axisBorder: { show: false },
            axisTicks: { show: false }
        },
        yaxis: {
            labels: {
                style: {
                    colors: '#9ca3af',
                    fontSize: '10px'
                },
                formatter: function(val) {
                    return (val / 1000000).toFixed(0) + 'M';
                }
            }
        },
        dataLabels: { enabled: false },
        stroke: {
            curve: 'smooth',
            width: 2,
            colors: ['#8b5cf6']
        },
        fill: {
            type: 'gradient',
            gradient: {
                shade: 'light',
                type: 'vertical',
                shadeIntensity: 0.5,
                opacityFrom: 0.6,
                opacityTo: 0.1,
                stops: [0, 90, 100]
            },
            colors: ['#8b5cf6']
        },
        grid: {
            borderColor: '#f3f4f6',
            strokeDashArray: 3,
            xaxis: { lines: { show: false } },
            padding: { top: 0, right: 5, bottom: 0, left: 5 }
        },
        tooltip: {
            theme: 'light',
            y: {
                formatter: function(val) {
                    return new Intl.NumberFormat('vi-VN', {
                        style: 'currency',
                        currency: 'VND'
                    }).format(val);
                }
            }
        }
    };

    const revenueTrendChart = new ApexCharts(document.querySelector("#revenueTrendChart"), revenueTrendOptions);
    revenueTrendChart.render();
</script>
}
