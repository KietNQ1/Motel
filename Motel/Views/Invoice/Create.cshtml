@model Motel.ViewModels.Invoice.CreateInvoiceViewModel

@{
    ViewData["Title"] = "Tạo hóa đơn";
}

<h2 class="mb-3">Tạo hóa đơn</h2>
@if (!string.IsNullOrEmpty(Model.RoomName))
{
    <p class="text-muted mb-3"><strong>Phòng:</strong> @Model.RoomName</p>
}

<form asp-controller="Invoice" asp-action="Create" method="post">
    @Html.AntiForgeryToken()

    <!-- Validation summary -->
    <div asp-validation-summary="All" class="text-danger mb-3"></div>

    <!-- Hidden -->
    <input type="hidden" asp-for="RoomId" />
    <input type="hidden" asp-for="ContractId" />

    <!-- ======================
         Thông tin chung
         ====================== -->
    <div class="card mb-3">
        <div class="card-header fw-bold">
            Thông tin hóa đơn
        </div>
        <div class="card-body">

            <div class="row mb-3">
                <div class="col-md-4">
                    <label asp-for="PeriodMonth" class="form-label"></label>
                    <input asp-for="PeriodMonth" class="form-control" placeholder="YYYYMM" />
                    <span asp-validation-for="PeriodMonth" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="DueDate" class="form-label"></label>
                    <!-- DateOnly bind tốt với type=date -->
                    <input asp-for="DueDate" type="date" class="form-control" />
                    <span asp-validation-for="DueDate" class="text-danger"></span>
                </div>
            </div>

        </div>
    </div>

    <!-- ======================
         Chi tiết phí (Fee Items)
         ====================== -->
    <div class="card mb-3">
        <div class="card-header fw-bold">
            Chi tiết các loại phí
        </div>
        <div class="card-body">
            @for (int i = 0; i < Model.FeeItems.Count; i++)
            {
                <input type="hidden" asp-for="FeeItems[i].FeeTypeId" />
                <input type="hidden" asp-for="FeeItems[i].FeeTypeName" />
                <input type="hidden" asp-for="FeeItems[i].CalculationMethod" />
                <input type="hidden" asp-for="FeeItems[i].UnitPrice" />
                <input type="hidden" asp-for="FeeItems[i].BaseAmount" />

                <div class="mb-3 border-bottom pb-3">
                    <h6 class="fw-bold text-primary">@Model.FeeItems[i].FeeTypeName</h6>
                    
                    @if (Model.FeeItems[i].CalculationMethod == "meter")
                    {
                        <div class="row">
                            <div class="col-md-4">
                                <label asp-for="FeeItems[i].PreviousReading" class="form-label">Chỉ số đầu</label>
                                <input asp-for="FeeItems[i].PreviousReading" class="form-control" />
                            </div>
                            <div class="col-md-4">
                                <label asp-for="FeeItems[i].CurrentReading" class="form-label">Chỉ số cuối</label>
                                <input asp-for="FeeItems[i].CurrentReading" class="form-control" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Đơn giá</label>
                                <input class="form-control" value="@Model.FeeItems[i].UnitPrice.ToString("N0")" disabled />
                            </div>
                        </div>
                    }
                    else if (Model.FeeItems[i].CalculationMethod == "per_person")
                    {
                        <div class="row">
                            <div class="col-md-6">
                                <label asp-for="FeeItems[i].Quantity" class="form-label">Số người</label>
                                <input asp-for="FeeItems[i].Quantity" class="form-control" value="@(Model.FeeItems[i].Quantity ?? 1)" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Đơn giá (VNĐ/người)</label>
                                <input class="form-control" value="@Model.FeeItems[i].BaseAmount.ToString("N0")" disabled />
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="row">
                            <div class="col-md-12">
                                <label class="form-label">Chi phí thu cố định (VNĐ)</label>
                                <input class="form-control" value="@Model.FeeItems[i].BaseAmount.ToString("N0")" disabled />
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <!-- ======================
         Phát sinh (tạm thời đơn giản)
         ====================== -->
    <div class="card mb-4">
        <div class="card-header fw-bold d-flex justify-content-between align-items-center">
            <span>Phí phát sinh (Dịch vụ thêm, Sửa chữa, v.v...)</span>
            <button type="button" class="btn btn-sm btn-outline-primary" id="addExtraChargeBtn">
                <i class="bi bi-plus-circle"></i> Thêm phí
            </button>
        </div>
        <div class="card-body p-0">
            <table class="table table-borderless table-striped mb-0" id="extraChargesTable">
                <thead class="table-light">
                    <tr>
                        <th width="30%">Loại phí</th>
                        <th width="40%">Mô tả</th>
                        <th width="20%">Số tiền</th>
                        <th width="10%"></th>
                    </tr>
                </thead>
                <tbody id="extraChargesBody">
                    <!-- Dynamic rows here -->
                </tbody>
            </table>
        </div>
    </div>

    <!-- ======================
         Actions
         ====================== -->
    <div class="d-flex gap-2 mb-5">
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-check-circle"></i> Tạo hóa đơn
        </button>

        <a asp-action="Details" asp-controller="Room" asp-route-id="@Model.RoomId" class="btn btn-secondary">
            <i class="bi bi-x-circle"></i> Hủy
        </a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function () {
            let chargeIndex = 0;

            $('#addExtraChargeBtn').click(function () {
                const rowHtml = `
                    <tr id="charge-row-${chargeIndex}">
                        <td>
                            <select name="ExtraCharges[${chargeIndex}].ItemType" class="form-select">
                                <option value="other">Khác</option>
                                <option value="service">Dịch vụ</option>
                                <option value="repair">Sửa chữa</option>
                                <option value="penalty">Phạt</option>
                            </select>
                        </td>
                        <td>
                            <input type="text" name="ExtraCharges[${chargeIndex}].Description" class="form-control" placeholder="Nhập mô tả..." />
                        </td>
                        <td>
                            <input type="number" name="ExtraCharges[${chargeIndex}].Amount" class="form-control" value="0" min="0" />
                        </td>
                        <td class="text-end">
                            <button type="button" class="btn btn-outline-danger btn-sm remove-charge-btn" data-id="${chargeIndex}">
                                <i class="bi bi-trash"></i>
                            </button>
                        </td>
                    </tr>
                `;
                $('#extraChargesBody').append(rowHtml);
                chargeIndex++;
            });

            $(document).on('click', '.remove-charge-btn', function () {
                const id = $(this).data('id');
                $(`#charge-row-${id}`).remove();
                
                // Re-index remaining rows to ensure model binding works
                $('#extraChargesBody tr').each(function(index) {
                    $(this).find('select, input').each(function() {
                        const name = $(this).attr('name');
                        if (name) {
                            const newName = name.replace(/\[\d+\]/, '[' + index + ']');
                            $(this).attr('name', newName);
                        }
                    });
                    
                    // Update button data-id AND row id so removal continues to work correctly
                    $(this).find('.remove-charge-btn').data('id', index);
                    $(this).attr('id', 'charge-row-' + index);
                });
                chargeIndex = $('#extraChargesBody tr').length;
            });
        });
    </script>
}
