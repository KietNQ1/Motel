@model Motel.Models.Invoice

@{
    ViewData["Title"] = $"Hóa đơn #{Model.InvoiceId}";
    string FormatVnd(decimal? amount)
    {
        var v = amount ?? 0m;
        // 0 decimals, VN style
        return string.Format(System.Globalization.CultureInfo.GetCultureInfo("vi-VN"), "{0:N0} đ", v);
    }

    string FormatDate(object? d)
    {
        if (d is null) return "";
        return d.ToString() ?? "";
    }

    var lines = Model.InvoiceLines ?? new List<Motel.Models.InvoiceLine>();
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <h2 class="mb-0">Hóa đơn #@Model.InvoiceId</h2>

    <div class="d-flex gap-2">

    <a class="btn btn-secondary"
       asp-controller="Invoice"
       asp-action="Create"
       asp-route-contractId="@Model.ContractId">
        Tạo hóa đơn mới
    </a>

    @if (Model.Status == "unpaid")
    {
        <a class="btn btn-success"
           asp-controller="Payment"
           asp-action="CreateIntent"
           asp-route-invoiceId="@Model.InvoiceId">
            Thanh toán
        </a>
    }
    else
    {
        <span class="badge bg-success align-self-center">
            Đã thanh toán
        </span>
    }

</div>
</div>

<!-- Thông tin chung -->
<div class="card mb-3">
    <div class="card-header fw-bold">Thông tin hóa đơn</div>
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-3">
                <div class="text-muted">ContractId</div>
                <div class="fw-semibold">@Model.ContractId</div>
            </div>

            <div class="col-md-3">
                <div class="text-muted">RoomId</div>
                <div class="fw-semibold">@Model.RoomId</div>
            </div>

            <div class="col-md-3">
                <div class="text-muted">Kỳ (YYYYMM)</div>
                <div class="fw-semibold">@Model.PeriodMonth</div>
            </div>

            <div class="col-md-3">
                <div class="text-muted">Trạng thái</div>
                <div class="fw-semibold text-uppercase">@Model.Status</div>
            </div>

            <div class="col-md-3">
                <div class="text-muted">Hạn thanh toán</div>
                <div class="fw-semibold">@FormatDate(Model.DueDate)</div>
            </div>

            <div class="col-md-3">
                <div class="text-muted">Ngày tạo</div>
                <div class="fw-semibold">@FormatDate(Model.CreatedAt)</div>
            </div>

            <div class="col-md-3">
                <div class="text-muted">Tổng tiền</div>
                <div class="fw-bold">@FormatVnd(Model.TotalAmount)</div>
            </div>
        </div>
    </div>
</div>

<!-- Chi tiết -->
<div class="card mb-3">
    <div class="card-header fw-bold">Chi tiết khoản thu</div>
    <div class="card-body p-0">
        <table class="table table-striped table-bordered mb-0">
            <thead>
                <tr>
                    <th style="width: 140px;">Loại</th>
                    <th>Mô tả</th>
                    <th class="text-end" style="width: 120px;">Số lượng</th>
                    <th class="text-end" style="width: 150px;">Đơn giá</th>
                    <th class="text-end" style="width: 160px;">Thành tiền</th>
                </tr>
            </thead>
            <tbody>
                @if (!lines.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted p-4">
                            Không có dòng chi tiết nào.
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var l in lines)
                    {
                        <tr>
                            <td class="text-uppercase">@l.ItemType</td>
                            <td>@l.Description</td>
                            <td class="text-end">@((l.Quantity).ToString("N2"))</td>
                            <td class="text-end">@FormatVnd(l.UnitPrice)</td>
                            <td class="text-end fw-semibold">@FormatVnd(l.LineTotal)</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Tổng kết -->
<div class="card">
    <div class="card-header fw-bold">Tổng kết</div>
    <div class="card-body">
        @{
            // Nếu LineTotal nullable thì xử lý an toàn
            var subtotal = lines.Sum(x => x.LineTotal ?? 0m);
        }

        <div class="row">
            <div class="col-md-6 text-muted">
                Ghi chú: Bạn có thể thêm phần “Xuất PDF” và “Tạo QR thanh toán” ở đây sau.
            </div>

            <div class="col-md-6">
                <div class="d-flex justify-content-between">
                    <div class="text-muted">Tạm tính</div>
                    <div class="fw-semibold">@FormatVnd(subtotal)</div>
                </div>
                <hr />
                <div class="d-flex justify-content-between">
                    <div class="fw-bold">Tổng cần thanh toán</div>
                    <div class="fw-bold">@FormatVnd(Model.TotalAmount)</div>
                </div>
            </div>
        </div>
    </div>
</div>
