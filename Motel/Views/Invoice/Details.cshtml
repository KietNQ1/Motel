@model Motel.Models.Invoice

@{
    ViewData["Title"] = $"Hóa đơn #{Model.InvoiceId}";

    string FormatVnd(decimal? amount)
    {
        var v = amount ?? 0m;
        return string.Format(System.Globalization.CultureInfo.GetCultureInfo("vi-VN"), "{0:N0} đ", v);
    }

    string FormatDate(object? d)
    {
        if (d is null) return "—";
        return d.ToString() ?? "—";
    }

    var lines = Model.InvoiceLines ?? new List<Motel.Models.InvoiceLine>();
    var subtotal = lines.Sum(x => x.LineTotal ?? 0m);

    bool isPaid = Model.Status == "paid";

    string statusLabel = Model.Status switch
    {
        "paid" => "Đã thanh toán",
        "unpaid" => "Chưa thanh toán",
        "overdue" => "Quá hạn",
        _ => Model.Status ?? "—"
    };
    string statusColor = Model.Status switch
    {
        "paid" => "#1a7a4a",
        "unpaid" => "#994200",
        "overdue" => "#ba1a1a",
        _ => "#574238"
    };
    string statusBg = Model.Status switch
    {
        "paid" => "#d4f5e2",
        "unpaid" => "#ffdbca",
        "overdue" => "#ffdad6",
        _ => "#f3f3f3"
    };
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">
    <style>
        .rc-page {
            font-family: 'Manrope', sans-serif;
            --rc-primary: #994200;
            --rc-primary-dark: #c05500;
            --rc-primary-fixed: #ffdbca;
            --rc-on-primary-fixed: #331100;
            --rc-outline-var: #dec0b2;
            --rc-surface-low: #f3f3f3;
            --rc-surface-lowest: #ffffff;
            --rc-on-surface: #1a1c1c;
            --rc-on-surface-var: #574238;
            --rc-tertiary-fixed: #d1e4ff;
            --rc-tertiary: #005fa0;
            --rc-error: #ba1a1a;
        }

            .rc-page .msym {
                font-family: 'Material Symbols Outlined';
                font-size: 20px;
                line-height: 1;
                user-select: none;
                vertical-align: middle;
            }

        /* Breadcrumb */
        .rc-breadcrumb {
            display: flex;
            align-items: center;
            gap: .4rem;
            font-size: .82rem;
            color: var(--rc-on-surface-var);
            margin-bottom: 1.5rem;
        }

            .rc-breadcrumb a {
                color: inherit;
                text-decoration: none;
            }

                .rc-breadcrumb a:hover {
                    color: var(--rc-primary);
                }

            .rc-breadcrumb strong {
                color: var(--rc-on-surface);
            }

        /* Page heading row */
        .rc-page-header {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 1rem;
            flex-wrap: wrap;
            margin-bottom: 2rem;
        }

            .rc-page-header h1 {
                font-size: clamp(1.8rem, 4vw, 2.6rem);
                font-weight: 800;
                letter-spacing: -0.02em;
                color: var(--rc-on-surface);
                line-height: 1.1;
                margin: 0 0 .35rem;
            }

            .rc-page-header p {
                color: var(--rc-on-surface-var);
                font-size: .88rem;
                margin: 0;
            }

        .rc-header-actions {
            display: flex;
            gap: .65rem;
            align-items: center;
            flex-shrink: 0;
            flex-wrap: wrap;
        }

        /* Status badge */
        .rc-status-badge {
            display: inline-flex;
            align-items: center;
            gap: .35rem;
            padding: .3rem .85rem;
            border-radius: 2rem;
            font-size: .75rem;
            font-weight: 700;
            letter-spacing: .04em;
        }

            .rc-status-badge .msym {
                font-size: 15px;
            }

        /* Layout */
        .rc-layout {
            display: grid;
            grid-template-columns: 1fr;
            gap: 1.75rem;
            align-items: start;
        }

        @@media (min-width: 992px) {
            .rc-layout {
                grid-template-columns: 1fr 280px;
            }
        }

        .rc-main-col {
            display: flex;
            flex-direction: column;
            gap: 1.25rem;
        }

        .rc-side-col {
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        /* Cards */
        .rc-card {
            background: var(--rc-surface-lowest);
            border-radius: 1rem;
            padding: 1.75rem;
            box-shadow: 0 1px 6px rgba(0,0,0,.06);
        }

        .rc-card-muted {
            background: var(--rc-surface-low);
            border-radius: 1rem;
            padding: 1.75rem;
            border: 1px solid rgba(222,192,178,.25);
        }

            .rc-card h3, .rc-card-muted h3 {
                font-size: 1rem;
                font-weight: 700;
                color: var(--rc-on-surface);
                display: flex;
                align-items: center;
                gap: .5rem;
                margin-bottom: 1.4rem;
            }

                .rc-card h3 .msym,
                .rc-card-muted h3 .msym {
                    color: var(--rc-primary);
                }

        /* Info grid */
        .rc-info-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 1.2rem 1.5rem;
        }

        @@media (min-width: 768px) {
            .rc-info-grid {
                grid-template-columns: repeat(4, 1fr);
            }
        }

        .rc-info-cell .label {
            font-size: .67rem;
            font-weight: 700;
            letter-spacing: .09em;
            text-transform: uppercase;
            color: var(--rc-on-surface-var);
            margin-bottom: .25rem;
        }

        .rc-info-cell .value {
            font-size: .95rem;
            font-weight: 600;
            color: var(--rc-on-surface);
        }

            .rc-info-cell .value.big {
                font-size: 1.1rem;
                font-weight: 800;
                color: var(--rc-primary);
            }

        /* Lines table */
        .rc-table {
            width: 100%;
            border-collapse: collapse;
        }

            .rc-table thead th {
                font-size: .67rem;
                font-weight: 700;
                letter-spacing: .08em;
                text-transform: uppercase;
                color: var(--rc-on-surface-var);
                padding: .4rem .75rem .75rem;
                border-bottom: 2px solid var(--rc-outline-var);
            }

                .rc-table thead th.text-end {
                    text-align: right;
                }

            .rc-table tbody tr {
                border-bottom: 1px solid rgba(222,192,178,.2);
                transition: background .15s;
            }

                .rc-table tbody tr:hover {
                    background: rgba(255,219,202,.1);
                }

                .rc-table tbody tr:last-child {
                    border-bottom: none;
                }

            .rc-table td {
                padding: .75rem;
                font-size: .88rem;
                color: var(--rc-on-surface);
                vertical-align: middle;
            }

                .rc-table td.text-end {
                    text-align: right;
                }

                .rc-table td.mono {
                    font-variant-numeric: tabular-nums;
                    font-weight: 600;
                }

            .rc-table .fee-chip {
                display: inline-block;
                background: var(--rc-primary-fixed);
                color: var(--rc-on-primary-fixed);
                font-size: .7rem;
                font-weight: 700;
                padding: .18rem .6rem;
                border-radius: 2rem;
                letter-spacing: .04em;
            }

        .rc-empty-state {
            text-align: center;
            padding: 2.5rem 1rem;
            color: var(--rc-on-surface-var);
            font-size: .85rem;
        }

            .rc-empty-state .msym {
                font-size: 36px;
                color: var(--rc-outline-var);
                display: block;
                margin-bottom: .5rem;
            }

        /* Summary sidebar */
        .rc-summary-box {
            background: var(--rc-surface-lowest);
            border-radius: 1rem;
            padding: 1.4rem;
            box-shadow: 0 1px 6px rgba(0,0,0,.06);
        }

            .rc-summary-box h4 {
                font-size: .88rem;
                font-weight: 700;
                color: var(--rc-on-surface);
                display: flex;
                align-items: center;
                gap: .4rem;
                margin-bottom: 1rem;
            }

                .rc-summary-box h4 .msym {
                    color: var(--rc-primary);
                    font-size: 18px;
                }

        .rc-summary-row {
            display: flex;
            justify-content: space-between;
            padding: .45rem 0;
            border-bottom: 1px solid rgba(222,192,178,.2);
            font-size: .82rem;
        }

            .rc-summary-row:last-of-type {
                border-bottom: none;
            }

            .rc-summary-row .label {
                color: var(--rc-on-surface-var);
            }

            .rc-summary-row .value {
                font-weight: 600;
                color: var(--rc-on-surface);
                font-variant-numeric: tabular-nums;
            }

        .rc-summary-total {
            display: flex;
            justify-content: space-between;
            align-items: baseline;
            margin-top: .85rem;
            padding-top: .85rem;
            border-top: 2px solid var(--rc-outline-var);
        }

            .rc-summary-total .label {
                font-size: .72rem;
                font-weight: 700;
                letter-spacing: .08em;
                text-transform: uppercase;
                color: var(--rc-on-surface-var);
            }

            .rc-summary-total .value {
                font-size: 1.3rem;
                font-weight: 800;
                color: var(--rc-primary);
                font-variant-numeric: tabular-nums;
            }

        /* Buttons */
        .rc-btn-primary {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: .45rem;
            width: 100%;
            padding: .85rem;
            background: linear-gradient(135deg, var(--rc-primary), var(--rc-primary-dark));
            color: #fff;
            border: none;
            border-radius: .75rem;
            font-weight: 800;
            font-size: .9rem;
            font-family: 'Manrope', sans-serif;
            cursor: pointer;
            box-shadow: 0 6px 20px rgba(153,66,0,.22);
            transition: box-shadow .2s, transform .15s;
            text-decoration: none;
        }

            .rc-btn-primary:hover {
                box-shadow: 0 10px 28px rgba(153,66,0,.32);
                color: #fff;
            }

            .rc-btn-primary:active {
                transform: scale(.97);
            }

        .rc-btn-secondary {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: .45rem;
            width: 100%;
            padding: .85rem;
            background: transparent;
            color: var(--rc-on-surface);
            border: 2px solid var(--rc-outline-var);
            border-radius: .75rem;
            font-weight: 700;
            font-size: .9rem;
            font-family: 'Manrope', sans-serif;
            cursor: pointer;
            transition: background .15s, transform .15s;
            text-decoration: none;
        }

            .rc-btn-secondary:hover {
                background: var(--rc-surface-low);
                color: var(--rc-on-surface);
            }

            .rc-btn-secondary:active {
                transform: scale(.97);
            }

        /* Paid banner */
        .rc-paid-banner {
            display: flex;
            align-items: center;
            gap: .75rem;
            background: #d4f5e2;
            border-radius: .75rem;
            padding: 1rem 1.25rem;
            color: #1a7a4a;
            font-weight: 600;
            font-size: .88rem;
        }

            .rc-paid-banner .msym {
                font-size: 22px;
                flex-shrink: 0;
            }

        /* Note box */
        .rc-note-box {
            padding: 1rem 1.25rem;
            border-radius: .75rem;
            background: var(--rc-surface-low);
            border: 2px dashed var(--rc-outline-var);
            font-size: .75rem;
            color: var(--rc-on-surface-var);
            line-height: 1.6;
        }

            .rc-note-box strong {
                color: var(--rc-on-surface);
            }
    </style>
}

<div class="rc-page py-4 py-lg-5">
    <div class="container-lg">

        @* Breadcrumb *@
        <nav class="rc-breadcrumb" aria-label="Breadcrumb">
            <a asp-controller="Invoice" asp-action="Index">Danh sách hóa đơn</a>
            <span class="msym">chevron_right</span>
            <strong>Hóa đơn #@Model.InvoiceId</strong>
        </nav>

        @* Page heading *@
        <div class="rc-page-header">
            <div>
                <h1>Hóa đơn <span style="color:var(--rc-primary)">#@Model.InvoiceId</span></h1>
                <p>
                    Kỳ @Model.PeriodMonth &nbsp;·&nbsp; Hạn thanh toán: @FormatDate(Model.DueDate)
                </p>
            </div>
            <div class="rc-header-actions">
                <span class="rc-status-badge"
                      style="background:@statusBg; color:@statusColor;">
                    @if (isPaid)
                    {
                        <span class="msym">check_circle</span>
                    }
                    else if (Model.Status == "overdue")
                    {
                        <span class="msym">warning</span>
                    }
                    else
                    {
                        <span class="msym">schedule</span>
                    }
                    @statusLabel
                </span>
            </div>
        </div>

        <div class="rc-layout">

            @* ── Main column ── *@
            <div class="rc-main-col">

                @* Card 1: General info *@
                <div class="rc-card">
                    <h3>
                        <span class="msym">receipt_long</span>
                        Thông tin hóa đơn
                    </h3>
                    <div class="rc-info-grid">
                        <div class="rc-info-cell">
                            <div class="label">Mã hợp đồng</div>
                            <div class="value">@Model.ContractId</div>
                        </div>
                        <div class="rc-info-cell">
                            <div class="label">Mã phòng</div>
                            <div class="value">@Model.RoomId</div>
                        </div>
                        <div class="rc-info-cell">
                            <div class="label">Kỳ (YYYYMM)</div>
                            <div class="value">@Model.PeriodMonth</div>
                        </div>
                        <div class="rc-info-cell">
                            <div class="label">Trạng thái</div>
                            <div class="value">
                                <span class="rc-status-badge"
                                      style="background:@statusBg; color:@statusColor; padding:.15rem .6rem; font-size:.72rem;">
                                    @statusLabel
                                </span>
                            </div>
                        </div>
                        <div class="rc-info-cell">
                            <div class="label">Hạn thanh toán</div>
                            <div class="value">@FormatDate(Model.DueDate)</div>
                        </div>
                        <div class="rc-info-cell">
                            <div class="label">Ngày tạo</div>
                            <div class="value">@FormatDate(Model.CreatedAt)</div>
                        </div>
                        <div class="rc-info-cell">
                            <div class="label">Tổng tiền</div>
                            <div class="value big">@FormatVnd(Model.TotalAmount)</div>
                        </div>
                    </div>
                </div>

                @* Card 2: Line items *@
                <div class="rc-card-muted">
                    <h3>
                        <span class="msym">payments</span>
                        Chi tiết khoản thu
                    </h3>

                    @if (!lines.Any())
                    {
                        <div class="rc-empty-state">
                            <span class="msym">inbox</span>
                            Không có dòng chi tiết nào.
                        </div>
                    }
                    else
                    {
                        <table class="rc-table">
                            <thead>
                                <tr>
                                    <th style="width:18%">Loại phí</th>
                                    <th>Mô tả</th>
                                    <th class="text-end" style="width:12%">Số lượng</th>
                                    <th class="text-end" style="width:18%">Đơn giá</th>
                                    <th class="text-end" style="width:18%">Thành tiền</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var l in lines)
                                {
                                    <tr>
                                        <td>
                                            <span class="fee-chip">@(l.FeeType?.Name ?? "—")</span>
                                        </td>
                                        <td style="color:var(--rc-on-surface-var)">@l.Description</td>
                                        <td class="text-end mono">@l.Quantity.ToString("N2")</td>
                                        <td class="text-end mono">@FormatVnd(l.UnitPrice)</td>
                                        <td class="text-end mono" style="font-weight:700;">@FormatVnd(l.LineTotal)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>

            </div>

            @* ── Sidebar ── *@
            <div class="rc-side-col">

                @* Summary *@
                <div class="rc-summary-box">
                    <h4>
                        <span class="msym">calculate</span>
                        Tổng kết
                    </h4>
                    <div class="rc-summary-row">
                        <span class="label">Tạm tính</span>
                        <span class="value">@FormatVnd(subtotal)</span>
                    </div>
                    <div class="rc-summary-row">
                        <span class="label">Số dòng</span>
                        <span class="value">@lines.Count() khoản</span>
                    </div>
                    <div class="rc-summary-total">
                        <span class="label">Tổng cần trả</span>
                        <span class="value">@FormatVnd(Model.TotalAmount)</span>
                    </div>
                </div>

                @* Pay / paid state *@
                @if (isPaid)
                {
                    <div class="rc-paid-banner">
                        <span class="msym">verified</span>
                        Hóa đơn này đã được thanh toán đầy đủ.
                    </div>
                }
                else
                {
                    <a class="rc-btn-primary"
                       asp-controller="Payment"
                       asp-action="CreateIntent"
                       asp-route-invoiceId="@Model.InvoiceId">
                        <span class="msym">payments</span>
                        Thanh toán ngay
                    </a>
                }

                @* New invoice *@
                <a class="rc-btn-secondary"
                   asp-controller="Invoice"
                   asp-action="Create"
                   asp-route-contractId="@Model.ContractId">
                    <span class="msym">add_circle</span>
                    Tạo hóa đơn mới
                </a>

                @* Note *@
                <div class="rc-note-box">
                    <strong>Sắp có:</strong> Xuất PDF &amp; Tạo QR thanh toán sẽ được thêm vào đây.
                </div>

            </div>
        </div>
    </div>
</div>
