@model Motel.ViewModels.Payment.CashReceiptViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Biên nhận thanh toán";
}

<div class="mx-auto max-w-3xl px-4 py-6 sm:py-8">
    <div class="overflow-hidden rounded-2xl border border-[#e7d9cf] bg-white shadow-sm dark:border-gray-700 dark:bg-gray-800">

        <div class="flex flex-col items-center border-b border-gray-100 px-6 pb-8 pt-10 text-center dark:border-gray-700">
            <div class="mb-6 flex h-20 w-20 items-center justify-center rounded-full bg-success/15">
                <span class="material-symbols-outlined text-5xl text-success">check_circle</span>
            </div>
            <h1 class="mb-2 text-2xl font-extrabold text-text-main dark:text-white">Thanh toán thành công!</h1>
            <p class="text-sm text-text-sub dark:text-gray-400">Giao dịch của bạn đã được xử lý hoàn tất.</p>
        </div>

        <div class="border-b border-gray-100 bg-secondary/30 px-6 py-6 dark:border-gray-700 dark:bg-gray-900/40">
            <h3 class="mb-4 text-xs font-bold uppercase tracking-widest text-text-sub dark:text-gray-500">Chi tiết giao dịch</h3>

            <div class="space-y-3 text-sm">
                <div class="flex items-center justify-between gap-4">
                    <span class="text-text-sub dark:text-gray-400">Số tiền</span>
                    <span class="text-lg font-bold text-text-main dark:text-white">@Model.TotalAmount.ToString("N0") đ</span>
                </div>
                <div class="flex items-center justify-between gap-4">
                    <span class="text-text-sub dark:text-gray-400">Người thuê</span>
                    <span class="font-medium text-text-main dark:text-gray-200">@Model.TenantName</span>
                </div>
                <div class="flex items-center justify-between gap-4">
                    <span class="text-text-sub dark:text-gray-400">Số điện thoại</span>
                    <span class="font-medium text-text-main dark:text-gray-200">@(string.IsNullOrWhiteSpace(Model.TenantPhone) ? "—" : Model.TenantPhone)</span>
                </div>
                <div class="flex items-center justify-between gap-4">
                    <span class="text-text-sub dark:text-gray-400">Phòng</span>
                    <span class="font-medium text-text-main dark:text-gray-200">@Model.RoomName</span>
                </div>
                <div class="flex items-center justify-between gap-4">
                    <span class="text-text-sub dark:text-gray-400">Khu trọ</span>
                    <span class="font-medium text-text-main dark:text-gray-200">@Model.PropertyName</span>
                </div>
                <div class="flex items-center justify-between gap-4">
                    <span class="text-text-sub dark:text-gray-400">Mã giao dịch</span>
                    <span class="max-w-[60%] break-all rounded bg-gray-100 px-2 py-0.5 font-mono text-xs text-text-main dark:bg-gray-700 dark:text-gray-100">@Model.ProviderTxnId</span>
                </div>
                <div class="flex items-center justify-between gap-4">
                    <span class="text-text-sub dark:text-gray-400">Mã thanh toán</span>
                    <span class="font-medium text-text-main dark:text-gray-200">#@Model.PaymentId</span>
                </div>
                <div class="flex items-center justify-between gap-4">
                    <span class="text-text-sub dark:text-gray-400">Ngày thanh toán</span>
                    <span class="font-medium text-text-main dark:text-gray-200">@Model.PaidAt.ToString("dd/MM/yyyy HH:mm")</span>
                </div>
                <div class="flex items-center justify-between gap-4">
                    <span class="text-text-sub dark:text-gray-400">Kỳ thanh toán</span>
                    <span class="font-medium text-text-main dark:text-gray-200">Tháng @Model.PeriodMonth</span>
                </div>
                <div class="flex items-center justify-between gap-4">
                    <span class="text-text-sub dark:text-gray-400">Hạn thanh toán</span>
                    <span class="font-medium text-text-main dark:text-gray-200">@Model.DueDate.ToString("dd/MM/yyyy")</span>
                </div>
                <div class="flex items-center justify-between gap-4">
                    <span class="text-text-sub dark:text-gray-400">Phương thức</span>
                    <div class="flex items-center gap-2">
                        <span class="material-symbols-outlined text-lg text-primary">@Model.PaymentMethodIcon</span>
                        <span class="font-semibold text-text-main dark:text-gray-200">@Model.PaymentMethodLabel</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="px-6 py-6">
            <h3 class="mb-4 text-xs font-bold uppercase tracking-widest text-text-sub dark:text-gray-500">Chi tiết hóa đơn</h3>
            <div class="overflow-hidden rounded-xl border border-[#e7d9cf] dark:border-gray-600">
                <table class="w-full text-sm">
                    <thead class="bg-secondary/50 dark:bg-gray-700/50">
                        <tr>
                            <th class="px-4 py-3 text-left font-semibold text-text-main dark:text-gray-200">Loại phí</th>
                            <th class="px-4 py-3 text-left font-semibold text-text-main dark:text-gray-200">Mô tả</th>
                            <th class="px-4 py-3 text-right font-semibold text-text-main dark:text-gray-200">SL</th>
                            <th class="px-4 py-3 text-right font-semibold text-text-main dark:text-gray-200">Đơn giá</th>
                            <th class="px-4 py-3 text-right font-semibold text-text-main dark:text-gray-200">Thành tiền</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var line in Model.Lines)
                        {
                            <tr class="border-t border-[#e7d9cf] dark:border-gray-600">
                                <td class="px-4 py-3 text-text-main dark:text-gray-200">@line.ItemType</td>
                                <td class="px-4 py-3 text-text-sub dark:text-gray-400">@line.Description</td>
                                <td class="px-4 py-3 text-right">@line.Quantity</td>
                                <td class="px-4 py-3 text-right">@line.UnitPrice.ToString("N0")</td>
                                <td class="px-4 py-3 text-right font-medium text-text-main dark:text-gray-200">@line.LineTotal.ToString("N0")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="flex flex-col gap-3 border-t border-gray-100 px-6 py-6 dark:border-gray-700 sm:flex-row">
            <a asp-controller="Home" asp-action="Index"
               class="flex h-12 flex-1 items-center justify-center gap-2 rounded-xl bg-primary font-bold text-white shadow-lg shadow-primary/25 transition hover:bg-primary-dark">
                <span class="material-symbols-outlined text-lg">home</span>
                Về trang chủ
            </a>
            <button type="button" onclick="window.print()"
                    class="flex h-12 flex-1 items-center justify-center gap-2 rounded-xl border border-[#e7d9cf] font-bold text-text-main transition hover:bg-gray-50 dark:border-gray-600 dark:text-gray-200 dark:hover:bg-gray-700">
                <span class="material-symbols-outlined text-lg">receipt_long</span>
                In biên lai
            </button>
        </div>
    </div>
</div>
