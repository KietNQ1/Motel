@model Motel.ViewModels.Payment.VietQrPaymentViewModel
@{
    Layout = null;
    ViewData["Title"] = "Thanh toán VietQR - Motel";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>@ViewData["Title"]</title>

    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />

    <script>
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#f27121",
                        "background-light": "#f8fafc",
                    },
                    fontFamily: { "display": ["Inter"] },
                    borderRadius: { "DEFAULT": "0.25rem", "lg": "0.5rem", "xl": "0.75rem", "full": "9999px" },
                },
            },
        }
    </script>
    <style>
        body { font-family: 'Inter', sans-serif; }
        .material-symbols-outlined { font-variation-settings: 'FILL' 0,'wght' 400,'GRAD' 0,'opsz' 24; }
    </style>
</head>
<body class="bg-slate-50 text-slate-900 font-display">
<div class="flex min-h-screen flex-col">
    <header class="w-full bg-white border-b border-slate-200 sticky top-0 z-50">
        <div class="max-w-[960px] mx-auto px-6 py-4 flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div class="bg-[#e65c00] h-10 w-10 rounded-lg flex items-center justify-center text-white">
                    <span class="material-symbols-outlined">qr_code_2</span>
                </div>
                <div>
                    <p class="text-xl font-bold text-slate-800">Thanh toán qua VietQR</p>
                    <p class="text-xs text-slate-500">Hóa đơn #@Model.InvoiceId</p>
                </div>
            </div>
        </div>
    </header>

    <main class="flex-1 overflow-y-auto bg-[#f8fafc] p-6">
        <div class="max-w-[960px] mx-auto grid grid-cols-1 md:grid-cols-[minmax(0,3fr)_minmax(0,2fr)] gap-6">
            <section class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6 md:p-8">
                <h2 class="text-xl font-extrabold text-slate-900 mb-2 flex items-center gap-2">
                    <span class="material-symbols-outlined text-primary">qr_code_scanner</span>
                    Quét mã để thanh toán
                </h2>
                <p class="text-sm text-slate-600 mb-6">
                    Sử dụng ứng dụng ngân hàng trên điện thoại của bạn để quét mã QR bên dưới và xác nhận thanh toán.
                </p>

                <div class="flex flex-col items-center justify-center gap-4">
                    <div class="inline-flex items-center justify-center rounded-2xl border-4 border-white shadow-[0_20px_60px_rgba(15,23,42,0.35)] bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 p-4">
                        <div class="bg-white rounded-xl p-3">
                            <img src="@Model.QrImageUrl"
                                 alt="VietQR thanh toán hóa đơn @Model.InvoiceId"
                                 class="w-64 h-64 md:w-72 md:h-72 object-contain" />
                        </div>
                    </div>

                    <div class="text-center space-y-1">
                        <div class="text-xs uppercase tracking-[0.18em] text-slate-400 font-semibold">Nội dung chuyển khoản</div>
                        <div class="font-mono text-sm md:text-base font-semibold text-slate-900 bg-slate-100 inline-flex items-center gap-2 px-3 py-1.5 rounded-full">
                            <span class="material-symbols-outlined text-slate-500 text-base">content_copy</span>
                            <span>@Model.TransferContent</span>
                        </div>
                        <p class="text-xs text-slate-500 mt-1">
                            Vui lòng giữ nguyên <span class="font-semibold">nội dung chuyển khoản</span> để hệ thống đối chiếu hóa đơn chính xác.
                        </p>
                    </div>
                </div>
            </section>

            <aside class="space-y-4">
                <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-5 space-y-4">
                    <div>
                        <div class="text-xs font-semibold text-slate-500 uppercase tracking-[0.18em] mb-1.5">
                            Chủ tài khoản nhận
                        </div>
                        <div class="text-base font-bold text-slate-900">@Model.BankAccountName</div>
                        <div class="text-xs text-slate-500">@Model.LandlordName</div>
                    </div>

                    <div class="border-t border-slate-100 pt-4 space-y-3">
                        <div class="flex items-center justify-between text-sm">
                            <span class="text-slate-500">Ngân hàng</span>
                            <span class="font-semibold text-slate-900 text-right">@Model.BankName (@Model.BankCode)</span>
                        </div>
                        <div class="flex items-center justify-between text-sm">
                            <span class="text-slate-500">Số tài khoản</span>
                            <span class="font-mono font-semibold text-slate-900">@Model.BankAccountNumber</span>
                        </div>
                    </div>

                    <div class="border-t border-slate-100 pt-4 space-y-3">
                        <div class="flex items-center justify-between">
                            <span class="text-sm text-slate-500">Số tiền cần thanh toán</span>
                            <span class="text-lg font-extrabold text-emerald-600">
                                @Model.Amount.ToString("N0") đ
                            </span>
                        </div>
                        @if (!string.IsNullOrEmpty(Model.RoomName) || !string.IsNullOrEmpty(Model.PropertyName))
                        {
                            <div class="text-xs text-slate-500">
                                Hóa đơn cho
                                @if (!string.IsNullOrEmpty(Model.RoomName))
                                {
                                    <span class="font-semibold text-slate-800">@Model.RoomName</span>
                                }
                                @if (!string.IsNullOrEmpty(Model.PropertyName))
                                {
                                    <span> · @Model.PropertyName</span>
                                }
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(Model.TenantName))
                        {
                            <div class="text-xs text-slate-500">
                                Người thuê: <span class="font-semibold text-slate-800">@Model.TenantName</span>
                            </div>
                        }
                    </div>
                </div>

                <div class="bg-slate-900 rounded-2xl text-slate-50 p-4 space-y-3 shadow-lg shadow-slate-900/40">
                    <div class="flex items-center gap-3">
                        <div class="h-9 w-9 rounded-full bg-slate-800 flex items-center justify-center text-amber-400">
                            <span class="material-symbols-outlined text-xl">info</span>
                        </div>
                        <div>
                            <p class="text-sm font-semibold">Hướng dẫn thanh toán</p>
                            <p class="text-xs text-slate-300 mt-0.5">
                                1) Mở app ngân hàng, 2) Chọn quét mã QR, 3) Kiểm tra số tiền và tên chủ tài khoản, 4) Dán nội dung <span class="font-semibold">"@Model.TransferContent"</span> nếu app không tự điền, 5) Xác nhận thanh toán.
                            </p>
                        </div>
                    </div>
                </div>

                <div class="flex items-center justify-between gap-3">
                    <a asp-controller="Invoice"
                       asp-action="Details"
                       asp-route-id="@Model.InvoiceId"
                       class="inline-flex items-center justify-center px-4 py-2.5 rounded-xl border border-slate-300 text-sm font-semibold text-slate-700 hover:bg-slate-100 transition-colors w-full md:w-auto">
                        <span class="material-symbols-outlined text-base mr-1">arrow_back</span>
                        Quay lại hóa đơn
                    </a>

                    <form asp-action="VietQrTenantConfirmed"
                          asp-controller="Payment"
                          method="post"
                          class="w-full md:w-auto">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="paymentIntentId" value="@Model.PaymentIntentId" />
                        <button type="submit"
                                class="inline-flex items-center justify-center px-4 py-2.5 rounded-xl bg-primary text-white text-sm font-semibold hover:bg-orange-600 transition-colors w-full md:w-auto">
                            <span class="material-symbols-outlined text-base mr-1">done_all</span>
                            Tôi đã thanh toán
                        </button>
                    </form>
                </div>
            </aside>
        </div>
    </main>
</div>
</body>
</html>

