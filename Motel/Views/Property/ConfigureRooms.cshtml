@model Motel.ViewModels.Property.RoomStructureViewModel

@{
    ViewData["Title"] = "Cấu hình phòng";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow">
                <div class="card-header bg-success text-white">
                    <h4 class="mb-0">
                        <i class="bi bi-grid-3x3-gap"></i> Cấu hình cấu trúc phòng
                    </h4>
                    <small>Nhà trọ: @Model.PropertyName</small>
                </div>
                <div class="card-body">
                    <form asp-action="ConfigureRooms" method="post" id="roomConfigForm">
                        <input type="hidden" asp-for="PropertyId" />
                        <input type="hidden" asp-for="PropertyName" />
                        
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <div class="mb-4">
                            <label asp-for="NumberOfFloors" class="form-label fw-bold"></label>
                            <input asp-for="NumberOfFloors" class="form-control" type="number" min="1" max="50" id="numberOfFloors" />
                            <span asp-validation-for="NumberOfFloors" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold">Số phòng mỗi tầng</label>
                            <div id="floorsContainer">
                                <!-- Floors will be dynamically generated here -->
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="DefaultRentPrice" class="form-label fw-bold"></label>
                            <div class="input-group">
                                <input asp-for="DefaultRentPrice" class="form-control" type="number" step="100000" />
                                <span class="input-group-text">VNĐ/tháng</span>
                            </div>
                            <span asp-validation-for="DefaultRentPrice" class="text-danger"></span>
                            <small class="form-text text-muted">
                                Giá này sẽ được áp dụng cho tất cả phòng. Bạn có thể chỉnh sửa riêng cho từng phòng sau.
                            </small>
                        </div>

                        <div class="alert alert-info">
                            <i class="bi bi-info-circle"></i>
                            <strong>Quy tắc đánh số phòng:</strong> Tầng 3 phòng 2 → <strong>302</strong>, Tầng 2 phòng 1 → <strong>201</strong>
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-x-circle"></i> Hủy
                            </a>
                            <button type="submit" class="btn btn-success">
                                <i class="bi bi-check-circle"></i> Tạo phòng
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const numberOfFloorsInput = document.getElementById('numberOfFloors');
            const floorsContainer = document.getElementById('floorsContainer');

            function generateFloorInputs() {
                const floors = parseInt(numberOfFloorsInput.value) || 1;
                floorsContainer.innerHTML = '';

                for (let i = 0; i < floors; i++) {
                    const floorDiv = document.createElement('div');
                    floorDiv.className = 'mb-3';
                    floorDiv.innerHTML = `
                        <label class="form-label">Tầng ${i + 1}</label>
                        <div class="input-group">
                            <span class="input-group-text">Số phòng:</span>
                            <input type="number" name="RoomsPerFloor[${i}]" class="form-control" min="1" max="50" value="5" required />
                            <span class="input-group-text">phòng</span>
                        </div>
                    `;
                    floorsContainer.appendChild(floorDiv);
                }
            }

            numberOfFloorsInput.addEventListener('change', generateFloorInputs);
            numberOfFloorsInput.addEventListener('input', generateFloorInputs);
            
            // Initialize on page load
            generateFloorInputs();
        });
    </script>
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
}
