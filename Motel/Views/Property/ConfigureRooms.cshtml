@model Motel.ViewModels.Property.RoomStructureViewModel

@{
    ViewData["Title"] = "Tạo phòng trọ";
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">
    <style>
        .rc-page {
            font-family: 'Manrope', sans-serif;
            --rc-primary: #994200;
            --rc-primary-dark: #c05500;
            --rc-primary-fixed: #ffdbca;
            --rc-on-primary-fixed: #331100;
            --rc-secondary-fixed: #ffdbca;
            --rc-outline-var: #dec0b2;
            --rc-surface-low: #f3f3f3;
            --rc-surface-lowest: #ffffff;
            --rc-on-surface: #1a1c1c;
            --rc-on-surface-var: #574238;
            --rc-tertiary-fixed: #d1e4ff;
            --rc-tertiary: #005fa0;
        }

            .rc-page .msym {
                font-family: 'Material Symbols Outlined';
                font-size: 20px;
                line-height: 1;
                user-select: none;
                vertical-align: middle;
            }

        /* Breadcrumb */
        .rc-breadcrumb {
            display: flex;
            align-items: center;
            gap: .4rem;
            font-size: .82rem;
            color: var(--rc-on-surface-var);
            margin-bottom: 1.5rem;
        }

            .rc-breadcrumb a {
                color: inherit;
                text-decoration: none;
            }

                .rc-breadcrumb a:hover {
                    color: var(--rc-primary);
                }

            .rc-breadcrumb strong {
                color: var(--rc-on-surface);
            }

        /* Page heading */
        .rc-page-header {
            margin-bottom: 2rem;
        }

            .rc-page-header h1 {
                font-size: clamp(1.8rem, 4vw, 2.6rem);
                font-weight: 800;
                letter-spacing: -0.02em;
                color: var(--rc-on-surface);
                line-height: 1.1;
                margin-bottom: .4rem;
            }

            .rc-page-header p {
                color: var(--rc-on-surface-var);
                font-size: .92rem;
                margin: 0;
            }

        /* Layout grid */
        .rc-layout {
            display: grid;
            grid-template-columns: 1fr;
            gap: 1.75rem;
            align-items: start;
        }

        @@media (min-width: 992px) {
            .rc-layout {
                grid-template-columns: 1fr 300px;
            }
        }

        .rc-main-col {
            display: flex;
            flex-direction: column;
            gap: 1.25rem;
        }

        .rc-side-col {
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        /* Cards */
        .rc-card {
            background: var(--rc-surface-lowest);
            border-radius: 1rem;
            padding: 1.75rem;
            box-shadow: 0 1px 6px rgba(0,0,0,.06);
        }

        .rc-card-muted {
            background: var(--rc-surface-low);
            border-radius: 1rem;
            padding: 1.75rem;
            border: 1px solid rgba(222,192,178,.25);
        }

            .rc-card h3, .rc-card-muted h3 {
                font-size: 1rem;
                font-weight: 700;
                color: var(--rc-on-surface);
                display: flex;
                align-items: center;
                gap: .5rem;
                margin-bottom: 1.25rem;
            }

                .rc-card h3 .msym,
                .rc-card-muted h3 .msym {
                    color: var(--rc-primary);
                }

        /* Two-col inside card */
        .rc-two-col {
            display: grid;
            grid-template-columns: 1fr;
            gap: 1.25rem;
        }

        @@media (min-width: 576px) {
            .rc-two-col {
                grid-template-columns: 1fr 1fr;
            }
        }

        /* Fields */
        .rc-field {
            margin-bottom: 0;
        }

            .rc-field label {
                display: block;
                font-size: .68rem;
                font-weight: 700;
                letter-spacing: .1em;
                text-transform: uppercase;
                color: var(--rc-on-surface-var);
                margin-bottom: .35rem;
            }

        .rc-input {
            width: 100%;
            background: transparent;
            border: none;
            border-bottom: 2px solid var(--rc-outline-var);
            border-radius: 0;
            padding: .5rem 0;
            font-size: 1.05rem;
            font-weight: 500;
            font-family: 'Manrope', sans-serif;
            color: var(--rc-on-surface);
            transition: border-color .2s;
            outline: none;
            box-shadow: none;
        }

            .rc-input:focus {
                border-bottom-color: var(--rc-primary);
                box-shadow: none;
            }

            .rc-input::placeholder {
                color: #ccc;
            }

        /* Price input */
        .rc-price-wrap {
            position: relative;
        }

            .rc-price-wrap .rc-input {
                font-size: 1.45rem;
                font-weight: 800;
                color: var(--rc-primary);
                padding-right: 3rem;
            }

            .rc-price-wrap .rc-currency {
                position: absolute;
                right: 0;
                bottom: .55rem;
                font-size: .82rem;
                color: var(--rc-on-surface-var);
                font-weight: 500;
            }

        /* Hint */
        .rc-hint {
            display: flex;
            align-items: flex-start;
            gap: .35rem;
            font-size: .75rem;
            color: var(--rc-on-surface-var);
            font-style: italic;
            margin-top: .5rem;
            margin-bottom: 0;
        }

            .rc-hint .msym {
                font-size: 15px;
                flex-shrink: 0;
                margin-top: 1px;
            }

        /* Validation */
        .rc-validation-summary {
            background: #fff0f0;
            border-left: 3px solid #ba1a1a;
            padding: .65rem .9rem;
            border-radius: .5rem;
            font-size: .82rem;
            color: #93000a;
            margin-bottom: 1rem;
        }

        .rc-field-error {
            font-size: .75rem;
            color: #ba1a1a;
            margin-top: .2rem;
            display: block;
        }

        /* Per-floor rows */
        .rc-floor-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: .85rem 1rem;
            background: var(--rc-surface-lowest);
            border-radius: .75rem;
            border-bottom: 2px solid rgba(222,192,178,.3);
            margin-bottom: .65rem;
            transition: box-shadow .2s, transform .15s;
        }

            .rc-floor-row:hover {
                box-shadow: 0 2px 10px rgba(153,66,0,.08);
                transform: translateX(2px);
            }

        .rc-floor-badge {
            width: 2.25rem;
            height: 2.25rem;
            border-radius: 50%;
            background: var(--rc-primary-fixed);
            color: var(--rc-on-primary-fixed);
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: .88rem;
            flex-shrink: 0;
        }

        .rc-floor-label {
            font-weight: 600;
            font-size: .9rem;
            color: var(--rc-on-surface);
            margin-left: .85rem;
        }

        .rc-floor-rooms-wrap {
            display: flex;
            align-items: center;
            gap: .6rem;
        }

            .rc-floor-rooms-wrap span {
                font-size: .8rem;
                color: var(--rc-on-surface-var);
            }

        .rc-floor-input {
            width: 4.25rem;
            text-align: center;
            background: transparent;
            border: none;
            border-bottom: 2px solid var(--rc-outline-var);
            border-radius: 0;
            padding: .2rem;
            font-weight: 700;
            font-size: .95rem;
            font-family: 'Manrope', sans-serif;
            color: var(--rc-on-surface);
            outline: none;
            transition: border-color .2s;
        }

            .rc-floor-input:focus {
                border-bottom-color: var(--rc-primary);
            }

        /* Rule bento box */
        .rc-rule-box {
            background: var(--rc-secondary-fixed);
            border-radius: 1.25rem;
            padding: 1.4rem;
            position: relative;
            overflow: hidden;
        }

            .rc-rule-box::before {
                content: '';
                position: absolute;
                top: -1.5rem;
                right: -1.5rem;
                width: 5.5rem;
                height: 5.5rem;
                background: rgba(153,66,0,.1);
                border-radius: 50%;
                transition: transform .5s;
            }

            .rc-rule-box:hover::before {
                transform: scale(2.2);
            }

            .rc-rule-box h4 {
                font-size: .88rem;
                font-weight: 700;
                color: var(--rc-on-primary-fixed);
                display: flex;
                align-items: center;
                gap: .4rem;
                margin-bottom: .9rem;
            }

        .rc-rule-example {
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: rgba(255,255,255,.45);
            border-radius: .45rem;
            padding: .5rem .75rem;
            font-size: .8rem;
            margin-bottom: .4rem;
            color: var(--rc-on-primary-fixed);
        }

            .rc-rule-example strong {
                color: var(--rc-primary);
            }

        .rc-rule-note {
            font-size: .7rem;
            color: rgba(51,17,0,.6);
            margin-top: .65rem;
            line-height: 1.6;
            margin-bottom: 0;
        }

        /* Buttons */
        .rc-btn-primary {
            width: 100%;
            padding: .9rem;
            background: linear-gradient(135deg, var(--rc-primary), var(--rc-primary-dark));
            color: #fff;
            border: none;
            border-radius: .75rem;
            font-weight: 800;
            font-size: .92rem;
            font-family: 'Manrope', sans-serif;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: .5rem;
            box-shadow: 0 6px 20px rgba(153,66,0,.22);
            transition: box-shadow .2s, transform .15s;
            text-decoration: none;
        }

            .rc-btn-primary:hover {
                box-shadow: 0 10px 28px rgba(153,66,0,.32);
                color: #fff;
            }

            .rc-btn-primary:active {
                transform: scale(.97);
            }

        .rc-btn-secondary {
            width: 100%;
            padding: .9rem;
            background: transparent;
            color: var(--rc-on-surface);
            border: 2px solid var(--rc-outline-var);
            border-radius: .75rem;
            font-weight: 700;
            font-size: .92rem;
            font-family: 'Manrope', sans-serif;
            cursor: pointer;
            transition: background .15s, transform .15s;
            text-decoration: none;
            display: block;
            text-align: center;
        }

            .rc-btn-secondary:hover {
                background: var(--rc-surface-low);
                color: var(--rc-on-surface);
            }

            .rc-btn-secondary:active {
                transform: scale(.97);
            }

        /* Support card */
        .rc-support-card {
            padding: 1.25rem;
            border-radius: 1rem;
            background: var(--rc-surface-low);
            border: 2px dashed var(--rc-outline-var);
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
            gap: .6rem;
        }

        .rc-support-icon {
            width: 2.75rem;
            height: 2.75rem;
            border-radius: 50%;
            background: var(--rc-tertiary-fixed);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--rc-tertiary);
        }

        .rc-support-card p {
            margin: 0;
        }

        .rc-support-card .title {
            font-weight: 700;
            font-size: .85rem;
            color: var(--rc-on-surface);
        }

        .rc-support-card .sub {
            font-size: .73rem;
            color: var(--rc-on-surface-var);
            line-height: 1.5;
        }
    </style>
}

<div class="rc-page py-4 py-lg-5">
    <div class="container-lg">

        @* Breadcrumb *@
        <nav class="rc-breadcrumb" aria-label="Breadcrumb">
            <a asp-action="Index">Nhà trọ của tôi</a>
            <span class="msym">chevron_right</span>
            <a href="#">@Model.PropertyName</a>
            <span class="msym">chevron_right</span>
            <strong>Tạo phòng</strong>
        </nav>

        @* Page heading *@
        <div class="rc-page-header">
            <h1>Tạo phòng trọ</h1>
            <p>Hệ thống sẽ tự động tạo danh sách phòng dựa trên cấu trúc tòa nhà của bạn.</p>
        </div>

        @* Two-column layout *@
        <div class="rc-layout">

            @* ── Main column ── *@
            <div class="rc-main-col">
                <form asp-action="ConfigureRooms" method="post" id="roomConfigForm">
                    <input type="hidden" asp-for="PropertyId" />
                    <input type="hidden" asp-for="PropertyName" />

                    <div asp-validation-summary="ModelOnly" class="rc-validation-summary"></div>

                    @* Card 1: Building structure *@
                    <div class="rc-card">
                        <h3>
                            <span class="msym">layers</span>
                            Cấu trúc tòa nhà
                        </h3>
                        <div class="rc-two-col">
                            <div class="rc-field">
                                <label asp-for="NumberOfFloors"></label>
                                <input asp-for="NumberOfFloors"
                                       class="rc-input"
                                       type="number" min="1" max="50"
                                       id="numberOfFloors"
                                       placeholder="Ví dụ: 5" />
                                <span asp-validation-for="NumberOfFloors" class="rc-field-error"></span>
                            </div>
                            <div class="rc-field">
                                <label>Số phòng mặc định mỗi tầng</label>
                                <input type="number"
                                       class="rc-input"
                                       id="defaultRoomsPerFloor"
                                       min="1" max="50"
                                       value="5"
                                       placeholder="Ví dụ: 10" />
                            </div>
                        </div>
                    </div>

                    @* Card 2: Per-floor detail *@
                    <div class="rc-card-muted">
                        <h3>
                            <span class="msym">rule</span>
                            Cấu hình chi tiết từng tầng
                        </h3>
                        <div id="floorsContainer"></div>
                    </div>

                    @* Card 3: Pricing *@
                    <div class="rc-card">
                        <div class="rc-field">
                            <label asp-for="DefaultRentPrice"></label>
                            <div class="rc-price-wrap">
                                <input asp-for="DefaultRentPrice"
                                       class="rc-input"
                                       type="number" step="100000"
                                       placeholder="0" />
                                <span class="rc-currency">VNĐ</span>
                            </div>
                            <span asp-validation-for="DefaultRentPrice" class="rc-field-error"></span>
                            <p class="rc-hint">
                                <span class="msym">info</span>
                                Giá này sẽ được áp dụng cho tất cả phòng. Bạn có thể chỉnh sửa riêng cho từng phòng sau.
                            </p>
                        </div>
                    </div>

                </form>
            </div>

            @* ── Sidebar column ── *@
            <div class="rc-side-col">

                @* Numbering rule box *@
                <div class="rc-rule-box">
                    <h4>
                        <span class="msym" style="font-size:18px;">auto_awesome</span>
                        Quy tắc đánh số
                    </h4>
                    <div class="rc-rule-example">
                        <span>Tầng 3, phòng 2</span>
                        <strong>→ 302</strong>
                    </div>
                    <div class="rc-rule-example">
                        <span>Tầng 2, phòng 1</span>
                        <strong>→ 201</strong>
                    </div>
                    <p class="rc-rule-note">
                        Hệ thống tự động dùng định dạng <strong>[Tầng][Phòng]</strong> để tối ưu hóa việc quản lý.
                    </p>
                </div>

                @* Action buttons *@
                <button type="submit" form="roomConfigForm" class="rc-btn-primary">
                    <span class="msym">add_business</span>
                    Tạo phòng
                </button>

                <a asp-action="Index" class="rc-btn-secondary">Hủy</a>

                @* Support card *@
                <div class="rc-support-card">
                    <div class="rc-support-icon">
                        <span class="msym">help_center</span>
                    </div>
                    <div>
                        <p class="title">Cần hỗ trợ?</p>
                        <p class="sub">Liên hệ với kiến trúc sư hệ thống nếu bạn có yêu cầu đặc biệt.</p>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const floorsInput  = document.getElementById('numberOfFloors');
            const defaultRooms = document.getElementById('defaultRoomsPerFloor');
            const container    = document.getElementById('floorsContainer');

            function generateFloorInputs() {
                const floors = parseInt(floorsInput.value) || 1;
                const def    = parseInt(defaultRooms.value) || 5;
                container.innerHTML = '';

                for (let i = 0; i < floors; i++) {
                    const row = document.createElement('div');
                    row.className = 'rc-floor-row';
                    row.innerHTML = `
                        <div style="display:flex;align-items:center;">
                            <div class="rc-floor-badge">${i + 1}</div>
                            <span class="rc-floor-label">Tầng ${i + 1}</span>
                        </div>
                        <div class="rc-floor-rooms-wrap">
                            <span>Số phòng:</span>
                            <input type="number"
                                   name="RoomsPerFloor[${i}]"
                                   class="rc-floor-input"
                                   min="1" max="50"
                                   value="${def}"
                                   required />
                        </div>`;
                    container.appendChild(row);
                }
            }

            floorsInput.addEventListener('input',  generateFloorInputs);
            floorsInput.addEventListener('change', generateFloorInputs);
            defaultRooms.addEventListener('input', generateFloorInputs);

            generateFloorInputs();
        });
    </script>
}
