@model Motel.ViewModels.Property.PropertyCreateViewModel

@{
    ViewData["Title"] = "Tạo nhà trọ mới";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">
                        <i class="bi bi-building"></i> Tạo nhà trọ mới
                    </h4>
                </div>
                <div class="card-body">
                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <h5 class="border-bottom pb-2 mb-3">Thông tin cơ bản</h5>
                        
                        <div class="mb-3">
                            <label asp-for="Name" class="form-label"></label>
                            <input asp-for="Name" class="form-control" placeholder="Ví dụ: Nhà trọ ABC" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Address" class="form-label"></label>
                            <input asp-for="Address" class="form-control" placeholder="Ví dụ: 123 Nguyễn Văn A, Quận 1, TP.HCM" />
                            <span asp-validation-for="Address" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label"></label>
                            <textarea asp-for="Description" class="form-control" rows="3" placeholder="Mô tả về nhà trọ (tùy chọn)"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <h5 class="border-bottom pb-2 mb-3 mt-4">Cấu hình tiện ích mặc định</h5>
                        <p class="text-muted small">
                            <i class="bi bi-info-circle"></i>
                            Các giá trị này sẽ được áp dụng cho tất cả phòng khi tạo. Bạn có thể chỉnh sửa riêng cho từng phòng sau.
                        </p>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="ElectricUnitPrice" class="form-label"></label>
                                <div class="input-group">
                                    <input asp-for="ElectricUnitPrice" class="form-control" type="number" step="100" />
                                    <span class="input-group-text">VNĐ/số</span>
                                </div>
                                <span asp-validation-for="ElectricUnitPrice" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="WaterUnitPrice" class="form-label"></label>
                                <div class="input-group">
                                    <input asp-for="WaterUnitPrice" class="form-control" type="number" step="100" />
                                    <span class="input-group-text">VNĐ</span>
                                </div>
                                <span asp-validation-for="WaterUnitPrice" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="WaterChargeType" class="form-label"></label>
                            <select asp-for="WaterChargeType" class="form-select" asp-items="Html.GetEnumSelectList<Motel.ViewModels.Property.WaterChargeType>()">
                            </select>
                            <small class="form-text text-muted">
                                Chọn "Theo số nước" nếu tính theo đồng hồ nước, hoặc "Theo đầu người" nếu tính theo số người ở.
                            </small>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="InternetFee" class="form-label"></label>
                                <div class="input-group">
                                    <input asp-for="InternetFee" class="form-control" type="number" step="1000" />
                                    <span class="input-group-text">VNĐ/tháng</span>
                                </div>
                                <span asp-validation-for="InternetFee" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="TrashFee" class="form-label"></label>
                                <div class="input-group">
                                    <input asp-for="TrashFee" class="form-control" type="number" step="1000" />
                                    <span class="input-group-text">VNĐ/tháng</span>
                                </div>
                                <span asp-validation-for="TrashFee" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-4">
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-x-circle"></i> Hủy
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-circle"></i> Tạo nhà trọ
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
}
