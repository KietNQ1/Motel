@model Motel.ViewModels.Property.PropertyCreateViewModel

@{
    ViewData["Title"] = "Tạo nhà trọ mới";
}

<div class="settings-page">

    <!-- Breadcrumb -->
    <nav class="settings-breadcrumb" aria-label="breadcrumb">
        <ol>
            <li><a asp-action="Index">Nhà trọ của tôi</a></li>
            <li><span>›</span></li>
            <li class="active">Tạo nhà trọ mới</li>
        </ol>
    </nav>

    <a asp-action="Index" class="back-link">
        <i class="bi bi-arrow-left"></i> Quay lại
    </a>

    <h1 class="settings-title">Tạo nhà trọ mới</h1>

    <form asp-action="Create" method="post" id="createForm">
        <div asp-validation-summary="ModelOnly" class="alert-toast error" style="display:@(ViewData.ModelState.IsValid ? "none" : "flex")"></div>

        <!-- Card: Thông tin cơ bản -->
        <div class="settings-card">
            <div class="settings-section-title">
                <i class="bi bi-info-circle-fill text-primary"></i> Thông tin cơ bản
            </div>

            <div class="row-fields">
                <div class="field-group">
                    <label asp-for="Name">Tên nhà trọ <span class="required">*</span></label>
                    <input asp-for="Name" type="text" placeholder="Ví dụ: Nhà trọ Bình Minh" />
                    <span asp-validation-for="Name" class="field-error"></span>
                </div>
                <div class="field-group">
                    <label asp-for="Address">Địa chỉ <span class="required">*</span></label>
                    <input asp-for="Address" type="text" placeholder="123 Đường ABC, Phường 4, Quận 5, TP.HCM" />
                    <span asp-validation-for="Address" class="field-error"></span>
                </div>
            </div>

            <div class="field-group mt-3">
                <label asp-for="Description">Mô tả thêm</label>
                <textarea asp-for="Description" rows="3" placeholder="Thông tin giới thiệu về nhà trọ..."></textarea>
            </div>
        </div>

        <!-- Card: Phụ phí mặc định -->
        <div class="settings-card mt-4">
            <div class="fee-card-header">
                <div>
                    <div class="settings-section-title">
                        <i class="bi bi-cash-coin text-warning"></i> Phụ phí mặc định
                    </div>
                    <p class="fee-subtitle">Điện và nước được cài sẵn. Bạn có thể thêm các loại phí khác (vệ sinh, internet...) sau khi tạo xong.</p>
                </div>
                <button type="button" class="btn-orange-outline" id="addFeeBtn">
                    <i class="bi bi-plus-circle"></i> Thêm phí khác
                </button>
            </div>

            <div id="feeSettingsContainer">
                @for (int i = 0; i < Model.FeeSettings.Count; i++)
                {
                    var fee = Model.FeeSettings[i];
                    bool isMeter = fee.CalculationMethod == "meter";
                    <div class="fee-row" data-index="@i">
                        <input type="hidden" name="FeeSettings[@i].FeeTypeId" value="@fee.FeeTypeId" />
                        <input type="hidden" name="FeeSettings[@i].FeeTypeName" value="@fee.FeeTypeName" />
                        <input type="hidden" name="FeeSettings[@i].IsSelected" value="true" />

                        <div class="fee-row-name">
                            <i class="bi bi-lightning-charge-fill" style="color:#f59e0b;"></i>
                            <strong>@fee.FeeTypeName</strong>
                            <span class="fee-badge">Bắt buộc</span>
                        </div>
                        <div class="fee-row-inputs">
                            <div class="field-group">
                                <label>Cách tính</label>
                                <select name="FeeSettings[@i].CalculationMethod" class="form-select calc-method-select">
                                    <option value="meter" selected="@(fee.CalculationMethod == "meter")">Theo chỉ số đồng hồ</option>
                                    <option value="per_person" selected="@(fee.CalculationMethod == "per_person")">Theo đầu người</option>
                                    <option value="per_room" selected="@(fee.CalculationMethod == "per_room")">Theo phòng</option>
                                </select>
                            </div>
                            <div class="field-group unit-price-container" style="@(isMeter ? "" : "display:none;")">
                                <label>Đơn giá (VNĐ / đơn vị)</label>
                                <input name="FeeSettings[@i].UnitPrice" type="number" step="100" value="@fee.UnitPrice" class="form-control" />
                            </div>
                            <div class="field-group base-amount-container" style="@(isMeter ? "display:none;" : "")">
                                <label>Mức phí (VNĐ)</label>
                                <input name="FeeSettings[@i].BaseAmount" type="number" step="1000" value="@fee.BaseAmount" class="form-control" />
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Custom fee rows added dynamically -->
            <div id="customFeeContainer"></div>
        </div>

        <div class="form-action-right mt-4" style="gap:12px;">
            <a asp-action="Index" class="btn-cancel">
                <i class="bi bi-x-circle"></i> Hủy
            </a>
            <button type="submit" class="btn-orange">
                <i class="bi bi-building-add"></i> Tạo nhà trọ
            </button>
        </div>
    </form>
</div>

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <style>
        body { background: #f5f5f5; }

        .settings-page {
            max-width: 880px;
            margin: 0 auto;
            padding: 28px 20px 60px;
            font-family: 'Inter', 'Segoe UI', system-ui, sans-serif;
        }

        /* Breadcrumb */
        .settings-breadcrumb ol {
            display: flex;
            align-items: center;
            gap: 6px;
            list-style: none;
            margin: 0 0 12px;
            padding: 0;
            font-size: 0.85rem;
            color: #888;
        }
        .settings-breadcrumb a { color: #888; text-decoration: none; }
        .settings-breadcrumb a:hover { color: #f97316; }
        .settings-breadcrumb .active { color: #f97316; font-weight: 500; }

        .back-link {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            font-size: 0.9rem;
            color: #555;
            text-decoration: none;
            margin-bottom: 10px;
        }
        .back-link:hover { color: #f97316; }

        .settings-title {
            font-size: 1.75rem;
            font-weight: 700;
            color: #111;
            margin: 0 0 24px;
        }

        .settings-card {
            background: #fff;
            border-radius: 12px;
            padding: 28px 32px;
            box-shadow: 0 1px 4px rgba(0,0,0,.08);
        }

        .settings-section-title {
            font-size: 1.05rem;
            font-weight: 600;
            color: #111;
            margin-bottom: 20px;
        }
        .settings-section-title i { margin-right: 8px; }

        .row-fields {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
        }
        @@media (max-width: 600px) { .row-fields { grid-template-columns: 1fr; } }

        .field-group { display: flex; flex-direction: column; gap: 6px; }
        .field-group label { font-size: 0.84rem; color: #444; font-weight: 500; }
        .field-group input, .field-group textarea, .field-group select {
            border: 1px solid #ddd;
            border-radius: 8px;
            padding: 10px 14px;
            font-size: 0.92rem;
            outline: none;
            color: #222;
            background: #fff;
            transition: border-color .2s;
            box-sizing: border-box;
        }
        .field-group input:focus, .field-group textarea:focus, .field-group select:focus {
            border-color: #f97316;
            box-shadow: 0 0 0 3px rgba(249, 115, 22, .12);
        }
        .required { color: #ef4444; }
        .field-error { color: #ef4444; font-size: 0.78rem; }
        .mt-3 { margin-top: 16px; }
        .mt-4 { margin-top: 24px; }
        .form-action-right {
            display: flex;
            justify-content: flex-end;
        }

        /* Fee card header */
        .fee-card-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 20px;
        }
        .fee-card-header .settings-section-title { margin-bottom: 4px; }
        .fee-subtitle { font-size: 0.82rem; color: #777; margin: 0; }

        /* Fee row */
        .fee-row {
            border: 1px solid #eee;
            border-radius: 10px;
            padding: 16px 18px;
            margin-bottom: 12px;
            background: #fafafa;
        }
        .fee-row-name {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 14px;
            font-size: 0.95rem;
        }
        .fee-badge {
            background: #fff4ed;
            color: #f97316;
            border: 1px solid #f97316;
            border-radius: 20px;
            padding: 1px 8px;
            font-size: 0.72rem;
            font-weight: 600;
        }
        .fee-badge.custom {
            background: #eff6ff;
            color: #3b82f6;
            border-color: #93c5fd;
        }
        .fee-row-inputs {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            gap: 16px;
        }
        @@media (max-width: 600px) { .fee-row-inputs { grid-template-columns: 1fr; } }

        .fee-row-remove {
            background: transparent;
            border: 1.5px solid #e5e7eb;
            border-radius: 8px;
            color: #9ca3af;
            cursor: pointer;
            width: 34px;
            height: 34px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all .17s;
            align-self: flex-end;
        }
        .fee-row-remove:hover { color: #ef4444; border-color: #fecaca; background: #fff5f5; }

        /* Custom fee row */
        .fee-row.custom-fee { background: #f0f7ff; border-color: #bfdbfe; }
        .custom-fee-name-input {
            flex: 1;
            border: 1px solid #93c5fd;
            border-radius: 8px;
            padding: 6px 12px;
            font-size: 0.88rem;
            font-weight: 500;
            color: #1e40af;
            background: #fff;
            outline: none;
        }
        .custom-fee-name-input:focus { border-color: #3b82f6; box-shadow: 0 0 0 2px rgba(59,130,246,.15); }

        /* Buttons */
        .btn-orange {
            background: #f97316;
            color: #fff;
            border: none;
            border-radius: 8px;
            padding: 10px 24px;
            font-size: 0.9rem;
            font-weight: 600;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 7px;
            transition: background .2s;
        }
        .btn-orange:hover { background: #ea6c0a; color: #fff; }

        .btn-orange-outline {
            background: #fff4ed;
            color: #f97316;
            border: 1.5px solid #f97316;
            border-radius: 8px;
            padding: 8px 16px;
            font-size: 0.88rem;
            font-weight: 600;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            white-space: nowrap;
            transition: background .2s;
        }
        .btn-orange-outline:hover { background: #f97316; color: #fff; }

        .btn-cancel {
            background: #f3f4f6;
            color: #374151;
            border: 1px solid #d1d5db;
            border-radius: 8px;
            padding: 10px 20px;
            font-size: 0.9rem;
            font-weight: 500;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 7px;
            text-decoration: none;
            transition: background .2s;
        }
        .btn-cancel:hover { background: #e5e7eb; color: #111; }

        .alert-toast {
            display: flex; align-items: center; gap: 8px;
            padding: 12px 18px; border-radius: 10px;
            font-size: 0.9rem; margin-bottom: 16px;
        }
        .alert-toast.error { background: #fff5f5; color: #dc2626; border: 1px solid #fecaca; }

        .text-primary { color: #3b82f6 !important; }
        .text-warning { color: #f59e0b !important; }
        .form-select, .form-control { width: 100%; }
    </style>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        let customFeeIndex = @Model.FeeSettings.Count;

        function toggleFeeInputs(container) {
            const select = container.querySelector('.calc-method-select');
            if (!select) return;
            const method = select.value;
            const unitDiv = container.querySelector('.unit-price-container');
            const baseDiv = container.querySelector('.base-amount-container');
            if (!unitDiv || !baseDiv) return;

            if (method === 'meter') {
                unitDiv.style.display = '';
                baseDiv.style.display = 'none';
            } else {
                unitDiv.style.display = 'none';
                baseDiv.style.display = '';
            }
        }

        document.addEventListener('DOMContentLoaded', function () {
            // Initialize existing fee rows
            document.querySelectorAll('.fee-row').forEach(row => toggleFeeInputs(row));

            // On calc method change
            document.getElementById('feeSettingsContainer').addEventListener('change', function (e) {
                if (e.target.classList.contains('calc-method-select')) {
                    toggleFeeInputs(e.target.closest('.fee-row'));
                }
            });
            document.getElementById('customFeeContainer').addEventListener('change', function (e) {
                if (e.target.classList.contains('calc-method-select')) {
                    toggleFeeInputs(e.target.closest('.fee-row'));
                }
            });

            // Add custom fee
            document.getElementById('addFeeBtn').addEventListener('click', function () {
                const idx = customFeeIndex++;
                const html = `
                    <div class="fee-row custom-fee" data-index="${idx}">
                        <input type="hidden" name="FeeSettings[${idx}].FeeTypeId" value="0" />
                        <input type="hidden" name="FeeSettings[${idx}].IsSelected" value="true" />
                        <div class="fee-row-name">
                            <i class="bi bi-tag-fill" style="color:#3b82f6;"></i>
                            <input class="custom-fee-name-input" type="text"
                                   name="FeeSettings[${idx}].FeeTypeName"
                                   placeholder="Tên phí (VD: Phí gửi xe, Phí vệ sinh...)" required />
                            <span class="fee-badge custom">Tùy chỉnh</span>
                            <button type="button" class="fee-row-remove ms-auto" onclick="this.closest('.fee-row').remove()">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>
                        <div class="fee-row-inputs">
                            <div class="field-group">
                                <label>Cách tính</label>
                                <select name="FeeSettings[${idx}].CalculationMethod" class="form-select calc-method-select">
                                    <option value="per_room" selected>Theo phòng</option>
                                    <option value="per_person">Theo đầu người</option>
                                    <option value="meter">Theo chỉ số đồng hồ</option>
                                </select>
                            </div>
                            <div class="field-group unit-price-container" style="display:none;">
                                <label>Đơn giá (VNĐ / đơn vị)</label>
                                <input name="FeeSettings[${idx}].UnitPrice" type="number" step="100" value="0" class="form-control" />
                            </div>
                            <div class="field-group base-amount-container">
                                <label>Mức phí (VNĐ)</label>
                                <input name="FeeSettings[${idx}].BaseAmount" type="number" step="1000" value="0" class="form-control" />
                            </div>
                        </div>
                    </div>`;
                document.getElementById('customFeeContainer').insertAdjacentHTML('beforeend', html);
            });
        });
    </script>
}
