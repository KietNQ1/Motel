@model Motel.ViewModels.Property.PropertyDetailsViewModel

@{
    ViewData["Title"] = Model.Name;
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-md-8">
            <h2 class="mb-0">
                <i class="bi bi-building"></i> @Model.Name
            </h2>
            <p class="text-muted mb-0">
                <i class="bi bi-geo-alt"></i> @Model.Address
            </p>
            @if (!string.IsNullOrEmpty(Model.Description))
            {
                <p class="mt-2">@Model.Description</p>
            }
        </div>
            <a asp-action="Settings" asp-route-id="@Model.PropertyId" class="btn btn-outline-success mb-2 mb-md-0 me-md-2">
                <i class="bi bi-gear"></i> Cấu hình
            </a>
            <a asp-controller="Tenant" asp-action="Index" asp-route-propertyId="@Model.PropertyId" class="btn btn-outline-primary mb-2 mb-md-0 me-md-2">
                <i class="bi bi-people"></i> Người thuê
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Quay lại
            </a>
        </div>
    </div>

    @if (!Model.RoomsByFloor.Any())
    {
        <div class="alert alert-warning">
            <i class="bi bi-exclamation-triangle"></i>
            Nhà trọ này chưa có phòng nào. <a asp-action="ConfigureRooms" asp-route-id="@Model.PropertyId" class="alert-link">Cấu hình phòng ngay</a>
        </div>
    }
    else
    {
        @foreach (var floor in Model.RoomsByFloor.OrderByDescending(f => f.Key))
        {
            <div class="card mb-4 shadow-sm">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        <i class="bi bi-layers"></i> Tầng @floor.Key
                        <span class="badge bg-light text-dark ms-2">@floor.Value.Count phòng</span>
                    </h5>
                    <a asp-controller="Room" asp-action="CreateSingleRoom" asp-route-propertyId="@Model.PropertyId" asp-route-floor="@floor.Key" class="btn btn-sm bg-white text-dark shadow-sm fw-bold border" style="color: #ea580c !important;">
                        <i class="bi bi-plus-lg"></i> Thêm phòng
                    </a>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        @foreach (var room in floor.Value)
                        {
                            var isDeleted = room.IsDeleted;

                            var statusClass = isDeleted ? "border-secondary" : room.Status switch
                            {
                                "occupied" => "border-success",
                                "available" => "border-info",
                                "maintenance" => "border-warning",
                                _ => "border-secondary"
                            };

                            var statusBadge = isDeleted ? "bg-secondary" : room.Status switch
                            {
                                "occupied" => "bg-success",
                                "available" => "bg-info",
                                "maintenance" => "bg-warning",
                                _ => "bg-secondary"
                            };

                            var statusText = isDeleted ? "Ngừng sử dụng" : room.Status switch
                            {
                                "occupied" => "Đã thuê",
                                "available" => "Còn trống",
                                "maintenance" => "Bảo trì",
                                _ => room.Status
                            };

                            var opacityStyle = isDeleted ? "opacity: 0.6;" : "";

                            <div class="col-md-3 col-sm-6">
                                <div class="card h-100 @statusClass" style="border-width: 2px; @opacityStyle">
                                    <div class="card-body text-center">
                                        <h5 class="card-title">
                                            <i class="bi bi-door-closed"></i> @room.RoomName
                                        </h5>

                                        <span class="badge @statusBadge mb-2">@statusText</span>

                                        <p class="card-text mb-1">
                                            <strong>@room.RentPrice.ToString("N0") VNĐ</strong>/tháng
                                        </p>

                                        @if (isDeleted)
                                        {
                                            <small class="text-danger d-block mt-2">Đã xóa mềm</small>
                                        }
                                        else if (room.HasTenant)
                                        {
                                            <small class="text-muted d-block">
                                                <i class="bi bi-person"></i> @room.TenantName
                                            </small>
                                        }
                                        else
                                        {
                                            <small class="text-muted d-block">
                                                <i class="bi bi-people"></i> Tối đa @room.MaxOccupants người
                                            </small>
                                        }

                                        <!-- ✅ Buttons: Contract + Occupants -->
                                        @if (!isDeleted && room.HasTenant && room.ActiveContractId != null)
                                        {
                                            <div class="d-flex justify-content-center gap-2 mt-2">
                                                <a class="btn btn-sm btn-outline-primary"
                                                   asp-controller="Contract" asp-action="Details" asp-route-id="@room.ActiveContractId">
                                                    Hợp đồng
                                                </a>

                                                <a class="btn btn-sm btn-outline-secondary"
                                                   asp-controller="Room" asp-action="Details" asp-route-id="@room.RoomId">
                                                    Người ở: @room.OccupantsCount
                                                </a>
                                            </div>
                                        }   
                                    </div>

                                    <!-- ✅ Action Buttons on Footer -->
                                    <div class="card-footer bg-white text-center">
                                        @if (isDeleted)
                                        {
                                            <form asp-controller="Room" asp-action="Restore" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn khôi phục phòng này?');">
                                                <input type="hidden" name="id" value="@room.RoomId" />
                                                <input type="hidden" name="propertyId" value="@Model.PropertyId" />
                                                <button type="submit" class="btn btn-sm btn-outline-success w-100">
                                                    <i class="bi bi-arrow-counterclockwise"></i> Khôi phục
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <a class="btn btn-sm btn-outline-dark w-100"
                                               asp-controller="Room" asp-action="Details" asp-route-id="@room.RoomId">
                                                Xem chi tiết phòng
                                            </a>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

        <div class="row mt-4">
            <div class="col-12">
                <div class="card">
                    <div class="card-body">
                        <h6 class="card-title">Chú thích trạng thái phòng:</h6>
                        <div class="d-flex gap-3 flex-wrap">
                            <span><span class="badge bg-info">Còn trống</span> - Phòng chưa có người thuê</span>
                            <span><span class="badge bg-success">Đã thuê</span> - Phòng đang có người thuê</span>
                            <span><span class="badge bg-warning">Bảo trì</span> - Phòng đang bảo trì</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <style>
        .card:hover {
            transform: translateY(-2px);
            transition: transform 0.2s;
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        }
    </style>
}

@section Scripts {
    <!-- Thêm Bootstrap JS để Dropdowns hoạt động -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
}
