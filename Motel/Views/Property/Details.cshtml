@model Motel.ViewModels.Property.PropertyDetailsViewModel

@{
    ViewData["Title"] = Model.Name;
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-md-8">
            <h2 class="mb-0">
                <i class="bi bi-building"></i> @Model.Name
            </h2>
            <p class="text-muted mb-0">
                <i class="bi bi-geo-alt"></i> @Model.Address
            </p>
            @if (!string.IsNullOrEmpty(Model.Description))
            {
                <p class="mt-2">@Model.Description</p>
            }
        </div>
        <div class="col-md-4 text-end">
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Quay lại
            </a>
        </div>
    </div>

    @if (!Model.RoomsByFloor.Any())
    {
        <div class="alert alert-warning">
            <i class="bi bi-exclamation-triangle"></i>
            Nhà trọ này chưa có phòng nào. <a asp-action="ConfigureRooms" asp-route-id="@Model.PropertyId" class="alert-link">Cấu hình phòng ngay</a>
        </div>
    }
    else
    {
        @foreach (var floor in Model.RoomsByFloor.OrderByDescending(f => f.Key))
        {
            <div class="card mb-4 shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-layers"></i> Tầng @floor.Key
                        <span class="badge bg-light text-dark ms-2">@floor.Value.Count phòng</span>
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        @foreach (var room in floor.Value)
                        {
                            var statusClass = room.Status switch
                            {
                                "occupied" => "border-success",
                                "available" => "border-info",
                                "maintenance" => "border-warning",
                                _ => "border-secondary"
                            };

                            var statusBadge = room.Status switch
                            {
                                "occupied" => "bg-success",
                                "available" => "bg-info",
                                "maintenance" => "bg-warning",
                                _ => "bg-secondary"
                            };

                            var statusText = room.Status switch
                            {
                                "occupied" => "Đã thuê",
                                "available" => "Còn trống",
                                "maintenance" => "Bảo trì",
                                _ => room.Status
                            };

                            <div class="col-md-3 col-sm-6">
                                <a href="@Url.Action("Details", "Room", new { id = room.RoomId })" class="text-decoration-none">
                                    <div class="card h-100 @statusClass" style="border-width: 2px;">
                                        <div class="card-body text-center">
                                            <h5 class="card-title">
                                                <i class="bi bi-door-closed"></i> @room.RoomName
                                            </h5>
                                            <span class="badge @statusBadge mb-2">@statusText</span>
                                            <p class="card-text mb-1">
                                                <strong>@room.RentPrice.ToString("N0") VNĐ</strong>/tháng
                                            </p>
                                            @if (room.HasTenant)
                                            {
                                                <small class="text-muted">
                                                    <i class="bi bi-person"></i> @room.TenantName
                                                </small>
                                            }
                                            else
                                            {
                                                <small class="text-muted">
                                                    <i class="bi bi-people"></i> Tối đa @room.MaxOccupants người
                                                </small>
                                            }
                                        </div>
                                    </div>
                                </a>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

        <div class="row mt-4">
            <div class="col-12">
                <div class="card">
                    <div class="card-body">
                        <h6 class="card-title">Chú thích trạng thái phòng:</h6>
                        <div class="d-flex gap-3 flex-wrap">
                            <span><span class="badge bg-info">Còn trống</span> - Phòng chưa có người thuê</span>
                            <span><span class="badge bg-success">Đã thuê</span> - Phòng đang có người thuê</span>
                            <span><span class="badge bg-warning">Bảo trì</span> - Phòng đang bảo trì</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <style>
        .card:hover {
            transform: translateY(-2px);
            transition: transform 0.2s;
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        }
    </style>
}
