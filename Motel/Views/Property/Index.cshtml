@model List<Motel.ViewModels.Property.PropertyListViewModel>

@{
    ViewData["Title"] = "Danh sách nhà trọ";
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-md-6">
            <h2 class="mb-0">
                <i class="bi bi-building"></i> Danh sách nhà trọ
            </h2>
        </div>
        <div class="col-md-6 text-end">
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Tạo nhà trọ mới
            </a>
        </div>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i>
            Bạn chưa có nhà trọ nào. <a asp-action="Create" class="alert-link">Tạo nhà trọ đầu tiên</a>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var property in Model)
            {
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body">
                            <h5 class="card-title">
                                <i class="bi bi-building text-primary"></i>
                                @property.Name
                            </h5>
                            <p class="card-text text-muted">
                                <i class="bi bi-geo-alt"></i> @property.Address
                            </p>
                            
                            <div class="row text-center mb-3">
                                <div class="col-4">
                                    <div class="border rounded p-2">
                                        <h6 class="mb-0 text-primary">@property.TotalRooms</h6>
                                        <small class="text-muted">Tổng phòng</small>
                                    </div>
                                </div>
                                <div class="col-4">
                                    <div class="border rounded p-2">
                                        <h6 class="mb-0 text-success">@property.OccupiedRooms</h6>
                                        <small class="text-muted">Đã thuê</small>
                                    </div>
                                </div>
                                <div class="col-4">
                                    <div class="border rounded p-2">
                                        <h6 class="mb-0 text-info">@property.AvailableRooms</h6>
                                        <small class="text-muted">Còn trống</small>
                                    </div>
                                </div>
                            </div>

                            <small class="text-muted">
                                <i class="bi bi-calendar"></i>
                                Tạo: @property.CreatedAt.ToString("dd/MM/yyyy")
                            </small>
                        </div>
                        <div class="card-footer bg-white">
                            @if (property.HasRooms)
                            {
                                <a asp-action="Details" asp-route-id="@property.PropertyId" class="btn btn-sm btn-outline-primary w-100">
                                    <i class="bi bi-eye"></i> Xem chi tiết
                                </a>
                            }
                            else
                            {
                                <a asp-action="ConfigureRooms" asp-route-id="@property.PropertyId" class="btn btn-sm btn-warning w-100">
                                    <i class="bi bi-gear"></i> Cấu hình phòng
                                </a>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
}
