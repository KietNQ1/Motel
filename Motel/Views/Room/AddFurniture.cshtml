@model Motel.ViewModels.Room.AddFurnitureViewModel

@{
    ViewData["Title"] = "Thêm nội thất";
}

<div class="container py-4">

    <h3 class="mb-4">
        <i class="bi bi-plus-circle"></i> Thêm nội thất cho phòng
    </h3>

    <form asp-action="AddFurniture" method="post" enctype="multipart/form-data">

        <input asp-for="RoomId" type="hidden" />

        <div class="mb-3">
            <label asp-for="Name" class="form-label">Tên nội thất</label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Quantity" class="form-label">Số lượng</label>
            <input asp-for="Quantity" class="form-control" />
            <span asp-validation-for="Quantity" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label">Mô tả</label>
            <textarea asp-for="Description" class="form-control"></textarea>
        </div>

        <div class="mb-3">
            <label class="form-label">Hình ảnh nội thất</label>
            <input type="file"
                   name="Images"
                   multiple
                   class="form-control" />
        </div>

        <button type="submit" class="btn btn-primary">
            <i class="bi bi-save"></i> Lưu
        </button>

        <a asp-action="Details"
           asp-route-id="@Model.RoomId"
           class="btn btn-secondary">
            Quay lại
        </a>

    </form>

</div>

@section Scripts{
    <partial name="_ValidationScriptsPartial"/>
}