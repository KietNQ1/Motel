@model Motel.ViewModels.Room.RoomCreateViewModel
@{
    ViewData["Title"] = "Thêm phòng mới";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white text-center">
                    <h4 class="mb-0">Thêm phòng mới - Tầng @Model.Floor</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-controller="Room" asp-action="CreateSingleRoom" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="PropertyId" />
                        <input type="hidden" asp-for="Floor" />

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="RoomName" class="form-label fw-bold">Tên phòng mới</label>
                            <input asp-for="RoomName" class="form-control" placeholder="Ví dụ: @ViewBag.SuggestedRoomName hoặc VIP 1" />
                            <span asp-validation-for="RoomName" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="RentPrice" class="form-label fw-bold">Giá thuê (VNĐ/tháng)</label>
                            <input asp-for="RentPrice" class="form-control" type="number" min="0" step="10000" />
                            <span asp-validation-for="RentPrice" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="MaxOccupants" class="form-label fw-bold">Số người ở tối đa</label>
                            <input asp-for="MaxOccupants" class="form-control" type="number" min="1" />
                            <span asp-validation-for="MaxOccupants" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Images" class="form-label fw-bold">Hình ảnh phòng</label>
                            <span class="text-muted small d-block mb-1">(Phòng ngủ, nhà vệ sinh, nhà bếp, ban công...)</span>
                            <input asp-for="Images" type="file" class="form-control" multiple accept="image/*" />
                            <span asp-validation-for="Images" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-controller="Property" asp-action="Details" asp-route-id="@Model.PropertyId" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left"></i> Quay lại
                            </a>
                            <button type="submit" class="btn btn-primary fw-bold">
                                <i class="bi bi-check-circle"></i> Xác nhận thêm
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
