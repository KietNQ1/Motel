@model Motel.ViewModels.Room.RoomDetailViewModel

@{
    ViewData["Title"] = $"Phòng {Model.RoomName}";

    var effectiveFees = ViewBag.EffectiveFees as List<Motel.Models.FeeSetting> ?? new List<Motel.Models.FeeSetting>();
    var roomFeeTypeIds = ViewBag.RoomFeeTypeIds as HashSet<int> ?? new HashSet<int>();
    int occupantCount = (int)(ViewBag.OccupantCount ?? 1);

    string statusClass = Model.Status switch
    {
        "occupied"    => "status-occupied",
        "available"   => "status-available",
        "maintenance" => "status-maintenance",
        _             => "status-other"
    };
    string statusText = Model.Status switch
    {
        "occupied"    => "Đang thuê",
        "available"   => "Còn trống",
        "maintenance" => "Bảo trì",
        _             => Model.Status
    };

    string FormatMethod(string m, decimal unit, decimal @base, int? occ) => m switch
    {
        "meter"      => unit.ToString("N0") + " VNĐ/đv",
        "per_person" => @base.ToString("N0") + " VNĐ × " + (occ ?? 1) + " người",
        _            => @base.ToString("N0") + " VNĐ/phòng"
    };
}

@* ─── Styles ─── *@
@section Styles {
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@400,0&display=swap" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <style>
        :root {
            --primary: #D35400;
            --primary-hover: #A04000;
            --bg: #F8F5F2;
        }

        body { background: var(--bg); font-family: 'Inter','Segoe UI',sans-serif; }

        /* ── page wrapper ── */
        .room-page { max-width: 1200px; margin: 0 auto; padding: 28px 20px 64px; }

        /* ── breadcrumb ── */
        .breadcrumb-bar { display:flex; align-items:center; gap:6px; font-size:.83rem; color:#888; margin-bottom:20px; flex-wrap:wrap; }
        .breadcrumb-bar a { color:#888; text-decoration:none; } .breadcrumb-bar a:hover { color:var(--primary); }
        .breadcrumb-bar .cur { color:var(--primary); font-weight:500; }

        /* ── page header ── */
        .page-header { display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:14px; margin-bottom:28px; }
        .page-title { font-size:1.9rem; font-weight:700; color:#111; display:flex; align-items:center; gap:10px; flex-wrap:wrap; }

        /* ── status badges ── */
        .status-badge { display:inline-flex; align-items:center; gap:6px; padding:4px 12px; border-radius:20px; font-size:.8rem; font-weight:600; }
        .status-occupied    { background:#d1fae5; color:#065f46; border:1px solid #a7f3d0; }
        .status-available   { background:#dbeafe; color:#1e40af; border:1px solid #93c5fd; }
        .status-maintenance { background:#fef3c7; color:#92400e; border:1px solid #fde68a; }
        .status-other       { background:#f3f4f6; color:#374151; border:1px solid #e5e7eb; }

        /* ── action buttons ── */
        .btn-actions { display:flex; gap:10px; flex-wrap:wrap; }
        .btn-primary-custom  { background:var(--primary); color:#fff; border:none; border-radius:9px; padding:9px 20px; font-size:.88rem; font-weight:600; cursor:pointer; display:inline-flex; align-items:center; gap:7px; text-decoration:none; transition:background .2s; box-shadow:0 1px 3px rgba(0,0,0,.12); }
        .btn-primary-custom:hover { background:var(--primary-hover); color:#fff; }
        .btn-secondary-custom { background:#fff; color:#374151; border:1.5px solid #d1d5db; border-radius:9px; padding:9px 20px; font-size:.88rem; font-weight:600; cursor:pointer; display:inline-flex; align-items:center; gap:7px; text-decoration:none; transition:background .2s; box-shadow:0 1px 3px rgba(0,0,0,.06); }
        .btn-secondary-custom:hover { background:#f9fafb; color:#111; }
        .btn-danger-custom { background:#fff; color:#dc2626; border:1.5px solid #fca5a5; border-radius:9px; padding:9px 20px; font-size:.88rem; font-weight:600; cursor:pointer; display:inline-flex; align-items:center; gap:7px; text-decoration:none; transition:background .2s; }
        .btn-danger-custom:hover { background:#fff5f5; }

        /* ── grid layout ── */
        .detail-grid { display:grid; grid-template-columns:1fr 1fr; gap:20px; }
        @@media (max-width: 860px) { .detail-grid { grid-template-columns:1fr; } }

        /* ── cards ── */
        .dcard { background:#fff; border-radius:16px; padding:24px; box-shadow:0 1px 4px rgba(0,0,0,.07); border:1px solid #f0ebe5; }
        .dcard-header { display:flex; align-items:center; gap:10px; padding-bottom:16px; border-bottom:1px solid #f4f4f4; margin-bottom:18px; }
        .dcard-icon { width:38px; height:38px; border-radius:10px; display:flex; align-items:center; justify-content:center; font-size:1.1rem; flex-shrink:0; }
        .dcard-title { font-size:1rem; font-weight:600; color:#111; }

        /* ── info grid ── */
        .info-grid { display:grid; grid-template-columns:1fr 1fr; gap:16px; }
        .info-item .label { font-size:.78rem; color:#888; font-weight:500; margin-bottom:4px; }
        .info-item .val { font-size:1rem; font-weight:600; color:#111; }
        .info-item .val-price { font-size:1.5rem; font-weight:700; color:var(--primary); }
        .info-item .val-sub { font-size:.8rem; color:#888; }

        /* ── fee chips ── */
        .fee-chips { display:grid; grid-template-columns:1fr 1fr; gap:10px; margin-top:16px; }
        .fee-chip { background:#f9f9f9; border:1px solid #eee; border-radius:10px; padding:10px 12px; display:flex; justify-content:space-between; align-items:center; font-size:.84rem; }
        .fee-chip .fee-icon { display:flex; align-items:center; gap:6px; color:#555; }
        .fee-chip .fee-val { font-weight:600; color:#111; }
        .fee-chip.overridden { border-color:#f59e0b; background:#fffbeb; }
        .fee-chip .override-badge { font-size:.68rem; background:#f59e0b; color:#fff; border-radius:4px; padding:1px 5px; margin-left:4px; }

        /* ── tenant cards ── */
        .tenant-card { display:flex; align-items:flex-start; gap:14px; padding:14px; border:1px solid #f0f0f0; border-radius:12px; margin-bottom:10px; position:relative; background:#fff; transition:box-shadow .15s; }
        .tenant-card:hover { box-shadow:0 2px 10px rgba(0,0,0,.07); }
        .tenant-avatar { width:46px; height:46px; border-radius:50%; background:#f3f4f6; display:flex; align-items:center; justify-content:center; font-size:1.3rem; color:#9ca3af; flex-shrink:0; }
        .tenant-name { font-size:.97rem; font-weight:700; color:#111; margin-bottom:3px; }
        .tenant-role-primary { display:inline-block; background:#dbeafe; color:#1e40af; font-size:.7rem; font-weight:700; text-transform:uppercase; letter-spacing:.04em; padding:1px 7px; border-radius:4px; margin-bottom:4px; }
        .tenant-role-member { display:inline-block; background:#f3f4f6; color:#374151; font-size:.7rem; font-weight:700; text-transform:uppercase; letter-spacing:.04em; padding:1px 7px; border-radius:4px; margin-bottom:4px; }
        .tenant-phone { font-size:.84rem; color:#555; display:flex; align-items:center; gap:5px; }

        /* ── estimated total card ── */
        .est-card { background:linear-gradient(135deg,#fff8f4 0%,#fff 100%); border:1px solid rgba(211,84,0,.2); border-radius:16px; padding:24px; }
        .est-header { display:flex; justify-content:space-between; align-items:center; margin-bottom:16px; }
        .est-title { font-size:1rem; font-weight:700; color:#111; display:flex; align-items:center; gap:8px; }
        .est-badge { background:#fef3c7; color:#92400e; font-size:.75rem; font-weight:600; padding:3px 10px; border-radius:6px; }
        .est-row { display:flex; justify-content:space-between; font-size:.88rem; padding:6px 0; color:#555; }
        .est-row .r-val { font-weight:500; color:#111; }
        .est-total { display:flex; justify-content:space-between; padding-top:12px; margin-top:6px; border-top:1.5px solid #f0ebe5; font-size:1.1rem; font-weight:800; color:var(--primary); }

        /* ── meter chips ── */
        .meter-grid { display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-bottom:16px; }
        .meter-chip { background:#fff; border:1px solid #e5e7eb; border-radius:12px; padding:14px; box-shadow:0 1px 2px rgba(0,0,0,.04); }
        .meter-chip .mc-label { font-size:.76rem; color:#888; display:flex; align-items:center; gap:5px; margin-bottom:6px; }
        .meter-chip .mc-val { font-size:1rem; font-weight:600; color:#111; }

        /* ── furniture grid ── */
        .furniture-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(160px,1fr)); gap:12px; }
        .furniture-card { background:#f9fafb; border:1px solid #eee; border-radius:10px; padding:14px; }
        .furniture-card .fc-name { font-weight:600; font-size:.9rem; }
        .furniture-card .fc-qty { font-size:.8rem; color:#888; margin-top:2px; }

        /* ── empty state ── */
        .empty-state { text-align:center; padding:36px; color:#bbb; }
        .empty-state i { font-size:2.2rem; display:block; margin-bottom:8px; }

        /* ── misc ── */
        .section-full { margin-top:20px; }
        .mb-3 { margin-bottom: 1rem; }

        /* ── furniture clickable ── */
        .furniture-clickable { cursor:pointer; transition:box-shadow .15s,border-color .15s; }
        .furniture-clickable:hover { box-shadow:0 2px 10px rgba(0,0,0,.1); border-color:#d1d5db; }
    </style>
}

<div class="room-page">

    <!-- Breadcrumb -->
    <div class="breadcrumb-bar">
        <a asp-controller="Property" asp-action="Index">Nhà trọ của tôi</a>
        <i class="bi bi-chevron-right"></i>
        <a asp-controller="Property" asp-action="Details" asp-route-id="@Model.PropertyId">@Model.PropertyName</a>
        <i class="bi bi-chevron-right"></i>
        <span class="cur">Phòng @Model.RoomName</span>
    </div>

    <!-- Page header -->
    <div class="page-header">
        <div class="page-title">
            Phòng @Model.RoomName
            <span class="status-badge @statusClass">
                <span style="width:7px;height:7px;border-radius:50%;background:currentColor;opacity:.7;"></span>
                @statusText
            </span>
        </div>
        <div class="btn-actions">
            <a asp-action="Edit" asp-route-id="@Model.RoomId" class="btn-secondary-custom">
                <i class="bi bi-pencil-square"></i> Chỉnh sửa
            </a>
            @if (!Model.HasTenant)
            {
                <a asp-action="Rent" asp-route-id="@Model.RoomId" class="btn-primary-custom">
                    <i class="bi bi-person-plus"></i> Cho thuê
                </a>
            }
            <form asp-action="Delete" method="post" class="d-inline"
                  onsubmit="return confirm('Bạn có chắc muốn xóa phòng này?');">
                <input type="hidden" name="id" value="@Model.RoomId" />
                <input type="hidden" name="propertyId" value="@Model.PropertyId" />
                <button type="submit" class="btn-danger-custom">
                    <i class="bi bi-trash"></i> Xóa phòng
                </button>
            </form>
        </div>
    </div>

    <!-- Main 2-col grid -->
    <div class="detail-grid">

        <!-- LEFT col -->
        <div style="display:flex;flex-direction:column;gap:20px;">

            <!-- Room info card -->
            <div class="dcard">
                <div class="dcard-header">
                    <div class="dcard-icon" style="background:#fff4ed;color:var(--primary);">
                        <i class="bi bi-info-circle-fill"></i>
                    </div>
                    <span class="dcard-title">Thông tin phòng</span>
                </div>

                <div class="info-grid">
                    <div class="info-item">
                        <div class="label">Giá thuê</div>
                        <div class="val-price">@Model.RentPrice.ToString("N0")</div>
                        <div class="val-sub">đ/tháng</div>
                    </div>
                    <div class="info-item">
                        <div class="label">Số người tối đa</div>
                        <div class="val">@Model.MaxOccupants người</div>
                    </div>
                    @if (Model.DepositAmount.HasValue)
                    {
                        <div class="info-item">
                            <div class="label">Tiền cọc đang giữ</div>
                            <div class="val">@Model.DepositAmount.Value.ToString("N0") đ</div>
                        </div>
                    }
                    @if (Model.ContractStartDate.HasValue)
                    {
                        <div class="info-item">
                            <div class="label">Hợp đồng đến</div>
                            <div class="val">@Model.ContractEndDate?.ToString("dd/MM/yyyy")</div>
                        </div>
                    }
                </div>

                <!-- Effective fee chips -->
                @if (effectiveFees.Any())
                {
                    <div style="margin-top:20px;padding-top:16px;border-top:1px solid #f4f4f4;">
                        <div style="font-size:.82rem;font-weight:600;color:#888;margin-bottom:10px;">Phụ phí áp dụng</div>
                        <div class="fee-chips">
                            @foreach (var fee in effectiveFees)
                            {
                                bool isOverridden = roomFeeTypeIds.Contains(fee.FeeTypeId);
                                string icon = fee.FeeType?.Name?.ToLower() switch
                                {
                                    "electricity" => "bi-lightning-charge-fill",
                                    "water"       => "bi-droplet-fill",
                                    "internet"    => "bi-wifi",
                                    _             => "bi-tag-fill"
                                };
                                string iconColor = fee.FeeType?.Name?.ToLower() switch
                                {
                                    "electricity" => "#f59e0b",
                                    "water"       => "#3b82f6",
                                    "internet"    => "#8b5cf6",
                                    _             => "#6b7280"
                                };
                                string displayVal = FormatMethod(fee.CalculationMethod, fee.UnitPrice, fee.BaseAmount, Model.MaxOccupants);

                                <div class="fee-chip @(isOverridden ? "overridden" : "")">
                                    <span class="fee-icon">
                                        <i class="bi @icon" style="color:@iconColor;"></i>
                                        @fee.FeeType?.Name
                                        @if (isOverridden)
                                        {
                                            <span class="override-badge">Riêng</span>
                                        }
                                    </span>
                                    <span class="fee-val">@displayVal</span>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>

            <!-- Tenants card -->
            <div class="dcard">
                <div class="dcard-header">
                    <div class="dcard-icon" style="background:#f3e8ff;color:#9333ea;">
                        <i class="bi bi-people-fill"></i>
                    </div>
                    <span class="dcard-title">Khách thuê hiện tại
                        @if (Model.HasTenant) { <span style="color:#888;font-weight:400;font-size:.88rem;">(@Model.Tenants.Count người)</span> }
                    </span>
                </div>

                @if (Model.HasTenant && Model.Tenants.Any())
                {
                    @foreach (var t in Model.Tenants)
                    {
                        <div class="tenant-card">
                            <div class="tenant-avatar"><i class="bi bi-person-fill"></i></div>
                            <div style="flex:1;min-width:0;">
                                <div class="tenant-name">@t.FullName</div>
                                @if (t.IsPrimary)
                                {
                                    <span class="tenant-role-primary">&#10003; Đại diện HĐ</span>
                                }
                                else
                                {
                                    <span class="tenant-role-member">Thành viên</span>
                                }
                                @if (!string.IsNullOrEmpty(t.Phone))
                                {
                                    <div class="tenant-phone"><i class="bi bi-telephone"></i> @t.Phone</div>
                                }
                                @if (!string.IsNullOrEmpty(t.Email))
                                {
                                    <div class="tenant-phone" style="margin-top:2px;"><i class="bi bi-envelope"></i> @t.Email</div>
                                }
                            </div>
                            @if (t.ContractId.HasValue)
                            {
                                <a asp-controller="Contract" asp-action="Details" asp-route-id="@t.ContractId.Value"
                                   style="flex-shrink:0;display:inline-flex;align-items:center;gap:5px;padding:5px 12px;border-radius:8px;background:#fef3c7;color:#92400e;font-size:.8rem;font-weight:600;text-decoration:none;border:1px solid #fde68a;white-space:nowrap;"
                                   title="Xem hợp đồng">
                                    <i class="bi bi-file-text"></i> Hợp đồng
                                </a>
                            }
                        </div>
                    }
                }
                else
                {
                    <div class="empty-state">
                        <i class="bi bi-person-slash"></i>
                        <p style="font-size:.9rem;">Phòng chưa có người thuê</p>
                        <a asp-action="Rent" asp-route-id="@Model.RoomId" class="btn-primary-custom" style="margin:0 auto;display:inline-flex;">
                            <i class="bi bi-person-plus"></i> Cho thuê ngay
                        </a>
                    </div>
                }
            </div>
        </div>

        <!-- RIGHT col -->
        <div style="display:flex;flex-direction:column;gap:20px;">

            <!-- Estimated total card (only if tenant + readings) -->
            @if (Model.HasTenant && Model.CurrentPeriodMonth.HasValue)
            {
                // Compute total across ALL fees dynamically
                decimal grandTotal = Model.RentPrice;
                @foreach (var fee in effectiveFees)
                {
                    decimal feeAmount = 0;
                    if (fee.CalculationMethod == "meter")
                    {
                        int usage = fee.FeeType?.Name == "Electricity" ? Model.ElectricUsage
                                  : fee.FeeType?.Name == "Water"       ? Model.WaterUsage
                                  : 0;
                        feeAmount = usage * fee.UnitPrice;
                    }
                    else if (fee.CalculationMethod == "per_person")
                    {
                        feeAmount = fee.BaseAmount * occupantCount;
                    }
                    else // per_room or fixed
                    {
                        feeAmount = fee.BaseAmount;
                    }
                    grandTotal += feeAmount;
                }

                <div class="est-card">
                    <div class="est-header">
                        <div class="est-title">
                            <i class="bi bi-receipt-cutoff" style="color:var(--primary);"></i>
                            Tạm tính tháng @(Model.CurrentPeriodMonth % 100)
                        </div>
                        <span class="est-badge">Chưa chốt</span>
                    </div>

                    <!-- Meter chips for meter-type fees -->
                    @{
                        bool hasElectric = effectiveFees.Any(f => f.FeeType?.Name == "Electricity" && f.CalculationMethod == "meter");
                        bool hasWater    = effectiveFees.Any(f => f.FeeType?.Name == "Water"       && f.CalculationMethod == "meter");
                    }
                    @if (hasElectric || hasWater)
                    {
                        <div class="meter-grid">
                            @if (hasElectric)
                            {
                                <div class="meter-chip">
                                    <div class="mc-label"><i class="bi bi-lightning-charge-fill" style="color:#f59e0b;"></i> Điện (cũ: @Model.CurrentElectricOld)</div>
                                    <div class="mc-val">Dùng <strong>@Model.ElectricUsage</strong> kWh</div>
                                </div>
                            }
                            @if (hasWater)
                            {
                                <div class="meter-chip">
                                    <div class="mc-label"><i class="bi bi-droplet-fill" style="color:#3b82f6;"></i> Nước (cũ: @Model.CurrentWaterOld)</div>
                                    <div class="mc-val">Dùng <strong>@Model.WaterUsage</strong> m³</div>
                                </div>
                            }
                        </div>
                    }

                    <!-- Breakdown: all fees -->
                    <div style="background:rgba(255,255,255,.7);border-radius:10px;padding:14px;border:1px solid #f0ebe5;">
                        <div class="est-row">
                            <span>Tiền phòng</span>
                            <span class="r-val">@Model.RentPrice.ToString("N0") đ</span>
                        </div>

                        @foreach (var fee in effectiveFees)
                        {
                            decimal amt = 0;
                            string desc = fee.FeeType?.Name ?? "Phí khác";

                            if (fee.CalculationMethod == "meter")
                            {
                                int usage = fee.FeeType?.Name == "Electricity" ? Model.ElectricUsage
                                          : fee.FeeType?.Name == "Water"       ? Model.WaterUsage
                                          : 0;
                                amt = usage * fee.UnitPrice;
                                desc = $"{desc} ({usage} đv × {fee.UnitPrice.ToString("N0")})";
                            }
                            else if (fee.CalculationMethod == "per_person")
                            {
                                amt = fee.BaseAmount * occupantCount;
                                desc = $"{desc} ({fee.BaseAmount.ToString("N0")} × {occupantCount} người)";
                            }
                            else
                            {
                                amt = fee.BaseAmount;
                            }

                            <div class="est-row">
                                <span>@desc</span>
                                <span class="r-val">@amt.ToString("N0") đ</span>
                            </div>
                        }

                        <div class="est-total">
                            <span>Tổng tạm tính</span>
                            <span>@grandTotal.ToString("N0") đ</span>
                        </div>
                    </div>

                    @if (Model.ContractId.HasValue)
                    {
                        <a asp-controller="Invoice" asp-action="Create"
                           asp-route-roomId="@Model.RoomId"
                           asp-route-periodMonth="@Model.CurrentPeriodMonth"
                           class="btn-primary-custom" style="width:100%;justify-content:center;margin-top:14px;">
                            <i class="bi bi-calculator"></i> Tính &amp; Tạo hoá đơn
                        </a>
                    }
                </div>
            }

            <!-- Furniture card -->
            <div class="dcard">
                <div class="dcard-header" style="justify-content:space-between;">
                    <div style="display:flex;align-items:center;gap:10px;">
                        <div class="dcard-icon" style="background:#f3f4f6;color:#374151;">
                            <i class="bi bi-box-seam-fill"></i>
                        </div>
                        <span class="dcard-title">Cơ sở vật chất</span>
                    </div>
                    <a asp-action="AddFurniture" asp-route-roomId="@Model.RoomId"
                       class="btn-secondary-custom" style="padding:6px 14px;font-size:.82rem;">
                        <i class="bi bi-plus"></i> Thêm
                    </a>
                </div>

                @if (Model.Furnitures != null && Model.Furnitures.Any())
                {
                    <div class="furniture-grid">
                        @foreach (var f in Model.Furnitures)
                        {
                            bool hasImages = f.ImageUrls != null && f.ImageUrls.Any();
                            string imagesJson = hasImages
                                ? "[" + string.Join(",", f.ImageUrls!.Select(u => "'" + u.Replace("'", "\\'") + "'")) + "]"
                                : "[]";
                            <div class="furniture-card furniture-clickable"
                                 onclick="openFurnitureModal('@f.Name', @f.Quantity, '@(f.Description ?? string.Empty)', @imagesJson)"
                                 title="Xem chi tiết">
                                <div class="fc-name"><i class="bi bi-box"></i> @f.Name</div>
                                <div class="fc-qty">Số lượng: @f.Quantity</div>
                                @if (!string.IsNullOrEmpty(f.Description))
                                {
                                    <div style="font-size:.8rem;color:#888;margin-top:4px;">@f.Description</div>
                                }
                                @if (hasImages)
                                {
                                    <div style="margin-top:8px;display:flex;gap:4px;flex-wrap:wrap;">
                                        @foreach (var img in f.ImageUrls!.Take(3))
                                        {
                                            <img src="@img"
                                                 class="furniture-preview"
                                                 data-images="@System.Text.Json.JsonSerializer.Serialize(f.ImageUrls)"
                                                 style="width:44px;height:44px;object-fit:cover;border-radius:6px;border:1px solid #eee;cursor:pointer;" />
                                        }
                                        @if (f.ImageUrls!.Count() > 3)
                                        {
                                            <div style="width:44px;height:44px;border-radius:6px;background:#f3f4f6;display:flex;align-items:center;justify-content:center;font-size:.75rem;color:#888;">+@(f.ImageUrls.Count()-3)</div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div style="margin-top:6px;font-size:.75rem;color:#bbb;"><i class="bi bi-image"></i> Chưa có ảnh</div>
                                }
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="empty-state" style="padding:24px;">
                        <i class="bi bi-inbox" style="font-size:1.6rem;"></i>
                        <p style="font-size:.87rem;">Chưa có nội thất nào.</p>
                    </div>
                }
            </div>

            <!-- Previous month readings -->
            @if (Model.PreviousPeriodMonth.HasValue)
            {
                <div class="dcard">
                    <div class="dcard-header">
                        <div class="dcard-icon" style="background:#eff6ff;color:#3b82f6;"><i class="bi bi-clock-history"></i></div>
                        <span class="dcard-title">Chỉ số tháng trước (@Model.PreviousPeriodMonth)</span>
                    </div>
                    <div class="meter-grid">
                        <div class="meter-chip">
                            <div class="mc-label"><i class="bi bi-lightning-charge-fill" style="color:#f59e0b;"></i> Điện</div>
                            <div class="mc-val">@Model.PreviousElectricOld → @Model.PreviousElectricNew</div>
                            <div style="font-size:.78rem;color:#888;">(@(((Model.PreviousElectricNew??0)-(Model.PreviousElectricOld??0))) kWh)</div>
                        </div>
                        <div class="meter-chip">
                            <div class="mc-label"><i class="bi bi-droplet-fill" style="color:#3b82f6;"></i> Nước</div>
                            <div class="mc-val">@Model.PreviousWaterOld → @Model.PreviousWaterNew</div>
                            <div style="font-size:.78rem;color:#888;">(@(((Model.PreviousWaterNew??0)-(Model.PreviousWaterOld??0))) m³)</div>
                        </div>
                    </div>
                </div>
            }

        </div>
    </div>
</div>

<!-- ── Furniture detail modal (inline preview, from Details.cshtml) ── -->
<div id="furnitureModal" style="display:none;position:fixed;inset:0;z-index:2000;background:rgba(0,0,0,.55);align-items:center;justify-content:center;">
    <div style="background:#fff;border-radius:16px;max-width:580px;width:92%;padding:0;box-shadow:0 8px 32px rgba(0,0,0,.2);overflow:hidden;">
        <div style="display:flex;justify-content:space-between;align-items:center;padding:18px 22px;border-bottom:1px solid #f0f0f0;">
            <div>
                <div id="fmName" style="font-size:1.05rem;font-weight:700;color:#111;"></div>
                <div id="fmMeta" style="font-size:.82rem;color:#888;margin-top:2px;"></div>
            </div>
            <button onclick="closeFurnitureModal()" style="background:none;border:none;font-size:1.6rem;color:#aaa;cursor:pointer;line-height:1;padding:4px 8px;border-radius:6px;" title="Đóng">&times;</button>
        </div>
        <div id="fmBody" style="padding:20px;max-height:70vh;overflow-y:auto;"></div>
    </div>
</div>

<!-- ── Bootstrap image gallery modal (from DetailsMyfriend.cshtml) ── -->
<div class="modal fade" id="imageGalleryModal">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-body text-center">
                <img id="galleryImage" class="img-fluid rounded shadow" />
            </div>
            <div class="modal-footer justify-content-between">
                <button class="btn btn-secondary" id="prevImage">
                    <i class="bi bi-arrow-left"></i>
                </button>
                <button class="btn btn-secondary" id="nextImage">
                    <i class="bi bi-arrow-right"></i>
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // ── Furniture detail modal ──
        function openFurnitureModal(name, qty, desc, images) {
            document.getElementById('fmName').textContent = name;
            var meta = 'Số lượng: ' + qty;
            if (desc) meta += ' • ' + desc;
            document.getElementById('fmMeta').textContent = meta;

            var body = document.getElementById('fmBody');
            if (!images || images.length === 0) {
                body.innerHTML = '<div style="text-align:center;padding:32px;color:#bbb;">' +
                    '<i class="bi bi-image" style="font-size:2.5rem;display:block;margin-bottom:8px;"></i>' +
                    '<p style="font-size:.9rem;margin:0;">Chưa có ảnh</p></div>';
            } else {
                var preview = '<img id="fmPreview" src="' + images[0] + '" style="width:100%;border-radius:12px;object-fit:contain;max-height:280px;margin-bottom:12px;" />';
                var thumbs = '';
                if (images.length > 1) {
                    thumbs = '<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(80px,1fr));gap:8px;">' +
                        images.map((url, i) =>
                            '<img src="' + url + '" onclick="selectFmImg(\'' + url + '\')" ' +
                            'style="width:100%;aspect-ratio:1;object-fit:cover;border-radius:8px;cursor:pointer;border:2px solid ' + (i===0?'#D35400':'#eee') + ';" />'
                        ).join('') + '</div>';
                }
                body.innerHTML = preview + thumbs;
            }

            document.getElementById('furnitureModal').style.display = 'flex';
        }

        function selectFmImg(url) {
            var p = document.getElementById('fmPreview');
            if (p) p.src = url;
        }

        function closeFurnitureModal() {
            document.getElementById('furnitureModal').style.display = 'none';
        }

        document.getElementById('furnitureModal').addEventListener('click', function (e) {
            if (e.target === this) closeFurnitureModal();
        });

        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') closeFurnitureModal();
        });

        // ── Bootstrap image gallery modal (prev/next) ──
        let galleryImages = [];
        let currentIndex = 0;

        document.querySelectorAll(".furniture-preview").forEach(img => {
            img.addEventListener("click", function (e) {
                e.stopPropagation(); // don't also open furniture detail modal
                galleryImages = JSON.parse(this.dataset.images);
                currentIndex = 0;
                document.getElementById("galleryImage").src = galleryImages[currentIndex];
                new bootstrap.Modal(document.getElementById("imageGalleryModal")).show();
            });
        });

        document.getElementById("nextImage").onclick = function () {
            if (currentIndex < galleryImages.length - 1) currentIndex++;
            document.getElementById("galleryImage").src = galleryImages[currentIndex];
        };

        document.getElementById("prevImage").onclick = function () {
            if (currentIndex > 0) currentIndex--;
            document.getElementById("galleryImage").src = galleryImages[currentIndex];
        };
    </script>
}
