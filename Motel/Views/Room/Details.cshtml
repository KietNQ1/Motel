@model Motel.ViewModels.Room.RoomDetailViewModel

@{
    ViewData["Title"] = $"Phòng {Model.RoomName}";
    var statusBadge = Model.Status switch
    {
        "occupied" => "bg-success",
        "available" => "bg-info",
        "maintenance" => "bg-warning",
        _ => "bg-secondary"
    };
    var statusText = Model.Status switch
    {
        "occupied" => "Đã thuê",
        "available" => "Còn trống",
        "maintenance" => "Bảo trì",
        _ => Model.Status
    };
}

<div class="container py-4">
    <div class="row mb-4">
        <div class="col-md-8">
            <h2 class="mb-0">
                <i class="bi bi-door-closed"></i> Phòng @Model.RoomName
                <span class="badge @statusBadge ms-2">@statusText</span>
            </h2>
            <p class="text-muted mb-0">
                <i class="bi bi-building"></i>
                <a asp-controller="Property" asp-action="Details" asp-route-id="@Model.PropertyId">@Model.PropertyName</a>
            </p>
        </div>
        <div class="col-md-4 text-end">
            <a asp-controller="Property" asp-action="Details" asp-route-id="@Model.PropertyId" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Quay lại
            </a>
            <a asp-action="Edit" asp-route-id="@Model.RoomId" class="btn btn-outline-primary">
                <i class="bi bi-pencil"></i> Chỉnh sửa
            </a>
            @if (Model.HasTenant && Model.ContractId.HasValue)
            {
                <a asp-controller="Invoice" asp-action="Create" asp-route-contractId="@Model.ContractId" class="btn btn-success ms-1">
                    <i class="bi bi-receipt"></i> Tạm tính
                </a>
            }
            <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa phòng này?');">
                <input type="hidden" name="id" value="@Model.RoomId" />
                <input type="hidden" name="propertyId" value="@Model.PropertyId" />
                <button type="submit" class="btn btn-outline-danger ms-1">
                    <i class="bi bi-trash"></i> Xóa
                </button>
            </form>
        </div>
    </div>

    <div class="row">
        <!-- Room Info -->
        <div class="col-md-6 mb-4">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="bi bi-info-circle"></i> Thông tin phòng</h5>
                </div>
                <div class="card-body">
                    <table class="table table-borderless">
                        <tr>
                            <th width="40%">Giá thuê:</th>
                            <td><strong class="text-primary">@Model.RentPrice.ToString("N0") VNĐ</strong>/tháng</td>
                        </tr>
                        <tr>
                            <th>Số người tối đa:</th>
                            <td>@Model.MaxOccupants người</td>
                        </tr>
                        <tr>
                            <th>Trạng thái:</th>
                            <td><span class="badge @statusBadge">@statusText</span></td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>

        <!-- Utility Settings -->
        <div class="col-md-6 mb-4">
            <div class="card shadow-sm">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0"><i class="bi bi-lightning"></i> Cấu hình tiện ích</h5>
                </div>
                <div class="card-body">
                    <table class="table table-borderless">
                        <tr>
                            <th width="50%">Giá điện:</th>
                            <td>@Model.ElectricUnitPrice.ToString("N0") VNĐ/số</td>
                        </tr>
                        <tr>
                            <th>Giá nước:</th>
                            <td>@Model.WaterUnitPrice.ToString("N0") VNĐ/số</td>
                        </tr>
                        <tr>
                            <th>Phí Internet:</th>
                            <td>@Model.InternetFee.ToString("N0") VNĐ/tháng</td>
                        </tr>
                        <tr>
                            <th>Phí rác:</th>
                            <td>@Model.TrashFee.ToString("N0") VNĐ/tháng</td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>
    </div>

    @if (Model.HasTenant)
    {
        <!-- Tenant Info -->
        <div class="row">
            <div class="col-md-12 mb-4">
                <div class="card shadow-sm">
                    <div class="card-header bg-success text-white">
                        <h5 class="mb-0"><i class="bi bi-people"></i> Thông tin người thuê (@Model.Tenants.Count người)</h5>
                    </div>
                    <div class="card-body">
                        <div class="row mb-4 border-bottom pb-3">
                            <div class="col-md-12">
                                <h6 class="text-success"><i class="bi bi-file-earmark-text"></i> Thông tin hợp đồng</h6>
                                <table class="table table-sm table-borderless mb-0 w-auto">
                                    <tr>
                                        <th class="pe-4">Ngày bắt đầu:</th>
                                        <td>@Model.ContractStartDate?.ToString("dd/MM/yyyy")</td>
                                    </tr>
                                    <tr>
                                        <th class="pe-4">Ngày kết thúc:</th>
                                        <td>@Model.ContractEndDate?.ToString("dd/MM/yyyy")</td>
                                    </tr>
                                    <tr>
                                        <th class="pe-4">Tiền cọc:</th>
                                        <td><strong>@Model.DepositAmount?.ToString("N0") VNĐ</strong></td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>Họ tên</th>
                                        <th>Số điện thoại</th>
                                        <th>Email</th>
                                        <th>Vai trò</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var tenant in Model.Tenants)
                                    {
                                        <tr>
                                            <td>
                                                <strong>@tenant.FullName</strong>
                                            </td>
                                            <td>@(string.IsNullOrEmpty(tenant.Phone) ? "Chưa có" : tenant.Phone)</td>
                                            <td>@(string.IsNullOrEmpty(tenant.Email) ? "Chưa có" : tenant.Email)</td>
                                            <td>
                                                @if (tenant.IsPrimary)
                                                {
                                                    <span class="badge bg-primary">Người đại diện</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">Thành viên</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Meter Readings -->
        <div class="row">
            <div class="col-md-12 mb-4">
                <div class="card shadow-sm">
                    <div class="card-header bg-warning text-dark">
                        <h5 class="mb-0"><i class="bi bi-speedometer2"></i> Chỉ số điện nước</h5>
                    </div>
                    <div class="card-body">
                        @if (Model.CurrentPeriodMonth.HasValue)
                        {
                            <h6 class="mb-3">Tháng hiện tại (@Model.CurrentPeriodMonth)</h6>
                            <div class="row mb-4">
                                <div class="col-md-6">
                                    <div class="border rounded p-3 bg-light">
                                        <h6><i class="bi bi-lightning-charge text-warning"></i> Điện</h6>
                                        <div class="d-flex justify-content-between">
                                            <span>Số cũ: <strong>@Model.CurrentElectricOld</strong></span>
                                            <span>Số mới: <strong>@Model.CurrentElectricNew</strong></span>
                                            <span class="text-primary">Tiêu thụ: <strong>@Model.ElectricUsage</strong> số</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="border rounded p-3 bg-light">
                                        <h6><i class="bi bi-droplet text-info"></i> Nước</h6>
                                        <div class="d-flex justify-content-between">
                                            <span>Số cũ: <strong>@Model.CurrentWaterOld</strong></span>
                                            <span>Số mới: <strong>@Model.CurrentWaterNew</strong></span>
                                            <span class="text-primary">Tiêu thụ: <strong>@Model.WaterUsage</strong> số</span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            @if (Model.PreviousPeriodMonth.HasValue)
                            {
                                <h6 class="mb-3">Tháng trước (@Model.PreviousPeriodMonth)</h6>
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="border rounded p-3">
                                            <h6><i class="bi bi-lightning-charge text-warning"></i> Điện</h6>
                                            <div class="d-flex justify-content-between">
                                                <span>Số cũ: @Model.PreviousElectricOld</span>
                                                <span>Số mới: @Model.PreviousElectricNew</span>
                                                <span class="text-muted">Tiêu thụ: @((Model.PreviousElectricNew ?? 0) - (Model.PreviousElectricOld ?? 0)) số</span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="border rounded p-3">
                                            <h6><i class="bi bi-droplet text-info"></i> Nước</h6>
                                            <div class="d-flex justify-content-between">
                                                <span>Số cũ: @Model.PreviousWaterOld</span>
                                                <span>Số mới: @Model.PreviousWaterNew</span>
                                                <span class="text-muted">Tiêu thụ: @((Model.PreviousWaterNew ?? 0) - (Model.PreviousWaterOld ?? 0)) số</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }

                            <!-- Estimated Total -->
                            <div class="alert alert-success mt-4">
                                <h5 class="mb-3 d-flex justify-content-between align-items-center">
                                    <span>
                                        <i class="bi bi-calculator"></i> Tạm tính tiền trọ tháng này
                                    </span>
                                    @if (Model.ContractId.HasValue && Model.CurrentPeriodMonth.HasValue)
                                    {
                                        <a asp-controller="Invoice"
                                           asp-action="Create"
                                           asp-route-contractId="@Model.ContractId"
                                           asp-route-periodMonth="@Model.CurrentPeriodMonth"
                                           class="btn btn-light btn-sm">
                                            <i class="bi bi-receipt"></i> Tạm tính / Lập hóa đơn
                                        </a>
                                    }
                                </h5>
                                <table class="table table-sm mb-0">
                                    <tr>
                                        <td>Tiền phòng:</td>
                                        <td class="text-end">@Model.RentPrice.ToString("N0") VNĐ</td>
                                    </tr>
                                    <tr>
                                        <td>Tiền điện (@Model.ElectricUsage × @Model.ElectricUnitPrice.ToString("N0")):</td>
                                        <td class="text-end">@((Model.ElectricUsage * Model.ElectricUnitPrice).ToString("N0")) VNĐ</td>
                                    </tr>
                                    <tr>
                                        <td>Tiền nước (@Model.WaterUsage × @Model.WaterUnitPrice.ToString("N0")):</td>
                                        <td class="text-end">@((Model.WaterUsage * Model.WaterUnitPrice).ToString("N0")) VNĐ</td>
                                    </tr>
                                    <tr>
                                        <td>Phí Internet:</td>
                                        <td class="text-end">@Model.InternetFee.ToString("N0") VNĐ</td>
                                    </tr>
                                    <tr>
                                        <td>Phí rác:</td>
                                        <td class="text-end">@Model.TrashFee.ToString("N0") VNĐ</td>
                                    </tr>
                                    <tr class="fw-bold border-top">
                                        <td>Tổng cộng:</td>
                                        <td class="text-end text-success fs-5">@Model.EstimatedTotal.ToString("N0") VNĐ</td>
                                    </tr>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-info">
                                <i class="bi bi-info-circle"></i> Chưa có chỉ số điện nước cho tháng này.
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- No Tenant -->
        <div class="row">
            <div class="col-md-12">
                <div class="alert alert-info text-center">
                    <h5><i class="bi bi-info-circle"></i> Phòng chưa có người thuê</h5>
                    <p class="mb-3">Phòng này hiện đang trống và sẵn sàng cho thuê.</p>
                    <a asp-action="Rent" asp-route-id="@Model.RoomId" class="btn btn-primary">
                        <i class="bi bi-person-plus"></i> Cho thuê phòng
                    </a>
                </div>
            </div>
        </div>
    }
</div>
<div class="row mt-4">
    <div class="col-md-12">
        <div class="card shadow-sm">
            <div class="card-header bg-secondary text-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0">
                    <i class="bi bi-house-gear"></i> Cơ sở vật chất trong phòng
                </h5>

                <a asp-action="AddFurniture"
                   asp-route-roomId="@Model.RoomId"
                   class="btn btn-light btn-sm">
                    <i class="bi bi-plus-circle"></i> Thêm nội thất
                </a>
            </div>

            <div class="card-body">

                @if (Model.Furnitures != null && Model.Furnitures.Any())
                {
                    <div class="row">
                        @foreach (var f in Model.Furnitures)
                        {
                            <div class="col-md-4 mb-4">
                                <div class="card h-100 border">

                                    <div class="card-body">
                                        <h5 class="card-title">
                                            <i class="bi bi-box"></i> @f.Name
                                        </h5>

                                        <p class="mb-1">
                                            <strong>Số lượng:</strong> @f.Quantity
                                        </p>

                                        @if (!string.IsNullOrEmpty(f.Description))
                                        {
                                            <p class="text-muted">@f.Description</p>
                                        }

                                        @if (f.ImageUrls != null && f.ImageUrls.Any())
                                        {
                                            <div class="mt-2">
                                                @foreach (var img in f.ImageUrls)
                                                {
                                                    <img src="@img"
                                                         class="img-thumbnail me-2 mb-2"
                                                         style="width:80px;height:80px;object-fit:cover;" />
                                                }
                                            </div>
                                        }
                                    </div>

                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="alert alert-light">
                        Chưa có nội thất nào trong phòng.
                    </div>
                }

            </div>
        </div>
    </div>
</div>
@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
}
