        .status-note {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 0.83rem;
            color: #6b7280;
            background: #f9fafb;
            border: 1px solid #e5e7eb;
            border-radius: 8px;
            padding: 8px 14px;
        }
        .d-inline-form { display: inline; }

    </style>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function toggleMethodInputs(method, prefix) {
            if (method === 'meter') {
                $('#' + prefix + 'UnitPriceDiv').removeClass('d-none');
                $('#' + prefix + 'BaseAmountDiv').addClass('d-none');
            } else {
                $('#' + prefix + 'UnitPriceDiv').addClass('d-none');
                $('#' + prefix + 'BaseAmountDiv').removeClass('d-none');
            }
        }

        $(document).ready(function () {
            // Initialize add method selects
            $('#addCalcMethodSelect').on('change', function () { toggleMethodInputs($(this).val(), 'add'); });
            toggleMethodInputs($('#addCalcMethodSelect').val(), 'add');

            // Custom modal toggle logic (replaces Bootstrap JS)
            $('[data-bs-toggle="modal"]').click(function(e) {
                e.preventDefault();
                var target = $(this).attr('data-bs-target');
                $(target).addClass('show');
            });
            $('.btn-close, [data-bs-dismiss="modal"]').click(function(e) {
                e.preventDefault();
                $(this).closest('.modal').removeClass('show');
            });
            $('.modal').click(function(e) {
                if ($(e.target).hasClass('modal')) {
                    $(this).removeClass('show');
                }
            });

            // Edit fee validation and population
            $('.icon-btn.edit').click(function () {
                var btn = this;
                $('#editFeeSettingId').val(btn.dataset.settingId);
                $('#editFeeTypeId').val(btn.dataset.typeId);
                $('#editCalcMethodSelect').val(btn.dataset.method);
                $('#editUnitPriceInput').val(parseFloat(btn.dataset.unitPrice) || 0);
                $('#editBaseAmountInput').val(parseFloat(btn.dataset.baseAmount) || 0);
                toggleMethodInputs(btn.dataset.method, 'edit');
            });
            $('#editCalcMethodSelect').on('change', function () { toggleMethodInputs($(this).val(), 'edit'); });

            // Auto-dismiss toast
            setTimeout(function() { var t = document.getElementById('toastMsg'); if(t) t.remove(); }, 4000);
        });
    </script>
}
