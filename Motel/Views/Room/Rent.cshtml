@model Motel.ViewModels.Room.RentRoomViewModel

@{
    ViewData["Title"] = $"Cho thuê phòng {Model.RoomName}";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow">
                <div class="card-header bg-success text-white">
                    <h4 class="mb-0">
                        <i class="bi bi-person-plus"></i> Cho thuê phòng @Model.RoomName
                    </h4>
                    <small>@Model.PropertyName - Giá thuê: @Model.RentPrice.ToString("N0") VNĐ/tháng</small>
                </div>

                <div class="card-body">
                    <form asp-action="Rent" method="post">
                        @Html.AntiForgeryToken()

                        <input type="hidden" asp-for="RoomId" />
                        <input type="hidden" asp-for="RoomName" />
                        <input type="hidden" asp-for="RentPrice" />
                        <input type="hidden" asp-for="PropertyName" />
                        <input type="hidden" asp-for="MaxOccupants" />

                        <div asp-validation-summary="All" class="text-danger mb-3"></div>

                        <!-- OCCUPANTS -->
                        <h5 class="border-bottom pb-2 mb-3">Thông tin người ở (có thể ở ghép)</h5>

                        <div id="occupantsContainer">
                            @for (int i = 0; i < Model.Occupants.Count; i++)
                            {
                                <div class="border rounded p-3 mb-3 occupant-item">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <strong>Người @(i + 1)</strong>

                                        <div class="d-flex align-items-center gap-3">
                                            <label class="mb-0">
                                                <input type="radio" name="PrimaryIndex" value="@i" @(Model.PrimaryIndex == i ? "checked" : "") />
                                                Tenant chính
                                            </label>

                                            <button type="button" class="btn btn-sm btn-outline-danger" onclick="removeOccupant(this)">
                                                Xóa
                                            </button>
                                        </div>
                                    </div>

                                    <div class="row">
                                        <div class="col-md-6 mb-2">
                                            <label class="form-label">Họ tên</label>
                                            <input class="form-control" name="Occupants[@i].FullName" value="@Model.Occupants[i].FullName" />
                                        </div>
                                        <div class="col-md-6 mb-2">
                                            <label class="form-label">SĐT</label>
                                            <input class="form-control" name="Occupants[@i].Phone" value="@Model.Occupants[i].Phone" />
                                        </div>
                                        <div class="col-md-6 mb-2">
                                            <label class="form-label">Email</label>
                                            <input class="form-control" name="Occupants[@i].Email" value="@Model.Occupants[i].Email" />
                                        </div>
                                        <div class="col-md-6 mb-2">
                                            <label class="form-label">CMND/CCCD</label>
                                            <input class="form-control" name="Occupants[@i].IdentityNo" value="@Model.Occupants[i].IdentityNo" />
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>

                        <button type="button" class="btn btn-outline-primary" onclick="addOccupant()">
                            + Thêm người ở
                        </button>

                        <small class="text-muted d-block mt-2">
                            Tối đa: @Model.MaxOccupants người
                        </small>

                        <!-- CONTRACT INFO -->
                        <h5 class="border-bottom pb-2 mb-3 mt-4">Thông tin hợp đồng</h5>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="StartDate" class="form-label"></label>
                                <input asp-for="StartDate" class="form-control" type="date" />
                                <span asp-validation-for="StartDate" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="EndDate" class="form-label"></label>
                                <input asp-for="EndDate" class="form-control" type="date" />
                                <span asp-validation-for="EndDate" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="DepositAmount" class="form-label"></label>
                            <div class="input-group">
                                <input asp-for="DepositAmount" class="form-control" type="number" step="100000" />
                                <span class="input-group-text">VNĐ</span>
                            </div>
                            <span asp-validation-for="DepositAmount" class="text-danger"></span>
                        </div>

                        <!-- INITIAL METER -->
                        <h5 class="border-bottom pb-2 mb-3 mt-4">Chỉ số điện nước ban đầu (tùy chọn)</h5>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="InitialElectricReading" class="form-label"></label>
                                <input asp-for="InitialElectricReading" class="form-control" type="number" min="0" />
                                <span asp-validation-for="InitialElectricReading" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="InitialWaterReading" class="form-label"></label>
                                <input asp-for="InitialWaterReading" class="form-control" type="number" min="0" />
                                <span asp-validation-for="InitialWaterReading" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- SUBMIT -->
                        <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-4">
                            <a asp-action="Details" asp-route-id="@Model.RoomId" class="btn btn-secondary">
                                Hủy
                            </a>
                            <button type="submit" class="btn btn-success">
                                Xác nhận cho thuê
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
                function addOccupant() {
                    const container = document.getElementById('occupantsContainer');
                    const index = container.querySelectorAll('.occupant-item').length;

                    const max = @Model.MaxOccupants;
                    if (max > 0 && index >= max) {
                        alert('Vượt quá số người tối đa của phòng.');
                        return;
                    }

                    const html = `
        <div class="border rounded p-3 mb-3 occupant-item">
          <div class="d-flex justify-content-between align-items-center mb-2">
            <strong>Người ${index + 1}</strong>
            <div class="d-flex align-items-center gap-3">
              <label class="mb-0">
                <input type="radio" name="PrimaryIndex" value="${index}" ${index === 0 ? 'checked' : ''} />
                Tenant chính
              </label>
              <button type="button" class="btn btn-sm btn-outline-danger" onclick="removeOccupant(this)">Xóa</button>
            </div>
          </div>
          <div class="row">
            <div class="col-md-6 mb-2">
              <label class="form-label">Họ tên</label>
              <input class="form-control" name="Occupants[${index}].FullName" />
            </div>
            <div class="col-md-6 mb-2">
              <label class="form-label">SĐT</label>
              <input class="form-control" name="Occupants[${index}].Phone" />
            </div>
            <div class="col-md-6 mb-2">
              <label class="form-label">Email</label>
              <input class="form-control" name="Occupants[${index}].Email" />
            </div>
            <div class="col-md-6 mb-2">
              <label class="form-label">CMND/CCCD</label>
              <input class="form-control" name="Occupants[${index}].IdentityNo" />
            </div>
          </div>
        </div>`;
                    container.insertAdjacentHTML('beforeend', html);
                }

                function removeOccupant(btn) {
                    const item = btn.closest('.occupant-item');
                    item.remove();
                    // tạm thời chưa re-index
                }
    </script>
}