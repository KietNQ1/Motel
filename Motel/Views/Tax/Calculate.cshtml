@model Motel.ViewModels.Tax.TaxEstimationCalculateViewModel

@{
    ViewData["Title"] = "Tính ước tính thuế";
    Layout = "_Layout";
}

<!-- HEADER -->
<div class="mb-6">
    <div class="flex items-center gap-3">
        <a id="lnk_back_taxIndex" asp-action="Index" 
           class="flex h-10 w-10 items-center justify-center rounded-lg border border-gray-200 bg-white transition-colors hover:bg-gray-50 dark:border-gray-700 dark:bg-gray-800 dark:hover:bg-gray-700">
            <svg class="h-5 w-5 text-gray-600 dark:text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
            </svg>
        </a>
        <div>
            <h1 class="text-3xl font-bold text-gray-900 dark:text-white">Tính ước tính thuế</h1>
            <p class="mt-1.5 text-sm text-gray-600 dark:text-gray-400">Chọn năm để tính toán ước tính thuế cho thuê</p>
        </div>
    </div>
</div>

<!-- MAIN CARD -->
<div class="mx-auto max-w-2xl">
    <div class="overflow-hidden rounded-xl border border-gray-200 bg-white shadow-lg dark:border-gray-800 dark:bg-gray-900">
        
        <!-- CARD HEADER -->
        <div class="border-b border-gray-200 bg-gradient-to-r from-primary/10 to-primary-dark/10 px-6 py-4 dark:border-gray-800">
            <h2 class="text-lg font-semibold text-gray-900 dark:text-white">Thông tin tính toán</h2>
        </div>

        <!-- CARD BODY -->
        <div class="p-6">
            
            <!-- INFO MESSAGE -->
            <div class="mb-6 rounded-lg border border-blue-200 bg-blue-50 p-4 dark:border-blue-900 dark:bg-blue-900/20">
                <div class="flex items-start gap-3">
                    <svg class="h-5 w-5 text-blue-600 dark:text-blue-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                    <div class="text-sm text-blue-800 dark:text-blue-300">
                        <p class="font-semibold mb-2">Cách tính ước tính thuế</p>
                        <ul class="list-disc list-inside space-y-1.5 text-blue-700 dark:text-blue-400">
                            <li>Hệ thống tính doanh thu từ <strong>tất cả hợp đồng</strong> của bạn trong năm đã chọn</li>
                            <li>Doanh thu chỉ bao gồm <strong>tiền phòng</strong>, không bao gồm điện nước thu hộ</li>
                            <li>Di revenue được <strong>phân bổ theo thời gian</strong> hợp đồng chồng lấn với năm dương lịch</li>
                            <li>Nếu tổng doanh thu ≤ 100 triệu: <strong>miễn thuế</strong></li>
                            <li>Nếu tổng doanh thu > 100 triệu: phải nộp thuế <strong>VAT 5% + TNCN 5%</strong></li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- FORM -->
            <form id="form_calculateTax" asp-action="Calculate" method="post">
                @Html.AntiForgeryToken()

                <!-- Year Selection -->
                <div class="mb-6">
                    <label id="lbl_year" asp-for="Year" class="mb-2 block text-sm font-semibold text-gray-700 dark:text-gray-300">
                        Chọn năm <span class="text-red-500">*</span>
                    </label>
                    <select id="select_year" asp-for="Year"
                            class="w-full rounded-lg border border-gray-300 bg-white px-4 py-3 text-gray-900 transition-colors focus:border-primary focus:ring-2 focus:ring-primary/20 dark:border-gray-700 dark:bg-gray-800 dark:text-white">
                        @foreach (var year in Model.AvailableYears)
                        {
                            <option value="@year">Năm @year</option>
                        }
                    </select>
                    <span asp-validation-for="Year" class="mt-1 text-xs text-red-500"></span>
                    <p class="mt-2 text-xs text-gray-500 dark:text-gray-400">
                        <svg class="inline h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                        Thuế tính theo năm dương lịch (1/1 - 31/12)
                    </p>
                </div>

                <!-- ERROR MESSAGES -->
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="mb-6 rounded-lg border border-red-200 bg-red-50 p-4 dark:border-red-900 dark:bg-red-900/20">
                        <div class="flex items-start gap-3">
                            <svg class="h-5 w-5 text-red-600 dark:text-red-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                            </svg>
                            <div class="text-sm">
                                <p class="font-semibold text-red-800 dark:text-red-300 mb-1">Có lỗi xảy ra</p>
                                <div asp-validation-summary="All" class="text-red-700 dark:text-red-400"></div>
                            </div>
                        </div>
                    </div>
                }

                <!-- ACTIONS -->
                <div class="flex items-center justify-end gap-3 pt-6 border-t border-gray-200 dark:border-gray-800">
                    <a id="lnk_cancel_taxIndex" asp-action="Index"
                       class="rounded-lg border border-gray-300 bg-white px-5 py-2.5 text-sm font-medium text-gray-700 transition-colors hover:bg-gray-50 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-300 dark:hover:bg-gray-700">
                        Hủy
                    </a>
                    <button id="btn_submit_calculate" type="submit"
                            class="inline-flex items-center gap-2 rounded-lg bg-gradient-to-r from-primary to-primary-dark px-6 py-2.5 text-sm font-semibold text-white shadow-lg shadow-primary/30 transition-all hover:shadow-xl hover:shadow-primary/40 hover:-translate-y-0.5">
                        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"/>
                        </svg>
                        Tính toán
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- ADDITIONAL INFO -->
    <div class="mt-6 rounded-lg border border-amber-200 bg-amber-50 p-4 dark:border-amber-900 dark:bg-amber-900/20">
        <div class="flex items-start gap-3">
            <svg class="h-5 w-5 text-amber-600 dark:text-amber-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
            </svg>
            <div class="text-sm text-amber-800 dark:text-amber-300">
                <p class="font-semibold mb-1">Lưu ý quan trọng</p>
                <p class="text-amber-700 dark:text-amber-400">
                    Kết quả tính toán chỉ mang tính chất <strong>ước tính</strong>. 
                    Việc kê khai và nộp thuế chính thức phải thực hiện qua hệ thống của 
                    <strong>Tổng cục Thuế Việt Nam</strong> theo quy định tại Thông tư 40/2021/TT-BTC.
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
