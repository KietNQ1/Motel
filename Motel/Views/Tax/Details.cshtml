@model Motel.ViewModels.Tax.TaxEstimationDetailViewModel

@{
    ViewData["Title"] = $"Chi tiết ước tính thuế {Model.Year}";
    Layout = "_Layout";
}

<!-- HEADER -->
<div class="mb-6">
    <div class="flex items-center gap-3">
        <a asp-action="Index" 
           class="flex h-10 w-10 items-center justify-center rounded-lg border border-gray-200 bg-white transition-colors hover:bg-gray-50 dark:border-gray-700 dark:bg-gray-800 dark:hover:bg-gray-700">
            <svg class="h-5 w-5 text-gray-600 dark:text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
            </svg>
        </a>
        <div>
            <h1 class="text-3xl font-bold text-gray-900 dark:text-white">Chi tiết ước tính thuế năm @Model.Year</h1>
            <p class="mt-1.5 text-sm text-gray-600 dark:text-gray-400">
                Tính toán lúc: @Model.CalculatedAt.ToString("dd/MM/yyyy HH:mm")
            </p>
        </div>
    </div>
</div>

<!-- MAIN CONTENT -->
<div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
    
    <!-- LEFT COLUMN: Summary Cards -->
    <div class="space-y-6 lg:col-span-2">
        
        <!-- STATUS BANNER -->
        @if (Model.IsExempt)
        {
            <div class="rounded-xl border border-green-200 bg-gradient-to-r from-green-50 to-emerald-50 p-6 dark:border-green-900 dark:from-green-900/20 dark:to-emerald-900/20">
                <div class="flex items-start gap-4">
                    <div class="flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-full bg-green-500 shadow-lg shadow-green-500/30">
                        <svg class="h-6 w-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                    </div>
                    <div>
                        <h3 class="text-lg font-bold text-green-900 dark:text-green-300">Được miễn thuế</h3>
                        <p class="mt-1 text-sm text-green-700 dark:text-green-400">
                            Tổng doanh thu năm @Model.Year không vượt ngưỡng @Model.RevenueThreshold.ToString("N0") VND nên được miễn thuế.
                        </p>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="rounded-xl border border-orange-200 bg-gradient-to-r from-orange-50 to-amber-50 p-6 dark:border-orange-900 dark:from-orange-900/20 dark:to-amber-900/20">
                <div class="flex items-start gap-4">
                    <div class="flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-full bg-orange-500 shadow-lg shadow-orange-500/30">
                        <svg class="h-6 w-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                    </div>
                    <div>
                        <h3 class="text-lg font-bold text-orange-900 dark:text-orange-300">Phải nộp thuế</h3>
                        <p class="mt-1 text-sm text-orange-700 dark:text-orange-400">
                            Tổng doanh thu năm @Model.Year vượt ngưỡng @Model.RevenueThreshold.ToString("N0") VND nên phải nộp thuế.
                        </p>
                    </div>
                </div>
            </div>
        }

        <!-- REVENUE CARD -->
        <div class="overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm dark:border-gray-800 dark:bg-gray-900">
            <div class="border-b border-gray-200 bg-gradient-to-r from-violet-50 to-purple-50 px-6 py-4 dark:border-gray-800 dark:from-violet-900/20 dark:to-purple-900/20">
                <h3 class="text-lg font-semibold text-gray-900 dark:text-white">Doanh thu</h3>
            </div>
            <div class="p-6 space-y-4">
                <div class="flex items-center justify-between">
                    <span class="text-sm font-medium text-gray-600 dark:text-gray-400">Tổng doanh thu năm @Model.Year</span>
                    <span class="text-2xl font-bold text-violet-600 dark:text-violet-400">@Model.TotalRevenue.ToString("N0") ₫</span>
                </div>
                <div class="flex items-center justify-between pt-4 border-t border-gray-200 dark:border-gray-800">
                    <span class="text-sm font-medium text-gray-600 dark:text-gray-400">Ngưỡng miễn thuế</span>
                    <span class="text-lg font-semibold text-gray-900 dark:text-white">@Model.RevenueThreshold.ToString("N0") ₫</span>
                </div>
                <div class="flex items-center justify-between">
                    <span class="text-sm font-medium text-gray-600 dark:text-gray-400">Doanh thu chịu thuế</span>
                    <span class="text-lg font-semibold @(Model.IsExempt ? "text-gray-900 dark:text-white" : "text-primary dark:text-primary-dark")">
                        @Model.TaxableRevenue.ToString("N0") ₫
                    </span>
                </div>
            </div>
        </div>

        <!-- TAX BREAKDOWN CARD -->
        <div class="overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm dark:border-gray-800 dark:bg-gray-900">
            <div class="border-b border-gray-200 bg-gradient-to-r from-orange-50 to-amber-50 px-6 py-4 dark:border-gray-800 dark:from-orange-900/20 dark:to-amber-900/20">
                <h3 class="text-lg font-semibold text-gray-900 dark:text-white">Chi tiết thuế</h3>
            </div>
            <div class="p-6 space-y-5">
                
                <!-- VAT -->
                <div class="flex items-start justify-between">
                    <div>
                        <div class="flex items-center gap-2">
                            <span class="text-base font-semibold text-gray-900 dark:text-white">Thuế VAT</span>
                            <span class="inline-flex items-center rounded-full bg-blue-100 px-2.5 py-0.5 text-xs font-semibold text-blue-700 dark:bg-blue-900/30 dark:text-blue-400">
                                @((Model.VatRate * 100).ToString("0.##"))%
                            </span>
                        </div>
                        <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">
                            Thuế giá trị gia tăng
                        </p>
                    </div>
                    <div class="text-right">
                        <p class="text-xl font-bold text-gray-900 dark:text-white">@Model.VatAmount.ToString("N0") ₫</p>
                        @if (!Model.IsExempt)
                        {
                            <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">
                                = @Model.TaxableRevenue.ToString("N0") × @((Model.VatRate * 100).ToString("0.##"))%
                            </p>
                        }
                    </div>
                </div>

                <div class="border-t border-gray-200 dark:border-gray-800"></div>

                <!-- PIT -->
                <div class="flex items-start justify-between">
                    <div>
                        <div class="flex items-center gap-2">
                            <span class="text-base font-semibold text-gray-900 dark:text-white">Thuế TNCN</span>
                            <span class="inline-flex items-center rounded-full bg-purple-100 px-2.5 py-0.5 text-xs font-semibold text-purple-700 dark:bg-purple-900/30 dark:text-purple-400">
                                @((Model.PitRate * 100).ToString("0.##"))%
                            </span>
                        </div>
                        <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">
                            Thuế thu nhập cá nhân
                        </p>
                    </div>
                    <div class="text-right">
                        <p class="text-xl font-bold text-gray-900 dark:text-white">@Model.PitAmount.ToString("N0") ₫</p>
                        @if (!Model.IsExempt)
                        {
                            <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">
                                = @Model.TaxableRevenue.ToString("N0") × @((Model.PitRate * 100).ToString("0.##"))%
                            </p>
                        }
                    </div>
                </div>

                <div class="border-t-2 border-gray-300 dark:border-gray-700"></div>

                <!-- TOTAL -->
                <div class="flex items-center justify-between rounded-lg bg-primary/10 p-4 dark:bg-primary/20">
                    <span class="text-lg font-bold text-gray-900 dark:text-white">Tổng thuế phải nộp</span>
                    <span class="text-3xl font-bold text-primary dark:text-primary-dark">
                        @Model.TotalTaxAmount.ToString("N0") ₫
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- RIGHT COLUMN: Info & Actions -->
    <div class="space-y-6">
        
        <!-- TAX RULE INFO -->
        <div class="overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm dark:border-gray-800 dark:bg-gray-900">
            <div class="border-b border-gray-200 bg-gray-50 px-6 py-4 dark:border-gray-800 dark:bg-gray-800/50">
                <h3 class="text-base font-semibold text-gray-900 dark:text-white">Luật thuế áp dụng</h3>
            </div>
            <div class="p-6">
                <div class="flex items-start gap-3">
                    <svg class="h-5 w-5 text-gray-400 dark:text-gray-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                    </svg>
                    <div>
                        <p class="font-semibold text-gray-900 dark:text-white">@Model.TaxRuleName</p>
                        <p class="mt-1 text-xs text-gray-600 dark:text-gray-400">
                            Áp dụng cho năm @Model.Year
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <!-- NOTES -->
        @if (!string.IsNullOrWhiteSpace(Model.Notes))
        {
            <div class="overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm dark:border-gray-800 dark:bg-gray-900">
                <div class="border-b border-gray-200 bg-gray-50 px-6 py-4 dark:border-gray-800 dark:bg-gray-800/50">
                    <h3 class="text-base font-semibold text-gray-900 dark:text-white">Ghi chú</h3>
                </div>
                <div class="p-6">
                    <p class="text-sm text-gray-700 dark:text-gray-300">@Model.Notes</p>
                </div>
            </div>
        }

        <!-- DISCLAIMER -->
        <div class="rounded-xl border border-amber-200 bg-amber-50 p-4 dark:border-amber-900 dark:bg-amber-900/20">
            <div class="flex items-start gap-3">
                <svg class="h-5 w-5 text-amber-600 dark:text-amber-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                </svg>
                <div class="text-xs text-amber-800 dark:text-amber-300">
                    <p class="font-semibold mb-1">Tuyên bố miễn trừ trách nhiệm</p>
                    <p class="text-amber-700 dark:text-amber-400">
                        Đây chỉ là ước tính mang tính tham khảo. Việc kê khai và nộp thuế chính thức 
                        phải thực hiện qua hệ thống của <strong>Tổng cục Thuế Việt Nam</strong>.
                    </p>
                </div>
            </div>
        </div>

        <!-- ACTIONS -->
        <div class="space-y-3">
            <a asp-action="Calculate"
               class="flex w-full items-center justify-center gap-2 rounded-lg border border-gray-300 bg-white px-4 py-3 text-sm font-medium text-gray-700 transition-colors hover:bg-gray-50 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-300 dark:hover:bg-gray-700">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
                </svg>
                Tính toán lại
            </a>
            <a asp-action="Index"
               class="flex w-full items-center justify-center gap-2 rounded-lg bg-primary px-4 py-3 text-sm font-semibold text-white transition-all hover:bg-primary-dark">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                </svg>
                Xem lịch sử
            </a>
        </div>
    </div>
</div>
