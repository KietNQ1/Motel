@model Motel.Models.Tenant
@{
    ViewData["Title"] = "Chi tiết người thuê";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3>Chi tiết người thuê</h3>
        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.TenantId" class="btn btn-outline-primary">
                <i class="bi bi-pencil-square"></i> Chỉnh sửa
            </a>
            <a asp-controller="Property" asp-action="Index" class="btn btn-secondary">Quay lại</a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <p><strong>Họ tên:</strong> @Model.FullName</p>
                    <p><strong>Điện thoại:</strong> @(Model.Phone ?? "Chưa có")</p>
                    <p><strong>Email:</strong> @(Model.Email ?? "Chưa có")</p>
                </div>
                <div class="col-md-6">
                    <p><strong>CCCD/CMND:</strong> @(Model.IdentityNo ?? "Chưa có")</p>
                    <p><strong>Ngày sinh:</strong> @(Model.DateOfBirth.HasValue ? Model.DateOfBirth.Value.ToString("dd/MM/yyyy") : "Chưa có")</p>
                    <p><strong>Nơi ĐKTT:</strong> @(Model.PermanentAddress ?? "Chưa có")</p>

                    @if (!string.IsNullOrEmpty(ViewBag.FrontImage) || !string.IsNullOrEmpty(ViewBag.BackImage))
                    {
                        <div class="mt-4 border-top pt-3">
                            <h6 class="text-primary mb-3"><i class="bi bi-person-vcard"></i> Ảnh CCCD/CMND</h6>
                            <div class="row g-2">
                                @if (!string.IsNullOrEmpty(ViewBag.FrontImage))
                                {
                                    <div class="col-6">
                                        <p class="small text-muted mb-1 text-center">Mặt trước</p>
                                        <img src="@ViewBag.FrontImage" alt="Mặt trước CCCD" class="img-fluid rounded border zoomable" style="cursor: pointer; max-height: 200px; object-fit: contain; width: 100%;" onclick="window.open(this.src, '_blank')" />
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(ViewBag.BackImage))
                                {
                                    <div class="col-6">
                                        <p class="small text-muted mb-1 text-center">Mặt sau</p>
                                        <img src="@ViewBag.BackImage" alt="Mặt sau CCCD" class="img-fluid rounded border zoomable" style="cursor: pointer; max-height: 200px; object-fit: contain; width: 100%;" onclick="window.open(this.src, '_blank')" />
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    <div class="mt-4 border-top pt-3">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h6 class="text-primary mb-0"><i class="bi bi-house-check"></i> Xác minh tạm trú</h6>
                            <a asp-action="PrintCT01" asp-route-id="@Model.TenantId" class="btn btn-sm btn-outline-info">
                                <i class="bi bi-printer"></i> Tạo mẫu CT01
                            </a>
                        </div>
                        
                        @if (!string.IsNullOrEmpty(ViewBag.ResidenceProofImage))
                        {
                            <div class="text-success mb-2 fw-bold"><i class="bi bi-check-circle-fill"></i> Đã có minh chứng tạm trú</div>
                            <img src="@ViewBag.ResidenceProofImage" alt="Minh chứng tạm trú" class="img-fluid rounded border zoomable" style="cursor: pointer; max-height: 300px; object-fit: contain; width: 100%;" onclick="window.open(this.src, '_blank')" />
                            
                            <!-- Form update existing proof -->
                            <form asp-action="UploadResidenceProof" method="post" enctype="multipart/form-data" class="mt-3">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="tenantId" value="@Model.TenantId" />
                                <div class="input-group input-group-sm">
                                    <input type="file" class="form-control" name="proofImage" accept="image/*" required>
                                    <button class="btn btn-primary" type="submit">Cập nhật ảnh</button>
                                </div>
                            </form>
                        }
                        else
                        {
                            <div class="text-danger mb-2 fw-bold"><i class="bi bi-x-circle-fill"></i> Chưa có minh chứng tạm trú</div>
                            <form asp-action="UploadResidenceProof" method="post" enctype="multipart/form-data" class="bg-light p-3 rounded border">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="tenantId" value="@Model.TenantId" />
                                <label class="small text-muted mb-2">Tải lên ảnh xác nhận đăng ký tạm trú:</label>
                                <div class="input-group input-group-sm">
                                    <input type="file" class="form-control" name="proofImage" accept="image/*" required>
                                    <button class="btn btn-primary" type="submit">Lưu minh chứng</button>
                                </div>
                            </form>
                        }
                    </div>
                </div>
            </div>
            <hr />
            <p class="text-muted mb-0"><small>Ngày tạo: @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</small></p>
        </div>
    </div>
</div>