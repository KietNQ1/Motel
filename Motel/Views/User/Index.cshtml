@model Motel.ViewModels.User.UserListViewModel

@{
    ViewData["Title"] = "User Management";
}

<h2 class="page-title">User Management</h2>

<form method="get" class="search-form">
    <input type="text"
           name="search"
           value="@Model.Search"
           placeholder="Search by name, email, phone..."
           class="search-input" />
    <button type="submit" class="btn btn-primary">Search</button>
</form>

<div class="table-wrapper">
    <table class="user-table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Phone</th>
                <th>Email</th>
                <th>Created Date</th>
                <th>Status</th>
                <th class="text-center">Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var u in Model.Users)
            {
                var isLocked = u.LockoutEnd.HasValue && u.LockoutEnd > DateTimeOffset.Now;

                <tr>
                    <td>@u.FullName</td>
                    <td>@u.PhoneNumber</td>
                    <td>@u.Email</td>
                    <td>@u.CreatedAt.ToString("dd/MM/yyyy")</td>
                    <td>
                        <span class="status @(isLocked ? "locked" : "active")">
                            @(isLocked ? "Locked" : "Active")
                        </span>
                    </td>
                    <td class="text-center">
                        <a asp-action="Edit"
                           asp-route-id="@u.Id"
                           class="btn btn-sm btn-secondary">
                            Edit
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="pagination">
    @for (int i = 1; i <= Model.TotalPages; i++)
    {
        if (i == Model.CurrentPage)
        {
            <span class="page-item active">@i</span>
        }
        else
        {
            <a asp-action="Index"
               asp-route-page="@i"
               asp-route-search="@Model.Search"
               class="page-item">@i</a>
        }
    }
</div>

@section Styles {
    <style>
        body {
            background-color: #f5f6fa;
        }

        .page-title {
            font-size: 26px;
            font-weight: 600;
            margin-bottom: 20px;
        }

        .search-form {
            display: flex;
            gap: 10px;
            margin-bottom: 20px;
        }

        .search-input {
            flex: 1;
            padding: 10px 14px;
            border: 1px solid #dcdcdc;
            border-radius: 8px;
            font-size: 14px;
            outline: none;
            transition: 0.2s;
        }

            .search-input:focus {
                border-color: #2563eb;
                box-shadow: 0 0 0 2px rgba(37, 99, 235, 0.1);
            }

        .btn {
            padding: 9px 16px;
            border-radius: 8px;
            text-decoration: none;
            font-size: 14px;
            cursor: pointer;
            border: none;
            transition: 0.2s;
            display: inline-block;
        }

        .btn-primary {
            background-color: #2563eb;
            color: #fff;
        }

            .btn-primary:hover {
                background-color: #1d4ed8;
            }

        .btn-secondary {
            background-color: #f3f4f6;
            color: #111827;
        }

            .btn-secondary:hover {
                background-color: #e5e7eb;
            }

        .btn-sm {
            padding: 6px 12px;
            font-size: 13px;
        }

        .table-wrapper {
            background: #ffffff;
            border-radius: 12px;
            box-shadow: 0 6px 18px rgba(0,0,0,0.06);
            overflow: hidden;
        }

        .user-table {
            width: 100%;
            border-collapse: collapse;
        }

            .user-table thead {
                background-color: #f9fafb;
            }

            .user-table th,
            .user-table td {
                padding: 14px 16px;
                font-size: 14px;
                text-align: left;
            }

            .user-table th {
                font-weight: 600;
                color: #374151;
                border-bottom: 1px solid #ececec;
            }

            .user-table tbody tr {
                border-bottom: 1px solid #f1f1f1;
                transition: 0.15s;
            }

                .user-table tbody tr:hover {
                    background-color: #f9fafb;
                }

        .status {
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 500;
        }

            .status.active {
                background-color: #dcfce7;
                color: #166534;
            }

            .status.locked {
                background-color: #fee2e2;
                color: #991b1b;
            }

        .pagination {
            margin-top: 20px;
            display: flex;
            gap: 8px;
        }

        .page-item {
            padding: 7px 12px;
            border-radius: 8px;
            background-color: #f3f4f6;
            text-decoration: none;
            color: #111827;
            font-size: 14px;
            transition: 0.2s;
        }

            .page-item:hover {
                background-color: #e5e7eb;
            }

            .page-item.active {
                background-color: #2563eb;
                color: #fff;
                font-weight: 500;
            }

        .text-center {
            text-align: center;
        }
    </style>
}